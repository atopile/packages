import ElectricPower
import I2C

from "atopile/st-vl53l4cx/st-vl53l4cx.ato" import ST_VL53L4CX

module Usage:
    """Minimal usage example for the ST_VL53L4CX sensor."""

    # Time-of-Flight sensor
    tof_sensor = new ST_VL53L4CX

    # Power supply (3.3V typical)
    power = new ElectricPower
    assert power.voltage within 3.3V +/- 5%
    power ~ tof_sensor.power

    # I²C bus (would connect to your MCU)
    i2c = new I2C
    i2c ~ tof_sensor.i2c
