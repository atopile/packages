#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import Capacitor
import ElectricPower
import ElectricLogic
import I2C
import Resistor
import SPI
import Addressor

from "parts/STMicroelectronics_LSM6DSOXTR/STMicroelectronics_LSM6DSOXTR.ato" import STMicroelectronics_LSM6DSOXTR_package
from "parts/STMicroelectronics_LIS3MDLTR/STMicroelectronics_LIS3MDLTR.ato" import STMicroelectronics_LIS3MDLTR_package

module ST_LSM6DSOX_LIS3MDL:
    """STMicroelectronics LSM6DSOX + LIS3MDL 9-DoF IMU combo sensor.

    This module combines a 6-axis IMU (LSM6DSOX) with a 3-axis magnetometer (LIS3MDL)
    on a single breakout board (Adafruit 4517).

    Features:
      * LSM6DSOX: 3-axis accelerometer + 3-axis gyroscope (I2C: 0x6A/0x6B)
      * LIS3MDL: 3-axis magnetometer (I2C: 0x1C/0x1E)
      * Dual I²C interfaces with configurable addresses
      * Machine learning core support (LSM6DSOX)
      * Built-in voltage regulation (3V-5V input)
      * STEMMA QT / Qwiic connectors
      * Interrupt pins available from both sensors
      * Power supply: 2.16V-3.6V (compatible with both sensors)
    """

    # --- External interfaces ---
    power = new ElectricPower
    """
    Main power supply (3V-5V) with onboard voltage regulation
    Compatible with both LSM6DSOX and LIS3MDL operating ranges
    """
    power.required = True
    assert power.voltage within 3.0V to 5.5V

    i2c = new I2C
    """
    I²C bus interface shared by both sensors:
    - LSM6DSOX: 0x6A or 0x6B (configurable via SA0)
    - LIS3MDL: 0x1C or 0x1E (configurable via SA1)
    """
    i2c.required = True

    # LSM6DSOX interrupt pins
    imu_int1 = new ElectricLogic
    """
    Interrupt 1 pin from LSM6DSOX (programmable)
    """
    imu_int1.reference ~ power

    imu_int2 = new ElectricLogic
    """
    Interrupt 2 pin from LSM6DSOX (programmable)
    """
    imu_int2.reference ~ power

    # LIS3MDL interrupt pins
    mag_int = new ElectricLogic
    """
    Interrupt pin from LIS3MDL magnetometer
    """
    mag_int.reference ~ power

    mag_drdy = new ElectricLogic
    """
    Data ready pin from LIS3MDL magnetometer
    """
    mag_drdy.reference ~ power

    # --- Internal power rails ---
    power_3v3 = new ElectricPower
    """
    Internal 3.3V power rail (regulated from input)
    Meets both LSM6DSOX and LIS3MDL requirements
    """
    assert power_3v3.voltage within 2.16V to 3.6V

    # Connect main power to internal rail
    power ~ power_3v3

    # --- LSM6DSOX (6-axis IMU) ---
    lsm6dsox = new STMicroelectronics_LSM6DSOXTR_package

    # --- LSM6DSOX I²C address configuration ---
    lsm6dsox_addressor = new Addressor<address_bits=1>
    lsm6dsox_addressor.base = 0x6A
    lsm6dsox_addressor.address_lines[0].line ~ lsm6dsox.SDO_SA0
    lsm6dsox_addressor.address_lines[0].reference ~ power_3v3
    # LSM6DSOX will be accessible at 0x6A (SA0=LOW) or 0x6B (SA0=HIGH)

    # --- LIS3MDL (3-axis magnetometer) ---
    lis3mdl = new STMicroelectronics_LIS3MDLTR_package

    # --- LIS3MDL I²C address configuration ---
    lis3mdl_addressor = new Addressor<address_bits=1>
    lis3mdl_addressor.base = 0x1C
    lis3mdl_addressor.address_lines[0].line ~ lis3mdl.SD0_SA1
    lis3mdl_addressor.address_lines[0].reference ~ power_3v3
    # LIS3MDL will be accessible at 0x1C (SA1=LOW) or 0x1E (SA1=HIGH)

    # Note: For a combo sensor, both sensors share the same I2C bus
    # The addresses are configured via the SA0 and SA1 pins respectively
    # Each sensor will have its own unique address on the shared bus

    # --- I²C pull-up resistors ---
    i2c_pullups = new Resistor[2]
    for r in i2c_pullups:
        r.resistance = 10kohm +/- 5%
        r.package = "0402"

    power_3v3.hv ~> i2c_pullups[0] ~> i2c.scl.line
    power_3v3.hv ~> i2c_pullups[1] ~> i2c.sda.line

    # --- LSM6DSOX CS pull-up (I2C mode selection) ---
    lsm6dsox_cs_pullup = new Resistor
    lsm6dsox_cs_pullup.resistance = 10kohm +/- 5%
    lsm6dsox_cs_pullup.package = "0402"
    power_3v3.hv ~> lsm6dsox_cs_pullup ~> lsm6dsox.CS

    # --- LIS3MDL CS pull-up (I2C mode selection) ---
    lis3mdl_cs_pullup = new Resistor
    lis3mdl_cs_pullup.resistance = 10kohm +/- 5%
    lis3mdl_cs_pullup.package = "0402"
    power_3v3.hv ~> lis3mdl_cs_pullup ~> lis3mdl.CS

    # --- Decoupling capacitors ---
    # LSM6DSOX VDD decoupling (100nF + 10µF)
    lsm6dsox_vdd_cap_100nf = new Capacitor
    lsm6dsox_vdd_cap_100nf.capacitance = 100nF +/- 20%
    lsm6dsox_vdd_cap_100nf.package = "0402"
    power_3v3.hv ~> lsm6dsox_vdd_cap_100nf ~> power_3v3.lv

    lsm6dsox_vdd_cap_10uf = new Capacitor
    lsm6dsox_vdd_cap_10uf.capacitance = 10uF +/- 20%
    lsm6dsox_vdd_cap_10uf.package = "0603"
    power_3v3.hv ~> lsm6dsox_vdd_cap_10uf ~> power_3v3.lv

    # LSM6DSOX VDDIO decoupling (100nF)
    lsm6dsox_vddio_cap_100nf = new Capacitor
    lsm6dsox_vddio_cap_100nf.capacitance = 100nF +/- 20%
    lsm6dsox_vddio_cap_100nf.package = "0402"
    power_3v3.hv ~> lsm6dsox_vddio_cap_100nf ~> power_3v3.lv

    # LIS3MDL VDD decoupling (100nF)
    lis3mdl_vdd_cap_100nf = new Capacitor
    lis3mdl_vdd_cap_100nf.capacitance = 100nF +/- 20%
    lis3mdl_vdd_cap_100nf.package = "0402"
    power_3v3.hv ~> lis3mdl_vdd_cap_100nf ~> power_3v3.lv

    # LIS3MDL VDDIO decoupling (100nF)
    lis3mdl_vddio_cap_100nf = new Capacitor
    lis3mdl_vddio_cap_100nf.capacitance = 100nF +/- 20%
    lis3mdl_vddio_cap_100nf.package = "0402"
    power_3v3.hv ~> lis3mdl_vddio_cap_100nf ~> power_3v3.lv

    # LIS3MDL C1 decoupling (100nF) - connected to C1 pin
    lis3mdl_c1_cap_100nf = new Capacitor
    lis3mdl_c1_cap_100nf.capacitance = 100nF +/- 20%
    lis3mdl_c1_cap_100nf.package = "0402"
    lis3mdl.C1 ~> lis3mdl_c1_cap_100nf ~> power_3v3.lv

    # --- LSM6DSOX power connections ---
    lsm6dsox.VDD ~ power_3v3.hv
    lsm6dsox.VDDIO ~ power_3v3.hv
    lsm6dsox.GND ~ power_3v3.lv

    # --- LSM6DSOX I²C connections ---
    lsm6dsox.SCL ~ i2c.scl.line
    lsm6dsox.SDA ~ i2c.sda.line

    # --- LSM6DSOX interrupt connections ---
    lsm6dsox.INT1 ~ imu_int1.line
    lsm6dsox.INT2 ~ imu_int2.line

    # --- LIS3MDL power connections ---
    lis3mdl.Vdd ~ power_3v3.hv
    lis3mdl.Vdd_IO ~ power_3v3.hv
    lis3mdl.GND ~ power_3v3.lv

    # --- LIS3MDL I²C connections ---
    lis3mdl.SCL_SPC ~ i2c.scl.line
    lis3mdl.SDA_SDI_SDO ~ i2c.sda.line

    # --- LIS3MDL interrupt connections ---
    lis3mdl.INT ~ mag_int.line
    lis3mdl.DRDY ~ mag_drdy.line

    # --- LIS3MDL reserved pin connections ---
    # Connect reserved pins to ground as recommended
    lis3mdl.Res ~ power_3v3.lv

    # --- Reference connections ---
    i2c.scl.reference ~ power_3v3
    i2c.sda.reference ~ power_3v3

    # --- Auxiliary sensor interface (LSM6DSOX to LIS3MDL) ---
    # Connect LSM6DSOX auxiliary sensor interface to LIS3MDL
    # This allows LSM6DSOX to read LIS3MDL data through its auxiliary interface
    lsm6dsox.SCX ~ lis3mdl.SCL_SPC
    lsm6dsox.SDX ~ lis3mdl.SDA_SDI_SDO

    # OSC_AUX and SDO_AUX can be left unconnected for basic operation
    # These are used for advanced auxiliary sensor features
