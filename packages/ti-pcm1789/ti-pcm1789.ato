#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import ElectricPower
import I2C
import ElectricLogic
import Addressor
import Resistor
import Capacitor
import I2S
import DifferentialPair

from "parts/Texas_Instruments_PCM1789PWR/Texas_Instruments_PCM1789PWR.ato" import Texas_Instruments_PCM1789PWR_package

module Texas_Instruments_PCM1789_driver:
    """Texas Instruments PCM1789 2-CH I2S Audio DAC"""
    package = new Texas_Instruments_PCM1789PWR_package

    # Interfaces
    power_5v = new ElectricPower
    power_5v.required = True
    power_3v3 = new ElectricPower
    power_3v3.required = True
    i2s = new I2S
    i2s.required = True
    i2c = new I2C
    i2c.required = True

    # Outputs
    balanced_outputs = new DifferentialPair[2]
    balanced_outputs[0].p.line ~ package.VOUTLpos
    balanced_outputs[0].n.line ~ package.VOUTLneg
    balanced_outputs[1].p.line ~ package.VOUTRpos
    balanced_outputs[1].n.line ~ package.VOUTRneg
    
    # Power
    power_5v.vcc ~ package.VCC2
    power_5v.vcc ~ package.VCC1
    power_5v.gnd ~ package.AGND2
    power_5v.gnd ~ package.AGND1

    power_3v3.vcc ~ package.VDD
    power_3v3.gnd ~ package.DGND

    cap_5v = new Capacitor[2]
    for cap in cap_5v:
        cap.package = "C0402"
        cap.capacitance = 1uF +/- 20%
        power_5v.vcc ~> cap ~> power_5v.gnd
    
    cap_3v3 = new Capacitor
    cap_3v3.package = "C0402"
    cap_3v3.capacitance = 100nF +/- 20%
    power_3v3.vcc ~> cap_3v3 ~> power_3v3.gnd    


    vcom_cap = new Capacitor
    vcom_cap.package = "C0402"
    vcom_cap.capacitance = 10uF +/- 20%
    package.VCOM ~> vcom_cap ~> power_3v3.gnd

    # Communications Interfacese
    i2c.scl.line ~ package.MD_SDA_DEMP
    i2c.scl.line ~ package.MC_SCL_FMT

    i2s.sd.line ~ package.DIN
    i2s.ws.line ~ package.LRCK
    i2s.sck.line ~ package.BCK

    master_clock = new ElectricLogic
    master_clock.line ~ package.SCKI
    master_clock.reference ~ power_3v3

    # Addressor
    addressor = new Addressor<address_bits=2>
    addressor.base = 0x4C
    addressor.address_lines[0].line ~ package.MS_ADR0_RSV
    addressor.address_lines[1].line ~ package.ADR5_ADR1_RSV
    for address_line in addressor.address_lines:
        address_line.reference ~ power_3v3

    

