#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

# --- Imports ---
import ElectricPower
import I2C

from "atopile/ti-ads7830/ti-ads7830.ato" import TI_ADS7830

module Usage:
    """
    Minimal usage example for ti-ads7830.
    Demonstrates connecting power and I2C to the ADS7830 ADC.
    """

    # --- Power supply ---
    power = new ElectricPower
    power.voltage = 3.3V +/- 5%

    # --- I2C bus ---
    i2c_bus = new I2C
    i2c_bus.frequency = 400kHz

    # --- ADC instance ---
    adc = new TI_ADS7830
    assert adc.i2c.address within 0x48

    # --- Connections ---
    power ~ adc.power
    i2c_bus ~ adc.i2c

    # --- Set I2C address (optional - default is 0x48) ---
    # i2c_bus.address = 0x48
