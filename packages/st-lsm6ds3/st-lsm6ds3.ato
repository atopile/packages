#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import ElectricPower
import I2C
import ElectricLogic
import Resistor
import Capacitor

from "parts/STMicroelectronics_LSM6DS3TR_C/STMicroelectronics_LSM6DS3TR_C.ato" import STMicroelectronics_LSM6DS3TR_C_package

module ST_LSM6DS3:
    """
    ST LSM6DS3 6-axis accelerometer & gyroscope (IMU).
    """

    package = new STMicroelectronics_LSM6DS3TR_C_package

    # --- External interfaces ---
    i2c = new I2C
    i2c.required = True

    power = new ElectricPower
    power.required = True

    interrupt = new ElectricLogic[2]

    # --- Internal power rails ---
    power_digital = new ElectricPower
    power_analog = new ElectricPower
    power_digital ~ power
    power_analog ~ power

    # --- Power supply ---
    assert power.voltage within 1.71V to 3.6V

    # --- I²C bus ---
    i2c.scl.reference ~ power_digital
    i2c.sda.reference ~ power_digital
    i2c_address_pulldown_resistor = new Resistor
    i2c_address_pulldown_resistor.resistance = 10kohm +/- 5%
    i2c_address_pulldown_resistor.package = "0402"
    power_digital.lv ~> i2c_address_pulldown_resistor ~> package.SDO_SA0
    i2c.address = 0x18

    # --- I²C pull-up resistors ---
    pullup_resistors = new Resistor[2]
    for resistor in pullup_resistors:
        resistor.resistance = 4.7kohm +/- 5%
        resistor.package = "0402"
    i2c.scl.line ~> pullup_resistors[0] ~> i2c.scl.reference.hv
    i2c.sda.line ~> pullup_resistors[1] ~> i2c.sda.reference.hv

    # --- Decoupling capacitors ---
    decoupling_capacitors = new Capacitor[2]
    for capacitor in decoupling_capacitors:
        capacitor.capacitance = 100nF +/- 20%
        capacitor.package = "0402"
    power_analog.hv ~> decoupling_capacitors[0] ~> power_analog.lv
    power_digital.hv ~> decoupling_capacitors[1] ~> power_digital.lv

    # --- Chip-select pin pull-up (forces I²C mode) ---
    chip_select_pullup = new Resistor
    chip_select_pullup.resistance = 10kohm +/- 20%
    chip_select_pullup.package = "0402"
    power_digital.hv ~> chip_select_pullup ~> package.CS

    # --- Package connections ---
    package.GND ~ power_analog.gnd
    package.VDD ~ power_analog.hv
    package.VDDIO ~ power_digital.hv
    package.INT1 ~ interrupt[0].line
    package.INT2 ~ interrupt[1].line
    package.SCL ~ i2c.scl.line
    package.SDA ~ i2c.sda.line
