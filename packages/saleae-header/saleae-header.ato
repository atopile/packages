#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import ElectricSignal
import Resistor

from "parts/HCTL_PZ254_2_04_S/HCTL_PZ254_2_04_S.ato" import HCTL_PZ254_2_04_S_package


module SaleaeHeader:
    header = new HCTL_PZ254_2_04_S_package
    channels = new ElectricSignal[4]
    protection_resistors = new Resistor[4]

    # Configure resistors
    for resistor in protection_resistors:
        resistor.resistance = 1kohm +/- 5%
        resistor.package = "R0402"

    # Connect the grounds together
    signal gnd
    for channel in channels:
        gnd ~ channel.reference.gnd

    # connect ios via resistors to the header
    channels[0].line ~> protection_resistors[0] ~> header.1
    channels[1].line ~> protection_resistors[1] ~> header.3
    channels[2].line ~> protection_resistors[2] ~> header.5
    channels[3].line ~> protection_resistors[3] ~> header.7

    # connect the grounds together
    gnd ~ header.2
    gnd ~ header.4
    gnd ~ header.6
    gnd ~ header.8
