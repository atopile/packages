#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("TRAITS")

import ElectricPower
import ElectricLogic
import I2C
import Capacitor
import Resistor
import has_single_electric_reference

from "parts/Microchip_Tech_MCP4728_E_UN/Microchip_Tech_MCP4728_E_UN.ato" import Microchip_Tech_MCP4728_E_UN_package

module Microchip_MCP4728:
    """
    Microchip MCP4728 Quad 12-bit DAC with EEPROM

    The MCP4728 is a quad channel, 12-bit voltage output Digital-to-Analog Converter (DAC)
    with non-volatile memory (EEPROM) and an I2C interface. The device includes an on-chip
    voltage reference and supports individual channel configuration.
    """

    # --- External interfaces ---
    power = new ElectricPower
    """
    Power supply for the device (2.7V to 5.5V)
    """
    power.required = True

    assert power.voltage within 2.7V to 5.5V
    i2c = new I2C
    """
    I²C bus interface (7-bit addr 0x60-0x67, factory programmed)
    """
    i2c.required = True

    trait has_single_electric_reference
    has_single_electric_reference.reference ~ power

    # DAC output signals
    vouts = new ElectricLogic[4]
    """
    DAC Channel A, B, C, D output
    """
    for vout in vouts:
        vout.reference ~ power

    # Control signals
    ready = new ElectricLogic
    """
    Ready/Busy status output (active low)
    """
    ready.reference ~ power

    ldac = new ElectricLogic
    """
    Load DAC input (active low). When low, transfers data from input registers to DAC registers
    """
    ldac.reference ~ power

    # --- I²C bus ---
    # The MCP4728 has factory-programmed I2C addresses from 0x60 to 0x67
    # The address is selected at ordering time and cannot be changed
    i2c.address = 0x60

    # --- Decoupling capacitors ---
    power_caps = new Capacitor[2]
    power_caps[0].capacitance = 100nF +/- 20%
    power_caps[0].package = "0402"
    power_caps[1].capacitance = 10uF +/- 20%
    for cap in power_caps:
        power.hv ~> cap ~> power.lv

    # --- I²C pull-up resistors ---
    i2c_pullups = new Resistor[2]
    for pullup in i2c_pullups:
        pullup.resistance = 10kohm +/- 5%
        pullup.package = "0402"
    i2c.scl.line ~> i2c_pullups[0] ~> i2c.scl.reference.hv
    i2c.sda.line ~> i2c_pullups[1] ~> i2c.sda.reference.hv

    # --- Other configuration ---
    ldac_pulldown = new Resistor
    ldac_pulldown.resistance = 10kohm +/- 5%
    ldac_pulldown.package = "0402"
    ldac.line ~> ldac_pulldown ~> power.lv

    rdy_pullup = new Resistor
    rdy_pullup.resistance = 100kohm +/- 5%
    rdy_pullup.package = "0402"
    ready.line ~> rdy_pullup ~> power.hv

    # --- Package ---
    package = new Microchip_Tech_MCP4728_E_UN_package

    # Power connections
    package.VDD ~ power.hv
    package.VSS ~ power.lv

    # I2C connections
    package.SCL ~ i2c.scl.line
    package.SDA ~ i2c.sda.line

    # Control signal connections
    package.RDY_nBSY ~ ready.line

    package.nLDAC ~ ldac.line

    # DAC output connections
    package.VOUTA ~ vouts[0].line
    package.VOUTB ~ vouts[1].line
    package.VOUTC ~ vouts[2].line
    package.VOUTD ~ vouts[3].line
