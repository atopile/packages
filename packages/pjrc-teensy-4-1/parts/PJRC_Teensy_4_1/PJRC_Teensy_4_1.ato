#pragma experiment("TRAITS")
import has_designator_prefix
import is_atomic_part
import has_part_removed

component PJRC_Teensy_4_1_package:
    """
    This package only contains the 3D model of the Teensy 4.1.
    """

    trait is_atomic_part<manufacturer="PJRC", partnumber="Teensy 4.1", footprint="PJRC_Teensy_4_1.kicad_mod", symbol="PJRC_Teensy_4_1.kicad_sym", model="PJRC_Teensy_4_1.step">
    trait has_designator_prefix<prefix="U">
    trait has_part_removed
