#pragma experiment("TRAITS")
#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")

import has_designator_prefix
import has_part_picked
import is_atomic_part

import ElectricPower
import Capacitor
import Resistor
import SPI
import I2C
import I2S
import USB2_0
import JTAG
import UART
import ElectricLogic
import FilterElectricalRC

from "atopile/buttons/buttons.ato" import ButtonPulldown, ButtonSKRPACE010
from "parts/Espressif_Systems_ESP32_S3_WROOM_1_N8R2/Espressif_Systems_ESP32_S3_WROOM_1_N8R2.ato" import Espressif_Systems_ESP32_S3_WROOM_1_N8R2_package
from "parts/Espressif_Systems_ESP32_S3_WROOM_1_N8R8/Espressif_Systems_ESP32_S3_WROOM_1_N8R8.ato" import Espressif_Systems_ESP32_S3_WROOM_1_N8R8_package
from "parts/Espressif_Systems_ESP32_S3_WROOM_1_N16R2/Espressif_Systems_ESP32_S3_WROOM_1_N16R2.ato" import Espressif_Systems_ESP32_S3_WROOM_1_N16R2_package
from "parts/Espressif_Systems_ESP32_S3_WROOM_1_N16R8/Espressif_Systems_ESP32_S3_WROOM_1_N16R8.ato" import Espressif_Systems_ESP32_S3_WROOM_1_N16R8_package

module ESP32_S3_WROOM_N8R2 from ESP32_S3_WROOM:
    package -> Espressif_Systems_ESP32_S3_WROOM_1_N8R2_package

module ESP32_S3_WROOM_N8R8 from ESP32_S3_WROOM:
    package -> Espressif_Systems_ESP32_S3_WROOM_1_N8R8_package

module ESP32_S3_WROOM_N16R2 from ESP32_S3_WROOM:
    package -> Espressif_Systems_ESP32_S3_WROOM_1_N16R2_package

module ESP32_S3_WROOM_N16R8 from ESP32_S3_WROOM:
    package -> Espressif_Systems_ESP32_S3_WROOM_1_N16R8_package

module ESP32_S3_WROOM:
    """
    This is an esp32-s3 module.
    """
    package = new Espressif_Systems_ESP32_S3_WROOM_1_N8R8_package

    # Power
    power = new ElectricPower
    power.required = True
    assert power.voltage within 3V to 3.6V
    power.vcc ~ package.P3V3
    power.gnd ~ package.GND
    # assert power.current > 500mA
    # assert operating_temperature within -40C to 85C

    # Power decoupling
    decoupling_capacitors = new Capacitor[2]
    for cap in decoupling_capacitors:
        cap.power ~ power
    decoupling_capacitors[0].capacitance = 100nF +/- 20%
    decoupling_capacitors[1].capacitance = 22uF +/- 20%
    decoupling_capacitors[0].package = "C0402"
    decoupling_capacitors[1].package = "C0805"

    # Enable pin
    enable = new ElectricLogic
    enable.line ~ package.EN
    enable.reference ~ power

    # Enable pullup
    enable_pullup = new Resistor
    enable.line ~> enable_pullup ~> power.vcc
    enable_pullup.resistance = 10kohm +/- 20%
    enable_pullup.package = "R0402"

    # Enable Debounce Capacitor
    enable_debounce_cap = new Capacitor
    enable.line ~> enable_debounce_cap ~> power.gnd
    enable_debounce_cap.capacitance = 1uF +/- 20%
    enable_debounce_cap.package = "C0402"

    # reset button
    reset_button = new ButtonPulldown
    reset_button.btn -> ButtonSKRPACE010
    reset_button.output ~ enable
    reset_button.pulldown.resistance = 100ohm +/- 20%
    reset_button.pulldown.package = "R0402"

    # Boot
    boot = new ElectricLogic
    boot.line ~ package.IO0
    boot.reference ~ power

    # Boot Button
    boot_button = new ButtonPulldown
    boot_button.btn -> ButtonSKRPACE010
    boot_button.output ~ boot
    boot_button.pulldown.resistance = 100ohm +/- 20%
    boot_button.pulldown.package = "R0402"

    # GPIO
    gpios = new ElectricLogic[49]
    gpios[0].line ~ package.IO0
    gpios[1].line ~ package.IO1
    gpios[2].line ~ package.IO2
    gpios[3].line ~ package.IO3
    gpios[4].line ~ package.IO4
    gpios[5].line ~ package.IO5
    gpios[6].line ~ package.IO6
    gpios[7].line ~ package.IO7
    gpios[8].line ~ package.IO8
    gpios[9].line ~ package.IO9
    gpios[10].line ~ package.IO10
    gpios[11].line ~ package.IO11
    gpios[12].line ~ package.IO12
    gpios[13].line ~ package.IO13
    gpios[14].line ~ package.IO14
    gpios[15].line ~ package.IO15
    gpios[16].line ~ package.IO16
    gpios[17].line ~ package.IO17
    gpios[18].line ~ package.IO18
    gpios[19].line ~ package.IO19
    gpios[20].line ~ package.IO20
    gpios[21].line ~ package.IO21
    # gpio[22].no_connect = True
    # gpio[23].no_connect = True
    # gpio[24].no_connect = True
    # gpio[25].no_connect = True
    # gpio[26].no_connect = True
    # gpio[27].no_connect = True
    # gpio[28].no_connect = True
    # gpio[29].no_connect = True
    # gpio[30].no_connect = True
    # gpio[31].no_connect = True
    # gpio[32].no_connect = True
    # gpio[33].no_connect = True
    # gpio[34].no_connect = True
    gpios[35].line ~ package.IO35
    gpios[36].line ~ package.IO36
    gpios[37].line ~ package.IO37
    gpios[38].line ~ package.IO38
    gpios[39].line ~ package.IO39
    gpios[40].line ~ package.IO40
    gpios[41].line ~ package.IO41
    gpios[42].line ~ package.IO42
    # gpios[43].no_connect = True
    # gpios[44].no_connect = True
    gpios[45].line ~ package.IO45
    gpios[46].line ~ package.IO46
    gpios[47].line ~ package.IO47
    gpios[48].line ~ package.IO48

    for gpio in gpios:
        gpio.reference ~ power

    # for gpio in gpios[22:34]:
    #     gpio.no_connect = True
    # gpios[43].no_connect = True
    # gpios[44].no_connect = True

    # connect up USB
    usb2 = new USB2_0
    usb2.usb_if.d.n ~ gpios[19]
    usb2.usb_if.d.p ~ gpios[20]

    # connect up JTAG
    jtag = new JTAG
    jtag.tck ~ gpios[39]
    jtag.tms ~ gpios[42]
    jtag.tdi ~ gpios[41]
    jtag.tdo ~ gpios[40]
    jtag.vtref ~ power

    spi = new SPI[4]
    # spi[0].no_connect = True
    # spi[1].no_connect = True

    spi_cs = new ElectricLogic[4]
    # FSPI high speed pinout (interface 4c)
    spi_cs[2] ~ gpios[10]
    spi[2].mosi ~ gpios[11]
    spi[2].sclk ~ gpios[12]
    spi[2].miso ~ gpios[13]

    # SPI 3 - Use any GPIOs
    spi_cs[3] ~ gpios[14]
    spi[3].mosi ~ gpios[15]
    spi[3].sclk ~ gpios[16]
    spi[3].miso ~ gpios[17]
    
    # connect up I2C
    i2c = new I2C[2]
    # Any GPIOs can be used for I2C
    # i2c.scl ~ gpios[*]
    # i2c.sda ~ gpios[*]
    i2c[0].scl ~ gpios[1]
    i2c[0].sda ~ gpios[7]
    i2c[1].scl ~ gpios[14]
    i2c[1].sda ~ gpios[15]

    # I2S
    i2s = new I2S[2]
    # Any GPIOs can be used for I2S
    i2s[0].sck ~ gpios[2]
    i2s[0].ws ~ gpios[3]
    i2s[0].sd ~ gpios[4]

    i2s[1].sck ~ gpios[5]
    i2s[1].ws ~ gpios[6]
    i2s[1].sd ~ gpios[8]

    # UART
    uart = new UART[3]
    # UART0
    uart[0].base_uart.tx ~ gpios[43]
    uart[0].base_uart.rx ~ gpios[44]
    uart[0].rts ~ gpios[15]
    uart[0].cts ~ gpios[16]
    # U0DTR and U0DSR can be connected to any GPIO

    # UART1
    uart[1].base_uart.tx ~ gpios[17]
    uart[1].base_uart.rx ~ gpios[18]
    # uart[1].rts ~ gpios[19] # Typically not used
    # uart[1].cts ~ gpios[20] # Typically not used
    # U1DTR and U1DSR can be connected to any GPIO

    # UART2
    # The pins for UART2 can be chosen from any GPIO via the GPIO Matrix
    uart[2].base_uart.tx ~ gpios[21]
    uart[2].base_uart.rx ~ gpios[22]
    # uart[2].rts ~ gpios[23] # Typically not used
    # uart[2].cts ~ gpios[24] # Typically not used

    # CAN
    # can = new CAN[2] #TODO: add CAN to std library


component Espressif_Systems_ESP32_S3_WROOM_base:
    # pins
    signal EN ~ pin 3
    signal GND ~ pin 41
    GND ~ pin 40
    GND ~ pin 1
    signal IO0 ~ pin 27
    signal IO1 ~ pin 39
    signal IO2 ~ pin 38
    signal IO3 ~ pin 15
    signal IO4 ~ pin 4
    signal IO5 ~ pin 5
    signal IO6 ~ pin 6
    signal IO7 ~ pin 7
    signal IO8 ~ pin 12
    signal IO9 ~ pin 17
    signal IO10 ~ pin 18
    signal IO11 ~ pin 19
    signal IO12 ~ pin 20
    signal IO13 ~ pin 21
    signal IO14 ~ pin 22
    signal IO15 ~ pin 8
    signal IO16 ~ pin 9
    signal IO17 ~ pin 10
    signal IO18 ~ pin 11
    signal IO19 ~ pin 13
    signal IO20 ~ pin 14
    signal IO21 ~ pin 23
    signal IO35 ~ pin 28
    signal IO36 ~ pin 29
    signal IO37 ~ pin 30
    signal IO38 ~ pin 31
    signal IO39 ~ pin 32
    signal IO40 ~ pin 33
    signal IO41 ~ pin 34
    signal IO42 ~ pin 35
    signal IO45 ~ pin 26
    signal IO46 ~ pin 16
    signal IO47 ~ pin 24
    signal IO48 ~ pin 25
    signal P3V3 ~ pin 2
    signal RXD0 ~ pin 36
    signal TXD0 ~ pin 37
