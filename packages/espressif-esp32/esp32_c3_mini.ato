#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
#pragma experiment("TRAITS")
import ElectricPower
import Capacitor
import Resistor
import FilterElectricalRC
import ElectricLogic
import USB2_0_IF
import UART
import I2C
import has_single_electric_reference_shared

from "atopile/buttons/buttons.ato" import ButtonPullup, Button, VerticalButton

from "esp32_c3.ato" import ESP32_C3_base_model

from "parts/Espressif_Systems_ESP32_C3_MINI_1_N4/Espressif_Systems_ESP32_C3_MINI_1_N4.ato" import Espressif_Systems_ESP32_C3_MINI_1_N4_package
from "parts/Espressif_Systems_ESP32_C3_MINI_1U_H4/Espressif_Systems_ESP32_C3_MINI_1U_H4.ato" import Espressif_Systems_ESP32_C3_MINI_1U_H4_package

module ESP32_C3_MINI_1_base_model:
    """
    Base module for ESP32-C3-MINI-1 and ESP32-C3-MINI-1U
    """
    esp32 = new ESP32_C3_base_model
    #TODO: model internal components

    # external interfaces
    #TODO: should be passed through with export *
    power = new ElectricPower
    esp32.power_analog ~ power
    esp32.power_cpu ~ power
    esp32.power_rtc ~ power
    esp32.power_radio ~ power
    gpio = new ElectricLogic[22]
    esp32.gpio[0] ~ gpio[0]
    esp32.gpio[1] ~ gpio[1]
    esp32.gpio[2] ~ gpio[2]
    esp32.gpio[3] ~ gpio[3]
    esp32.gpio[4] ~ gpio[4]
    esp32.gpio[5] ~ gpio[5]
    esp32.gpio[6] ~ gpio[6]
    esp32.gpio[7] ~ gpio[7]
    esp32.gpio[8] ~ gpio[8]
    esp32.gpio[9] ~ gpio[9]
    esp32.gpio[10] ~ gpio[10]
    esp32.gpio[18] ~ gpio[18]
    esp32.gpio[19] ~ gpio[19]
    esp32.gpio[20] ~ gpio[20]
    esp32.gpio[21] ~ gpio[21]
    enable = new ElectricLogic
    esp32.enable ~ enable
    usb_if = new USB2_0_IF
    esp32.usb_if ~ usb_if
    uart = new UART
    esp32.uart[0] ~ uart
    # TODO: etc...

    trait has_single_electric_reference_shared

module ESP32_C3_MINI_1_model from ESP32_C3_MINI_1_base_model:
    """
    ESP32-C3-MINI-1 module with build-in antenna and supporting components
    """
    package = new Espressif_Systems_ESP32_C3_MINI_1_N4_package

    # connections to package
    esp32.gpio[0].line ~ package.IO0
    esp32.gpio[1].line ~ package.IO1
    esp32.gpio[2].line ~ package.IO2
    esp32.gpio[3].line ~ package.IO3
    esp32.gpio[4].line ~ package.IO4
    esp32.gpio[5].line ~ package.IO5
    esp32.gpio[6].line ~ package.IO6
    esp32.gpio[7].line ~ package.IO7
    esp32.gpio[8].line ~ package.IO8
    esp32.gpio[9].line ~ package.IO9
    esp32.gpio[10].line ~ package.IO10
    esp32.gpio[18].line ~ package.IO18
    esp32.gpio[19].line ~ package.IO19
    esp32.gpio[20].line ~ package.RXD0
    esp32.gpio[21].line ~ package.TXD0
    esp32.enable.line ~ package.EN
    power.hv ~ package.P3V3
    power.lv ~ package.GND

module ESP32_C3_MINI_1U_model from ESP32_C3_MINI_1_base_model:
    """
    ESP32-C3-MINI-1U module with u.fl antenna connector and supporting components
    """
    package = new Espressif_Systems_ESP32_C3_MINI_1U_H4_package

    # connections to package
    esp32.gpio[0].line ~ package.IO0
    esp32.gpio[1].line ~ package.IO1
    esp32.gpio[2].line ~ package.IO2
    esp32.gpio[3].line ~ package.IO3
    esp32.gpio[4].line ~ package.IO4
    esp32.gpio[5].line ~ package.IO5
    esp32.gpio[6].line ~ package.IO6
    esp32.gpio[7].line ~ package.IO7
    esp32.gpio[8].line ~ package.IO8
    esp32.gpio[9].line ~ package.IO9
    esp32.gpio[10].line ~ package.IO10
    esp32.gpio[18].line ~ package.IO18
    esp32.gpio[19].line ~ package.IO19
    esp32.gpio[20].line ~ package.RXD0
    esp32.gpio[21].line ~ package.TXD0
    esp32.enable.line ~ package.EN
    power.hv ~ package.P3V3
    power.lv ~ package.GND
    power.lv ~ package.GNDNC

module ESP32_C3_MINI_1_driver:
    esp32_module = new ESP32_C3_MINI_1_base_model

    # external interfaces
    power = new ElectricPower
    esp32_module.power ~ power

    # components
    boot_switch = new Button
    reset_switch = new ButtonPullup
    debounce_capacitors = new Capacitor[2]
    decoupling_capacitor_bulk = new Capacitor
    decoupling_capacitor_small = new Capacitor
    boot_mode_resistors = new Resistor[2]

    # connections
    power ~ decoupling_capacitor_bulk.power
    power ~ decoupling_capacitor_small.power

    power.lv ~> boot_switch ~> esp32_module.gpio[9].line
    boot_switch -> VerticalButton
    boot_switch.input ~> debounce_capacitors[0] ~> boot_switch.output

    reset_switch.output ~ esp32_module.esp32.enable
    reset_switch.button.button -> VerticalButton
    reset_switch.button.button.input ~> debounce_capacitors[1] ~> reset_switch.button.button.output

    esp32_module.gpio[2].line ~> boot_mode_resistors[0] ~> power.hv
    esp32_module.gpio[8].line ~> boot_mode_resistors[1] ~> power.hv

    # parameters
    decoupling_capacitor_bulk.capacitance = 22uF +/- 20%
    decoupling_capacitor_bulk.package = "C0603"
    decoupling_capacitor_small.capacitance = 100nF +/- 10%
    decoupling_capacitor_small.package = "C0402"
    for cap in debounce_capacitors:
        cap.capacitance = 100nF +/- 10%
        cap.package = "C0402"
    for res in boot_mode_resistors:
        res.resistance = 10kohm +/- 1%
        res.package = "R0402"

module ESP32_C3_MINI_1_driver_example:
    """
    Example driver for ESP32-C3-MINI-1 module
    """
    mcu = new ESP32_C3_MINI_1_driver
    mcu.esp32_module -> ESP32_C3_MINI_1_model

    power_3v3 = new ElectricPower
    power_3v3.voltage = 3.3V +/- 10%

    power_3v3 ~ mcu.power
