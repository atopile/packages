    # TODO replace with Net if #1226 is merged
    N_AGND = new Electrical
    N_AVDD = new Electrical
    N_DGND = new Electrical
    N_DVDD = new Electrical
    N_IOVDD = new Electrical
    N_PGND = new Electrical
    N_PVDD = new Electrical

    for dup in AGND:
        dup ~ N_AGND
    for dup in AVDD:
        dup ~ N_AVDD
    for dup in DGND:
        dup ~ N_DGND
    for dup in DVDD:
        dup ~ N_DVDD
    for dup in IOVDD:
        dup ~ N_IOVDD
    for dup in PGND:
        dup ~ N_PGND
    for dup in PVDD:
        dup ~ N_PVDD
