import Electrical

from "parts/Analog_Devices_ADAU1452WBCPZ/Analog_Devices_ADAU1452WBCPZ.ato" import Analog_Devices_ADAU1452WBCPZ_package

module Analog_Devices_ADAU145x_package_family:
    """
