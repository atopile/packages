#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("TRAITS")

import I2C
import ElectricSignal
import I2S
import SPI
import ElectricPower
import ElectricLogic
import Resistor
import has_part_removed

from "atopile/adi-adau145x/adi-adau145x.ato" import ADI_ADAU145x
from "atopile/validation-pogo/validation-pogo.ato" import DUTPogoPoint
from "atopile/validation-pogo/validation-pogo.ato" import DUTMountingHole
from "atopile/validation-pogo/validation-pogo.ato" import DUTDatumHole
from "atopile/validation-pogo/validation-pogo.ato" import PogoBoardPogo
from "atopile/logos/logos.ato" import atopile_logo_4x4mm

module Microcontroller:
    i2c = new I2C
    i2s = new I2S
    gpio = new ElectricLogic
    trait has_part_removed

module Amplifier:
    i2s = new I2S
    trait has_part_removed

module SPI_Pogo:
    spi = new SPI
    pogos = new DUTPogoPoint[3]
    spi.sclk.line ~ pogos[0].net
    spi.miso.line ~ pogos[1].net
    spi.mosi.line ~ pogos[2].net

module I2C_Pogo:
    i2c_sda = new ElectricLogic
    i2c_scl = new ElectricLogic
    pogos = new DUTPogoPoint[2]
    i2c_sda.line ~ pogos[0].net
    i2c_scl.line ~ pogos[1].net

module I2S_Pogo:
    i2s = new I2S
    pogos = new DUTPogoPoint[3]
    i2s.sd.line ~ pogos[0].net
    i2s.ws.line ~ pogos[1].net
    i2s.sck.line ~ pogos[2].net

module GPIO_Pogo:
    gpio = new ElectricLogic
    pogo = new DUTPogoPoint
    gpio.line ~ pogo.net

module Signal_Pogo:
    analog = new ElectricSignal
    pogo = new DUTPogoPoint
    analog.line ~ pogo.net

module Power_Pogo:
    power = new ElectricPower
    pogos = new DUTPogoPoint[2]
    power.hv ~ pogos[0].net
    power.lv ~ pogos[1].net

module Rail_Pogo:
    rail = new ElectricPower
    pogo = new DUTPogoPoint
    rail.hv ~ pogo.net

module MountingHardware:
    M3_mounting_holes = new DUTMountingHole[4]
    datum_holes = new DUTDatumHole[2]

module Usage:
    """
    Minimal usage example for adi-adau145x.
    Shows how to connect the ADAU145x DSP with power, I2C control, and I2S audio.
    """
    dsp = new ADI_ADAU145x
    mcu = new Microcontroller
    amp = new Amplifier

    # Power
    power = new ElectricPower
    power.required = True
    assert power.voltage within 3.3V +/- 5%
    power ~ dsp.power

    # Reset
    dsp.reset_disable ~ mcu.gpio

    # I2C - for configuration
    mcu.i2c ~ dsp.model.i2c

    # Configure I2C address
    dsp.model.i2c.address = 0x3B

    # I2C pullups
    pullups = new Resistor[2]
    for pullup in pullups:
        pullup.resistance = 4.7kohm +/- 10%
        pullup.package = "0402"

    mcu.i2c.sda.line ~> pullups[0] ~> power.hv
    mcu.i2c.scl.line ~> pullups[1] ~> power.hv

    # I2S - for audio
    mcu.i2s ~ dsp.model.i2s_ins[0]
    amp.i2s ~ dsp.model.i2s_outs[0]


    power_pogo = new Power_Pogo
    power_pogo.power ~ dsp.power

    # TODO move to dsp?
    dsp_digital_rail_pogo = new Rail_Pogo
    dsp_digital_rail_pogo.rail ~ dsp.model.power_digital
    dsp_i2c_pogo = new I2C_Pogo
    dsp_i2c_pogo.i2c_sda ~ dsp.model.i2c.sda
    dsp_i2c_pogo.i2c_scl ~ dsp.model.i2c.scl
    # TODO some random nc bug here (always high anyway)
    #dsp_spi_cs_pogo = new GPIO_Pogo
    #dsp_spi_cs_pogo.gpio.line ~ dsp.model.spi_cs.line
    dsp_spi_master_pogo = new SPI_Pogo
    dsp_spi_master_pogo.spi ~ dsp.model.spi_master
    dsp_spi_master_cs_pogo = new GPIO_Pogo
    dsp_spi_master_cs_pogo.gpio ~ dsp.model.spi_master_cs
    # TODO some random nc bug here
    #dsp_i2c_addressor_pogos = new GPIO_Pogo[2]
    #dsp.model.addressor.address_lines[0] ~ dsp_i2c_addressor_pogos[0].gpio
    #dsp.model.addressor.address_lines[1] ~ dsp_i2c_addressor_pogos[1].gpio
    dsp_i2s_pogo = new I2S_Pogo[8]
    dsp.model.i2s_ins[0] ~ dsp_i2s_pogo[0].i2s
    dsp.model.i2s_ins[1] ~ dsp_i2s_pogo[1].i2s
    dsp.model.i2s_ins[2] ~ dsp_i2s_pogo[2].i2s
    dsp.model.i2s_ins[3] ~ dsp_i2s_pogo[3].i2s
    dsp.model.i2s_outs[0] ~ dsp_i2s_pogo[4].i2s
    dsp.model.i2s_outs[1] ~ dsp_i2s_pogo[5].i2s
    dsp.model.i2s_outs[2] ~ dsp_i2s_pogo[6].i2s
    dsp.model.i2s_outs[3] ~ dsp_i2s_pogo[7].i2s
    dsp_gpio_pogos = new GPIO_Pogo[2]
    dsp.model.gpios[6].line ~ dsp_gpio_pogos[0].gpio
    dsp.model.gpios[7].line ~ dsp_gpio_pogos[1].gpio
    dsp_aux_adc_inputs_pogos = new Signal_Pogo[6]
    dsp.model.aux_adc_inputs[0] ~ dsp_aux_adc_inputs_pogos[0].analog
    dsp.model.aux_adc_inputs[1] ~ dsp_aux_adc_inputs_pogos[1].analog
    dsp.model.aux_adc_inputs[2] ~ dsp_aux_adc_inputs_pogos[2].analog
    dsp.model.aux_adc_inputs[3] ~ dsp_aux_adc_inputs_pogos[3].analog
    dsp.model.aux_adc_inputs[4] ~ dsp_aux_adc_inputs_pogos[4].analog
    dsp.model.aux_adc_inputs[5] ~ dsp_aux_adc_inputs_pogos[5].analog
    dsp_spdif_pogos = new Signal_Pogo[2]
    dsp.model.spdif_in ~ dsp_spdif_pogos[0].analog
    dsp.model.spdif_out ~ dsp_spdif_pogos[1].analog
    dsp_temperature_sensor_pogos = new DUTPogoPoint[2]
    dsp.model.temperature_sensor_in_p ~ dsp_temperature_sensor_pogos[0].net
    dsp.model.temperature_sensor_in_n ~ dsp_temperature_sensor_pogos[1].net
    dsp_reset_disable_pogo = new GPIO_Pogo
    dsp.model.reset_disable.line ~ dsp_reset_disable_pogo.gpio
    dsp_selfboot_enable_pogo = new GPIO_Pogo
    dsp.model.selfboot_enable.line ~ dsp_selfboot_enable_pogo.gpio
    dsp_pll_clkout = new DUTPogoPoint
    dsp.model.pll_clock_out ~ dsp_pll_clkout.net

    pll_filter_pogos = new DUTPogoPoint[3]
    dsp.pll_filter.input ~ pll_filter_pogos[0].net
    dsp.pll_filter.output ~ pll_filter_pogos[1].net
    dsp.pll_filter.r.unnamed[1] ~ pll_filter_pogos[2].net

    oscillator_driver_pogos = new DUTPogoPoint[3]
    dsp.oscillator_driver.input ~ oscillator_driver_pogos[0].net
    dsp.oscillator_driver.output ~ oscillator_driver_pogos[1].net
    dsp.oscillator_driver.xtal.unnamed[0] ~ oscillator_driver_pogos[2].net

    dvdd_regulator_pogos = new DUTPogoPoint
    dsp.regulator_driver.dvdd ~ dvdd_regulator_pogos.net

    mounting_hardware = new MountingHardware

    logo = new atopile_logo_4x4mm
