#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("TRAITS")

import I2C
import I2S
import ElectricPower
import ElectricLogic
import Resistor
import has_part_removed

from "atopile/adi-adau145x/adi-adau145x.ato" import ADI_ADAU145x
from "atopile/validation-pogo/validation-pogo.ato" import PogoPoint

module Microcontroller:
    i2c = new I2C
    i2s = new I2S
    gpio = new ElectricLogic
    trait has_part_removed

module Amplifier:
    i2s = new I2S
    trait has_part_removed

module SPI_Pogo:
    spi = new SPI
    pogos = new PogoPoint[4]

module I2C_Pogo:
    i2c = new I2C
    pogos = new PogoPoint[2]

module I2S_Pogo:
    i2s = new I2S
    pogos = new PogoPoint[4]

module Usage:
    """
    Minimal usage example for adi-adau145x.
    Shows how to connect the ADAU145x DSP with power, I2C control, and I2S audio.
    """
    dsp = new ADI_ADAU145x
    mcu = new Microcontroller
    amp = new Amplifier

    # Power
    power = new ElectricPower
    power.required = True
    assert power.voltage within 3.3V +/- 5%
    power ~ dsp.power

    # Reset
    dsp.reset_disable ~ mcu.gpio

    # I2C - for configuration
    mcu.i2c ~ dsp.model.i2c

    # Configure I2C address
    dsp.model.i2c.address = 0x3B

    # I2C pullups
    pullups = new Resistor[2]
    for pullup in pullups:
        pullup.resistance = 4.7kohm +/- 10%
        pullup.package = "0402"

    mcu.i2c.sda.line ~> pullups[0] ~> power.hv
    mcu.i2c.scl.line ~> pullups[1] ~> power.hv

    # I2S - for audio
    mcu.i2s ~ dsp.model.i2s_ins[0]
    amp.i2s ~ dsp.model.i2s_outs[0]



    dsp_pogos = new PogoPoint[4]

    # All (except digital) rails connected
    dsp.power.hv ~ dsp_pogos[0].net
    dsp.power.lv ~ dsp_pogos[1].net
    dsp.model.power_digital.hv ~ dsp_pogos[2].net

    spi_pogo = new SPI_Pogo
    spi_pogo.spi ~ dsp.model.spi
    dsp.model.spi_cs ~ dsp_pogos[3].net

    spi_master_pogo = new SPI_Pogo
    spi_master_pogo.spi ~ dsp.model.spi_master
    dsp.model.spi_master_cs ~ dsp_pogos[4].net

    i2c_pogo = new I2C_Pogo
    i2c_pogo.i2c ~ dsp.model.i2c
    dsp.model.addressor.address_lines[0] ~ dsp_pogos[5].net
    dsp.model.addressor.address_lines[1] ~ dsp_pogos[6].net

    i2c_master_pogo = new I2C_Pogo
    i2c_master_pogo.i2c ~ dsp.model.i2c_master

    i2s_pogo = new I2S_Pogo[8]

    pll_filter_pogos = new PogoPoint[0]

    oscillator_driver_pogos = new PogoPoint[0]

    dvdd_regulator_pogos = new PogoPoint[0]
