import BJT
import Capacitor
import Crystal
import Electrical
import ElectricLogic
import ElectricPower
import ElectricSignal
import has_single_electric_reference_shared
import I2C
import I2S
import MultiCapacitor
import Net
import Resistor
import SPI
import can_bridge_by_name

from "adi-adau145x-model.ato" import Analog_Devices_ADAU145x_model
from "parts/Nexperia_PBSS5350X_115/Nexperia_PBSS5350X_115.ato" import Nexperia_PBSS5350X_115_package
from "parts/TAE_TXM12_288M0004322FBCDO00T/TAE_TXM12_288M0004322FBCDO00T.ato" import TAE_TXM12_288M0004322FBCDO00T_driver
from "parts/GENERIC_TESTPOINT/GENERIC_TESTPOINT.ato" import GENERIC_TESTPOINT


module _BypassCapacitor from Capacitor:
    big_cap = new Capacitor
    small_cap = new Capacitor

    for c in [big_cap, small_cap]:
        unnamed[0] ~> c ~> unnamed[1]

    big_cap.capacitance = 100nF +/- 10%
    small_cap.capacitance = 10nF +/- 10%

    big_cap.package = "0402"
    small_cap.package = "0402"


module _PLLFilter:
    input = new Electrical
    output = new Electrical

    trait can_bridge_by_name

    r = new Resistor
    c1 = new Capacitor
    c2 = new Capacitor

    assert r.resistance within 4.3kohm +/- 10%
    assert c1.capacitance within 5.6nF +/- 10%
    assert c2.capacitance within 150pF +/- 10%

    input ~> r ~> c1 ~> output
    input ~> c2 ~> output

module _BridgeableXTAL from Crystal:
    trait can_bridge_by_name<input_name="unnamed[0]", output_name="unnamed[1]">

module _OscillatorDriver:
    """
    Drives the ADAU145x on-chip crystal oscillator.
    Implements the recommended circuit from the datasheet:
        • 100 Ω damping resistor on XTALOUT.
        • Crystal between XTALOUT and XTALIN (frequency 3.072 MHz–24.576 MHz, nominal 12.288 MHz).
        • Two load capacitors (~22 pF) from each pin to ground.
    """

    # Ports
    input  = new Electrical
    output = new Electrical
    ground = new Electrical

    trait can_bridge_by_name

    # Components
    xtal   = new _BridgeableXTAL
    r_damp = new Resistor
    c_load = new Capacitor[2]

    # ‑-- Assertions ---------------------------------------------------------
    assert xtal.frequency within 3.072MHz to 24.576MHz
    # I don't believe this is correct, but it's what the datasheet says
    #assert xtal.shunt_capacitance within 7pF +/- 10%
    assert xtal.shunt_capacitance within 7pF +/- 30%

    assert r_damp.resistance within 100ohm +/- 10%

    c_stray = 2pF to 5pF
    load_capacitance: F
    # x.c = c[0] * c[1] / (c[0] + c[1]) + c_stray
    # x.c = c**2 / 2*c + c_stray
    # x.c = c / 2 + c_stray
    assert xtal.load_capacitance within load_capacitance / 2 + c_stray
    assert load_capacitance within 2 * (xtal.load_capacitance - c_stray)

    for c in c_load:
        assert c.capacitance within load_capacitance * (1 +/- 10%)

    # ‑-- Connectivity -------------------------------------------------------
    input ~> r_damp ~> xtal ~> output
    xtal.unnamed[0] ~> c_load[0] ~> ground
    xtal.unnamed[1] ~> c_load[1] ~> ground
    xtal.gnd ~> ground

# Hacking using local test point part
module TestPoint from GENERIC_TESTPOINT:
    pass

module ADI_ADAU145x:
    """
    Analog Devices ADAU145x Audio DSP
    
    This module provides a complete implementation for the ADAU145x family of audio DSPs,
    including power management, crystal oscillator, PLL filtering, and all necessary
    decoupling components.
    
    External Interfaces:
    - power: Main power supply (3.3V ±10%)
    - reset_disable: Reset control pin
    - pll_mclk: PLL master clock input (optional)
    - model: Access to the underlying ADAU145x model for I2C, I2S, etc.
    """
    
    model = new Analog_Devices_ADAU145x_model

    # --- External interfaces ---
    power = new ElectricPower
    """
    Main power supply for the ADAU145x (3.3V ±10%)
    """
    power.required = True
    assert power.voltage within 3.3V +/- 10%

    # connect thermal pad
    model.package.EP ~ power.lv
    for rail in [
        model.power_io,
        model.power_analog,
        model.power_pll,
    ]:
        power ~ rail

    tp_power = new TestPoint
    tp_power.contact ~ power.hv
    tp_power_digital = new TestPoint
    tp_power_digital.contact ~ model.power_digital.hv
    tp_gnd = new TestPoint
    tp_gnd.contact ~ power.lv
    tp_clockout = new TestPoint
    tp_clockout.contact ~ model.pll_clock_out

    # --- Decoupling capacitors ---
    bulk_decoupling_power_caps = new Capacitor[4]
    # TODO verify pin neighbours with chip
    decoupling_power_io = new MultiCapacitor<count=4>
    model.power_io.hv ~> decoupling_power_io ~> model.power_io.lv
    model.package.IOVDD[0] ~> decoupling_power_io.capacitors[0] ~> model.package.DGND[0]
    model.package.IOVDD[1] ~> decoupling_power_io.capacitors[1] ~> model.package.DGND[1]
    model.package.IOVDD[2] ~> decoupling_power_io.capacitors[2] ~> model.package.DGND[5]
    model.package.IOVDD[3] ~> decoupling_power_io.capacitors[3] ~> model.package.DGND[7]
    model.package.IOVDD[0] ~> bulk_decoupling_power_caps[0] ~> model.package.DGND[0]

    decoupling_power_analog = new MultiCapacitor<count=1>
    model.power_analog.hv ~> decoupling_power_analog ~> model.power_analog.lv
    model.package.AVDD[0] ~> decoupling_power_analog.capacitors[0] ~> model.package.AGND[0]
    model.package.AVDD[0] ~> bulk_decoupling_power_caps[1] ~> model.package.AGND[0]

    decoupling_power_digital = new MultiCapacitor<count=4>
    model.power_digital.hv ~> decoupling_power_digital ~> model.power_digital.lv
    model.package.DVDD[0] ~> decoupling_power_digital.capacitors[0] ~> model.package.DGND[2]
    model.package.DVDD[1] ~> decoupling_power_digital.capacitors[1] ~> model.package.DGND[4]
    model.package.DVDD[2] ~> decoupling_power_digital.capacitors[2] ~> model.package.DGND[6]
    model.package.DVDD[3] ~> decoupling_power_digital.capacitors[3] ~> model.package.DGND[8]
    model.package.DVDD[0] ~> bulk_decoupling_power_caps[2] ~> model.package.DGND[2]

    decoupling_power_pll = new MultiCapacitor<count=1>
    model.power_pll.hv ~> decoupling_power_pll ~> model.power_pll.lv
    model.package.PVDD[0] ~> decoupling_power_pll.capacitors[0] ~> model.package.PGND[0]
    model.package.PVDD[0] ~> bulk_decoupling_power_caps[3] ~> model.package.PGND[0]

    for c in decoupling_power_io.capacitors:
        #c -> _BypassCapacitor
        c.package = "0402"
        c.capacitance = 100nF +/- 10%
    for c in decoupling_power_analog.capacitors:
        #c -> _BypassCapacitor
        c.package = "0402"
        c.capacitance = 100nF +/- 10%
    for c in decoupling_power_digital.capacitors:
        #c -> _BypassCapacitor
        c.package = "0402"
        c.capacitance = 100nF +/- 10%
    for c in decoupling_power_pll.capacitors:
        #c -> _BypassCapacitor
        c.package = "0402"
        c.capacitance = 100nF +/- 10%
    for c in bulk_decoupling_power_caps:
        c.package = "0805"
        c.capacitance = 10uF +/- 20%

    # --- PLL filter ---
    pll_filter = new _PLLFilter
    model.pll_filter ~> pll_filter ~> model.power_pll.hv

    # --- Crystal oscillator ---
    oscillator_driver = new _OscillatorDriver
    model.xtal_in ~> oscillator_driver ~> model.xtal_out
    oscillator_driver.ground ~ power.lv

    # --- Power supply ---
    # power_io IOVDD, reference voltage for digital input output, externally supplied, max current 47mA
    # power_analog AVDD, powers DSP core, optionally can be derived using internal LDO, max current 2mA
    # power_digital DVDD, powers auxilary ADC, externally supplied, max current 690mA
    # power_pll PVDD, powers PLL and reference for VCO, externally supplied

    # DVDD internal LDO
    output_debug_resistor = new Resistor
    output_debug_resistor.resistance = 0ohm +/- 0.05
    output_debug_resistor.package = "R0603"

    bjt_pnp = new BJT #	DC I gain is >=200 at 1A, needs 6cm^2 of layout to dissipate 1W at 60C amb
    bjt_pnp.doping_type = "PNP"
    bjt_pnp.lcsc_id = "C426844"
    model.package.IOVDD[0] ~ bjt_pnp.emitter
    model.package.VDRIVE ~ bjt_pnp.base
    for dvdd in model.package.DVDD:
        bjt_pnp.collector ~> output_debug_resistor ~> dvdd

    vdrive_min_load_res = new Resistor
    vdrive_min_load_res.resistance = 1kohm +/- 5%
    vdrive_min_load_res.package = "R0402"
    model.package.IOVDD[0] ~> vdrive_min_load_res ~> model.package.VDRIVE

    # --- Component specifications ---
    oscillator_driver.xtal -> TAE_TXM12_288M0004322FBCDO00T_driver
    oscillator_driver.r_damp.package = "0402"
    oscillator_driver.c_load[0].package = "0402"
    oscillator_driver.c_load[1].package = "0402"

    # --- External control pins ---
    reset_disable = new ElectricLogic
    """
    Reset disable control pin - connect to microcontroller GPIO
    """
    pll_mclk = new ElectricLogic
    """
    PLL master clock input (optional)
    """
    reset_disable ~ model.reset_disable
    pll_mclk.line ~ model.pll_mclk
    reset_disable.required = True
    # pll_mclk.required = True
