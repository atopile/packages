import ElectricPower
import I2C

from "parts/JST_Sales_America_BM04B_SRSS_TB_LF__SN/JST_Sales_America_BM04B_SRSS_TB_LF__SN.ato" import JST_Sales_America_BM04B_SRSS_TB_LF__SN_package

module StemmaQTVertical:
    package = new JST_Sales_America_BM04B_SRSS_TB_LF__SN_package
    power = new ElectricPower
    i2c = new I2C

    power.gnd ~ package.1
    power.vcc ~ package.2
    i2c.sda.line ~ package.3
    i2c.scl.line ~ package.4


module Example:
    power = new ElectricPower
    power.voltage = 3.3V +/- 5%

    i2c = new I2C

    stemma_qt_vertical = new StemmaQTVertical
    i2c ~ stemma_qt_vertical.i2c
    power ~ stemma_qt_vertical.power
