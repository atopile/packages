import Capacitor
import Diode
import Inductor
import ElectricPower
import ElectricLogic
import ElectricSignal
import has_single_electric_reference
import AdjustableRegulator

from "parts/Texas_Instruments_LV2842XLVDDCR/Texas_Instruments_LV2842XLVDDCR.ato" import Texas_Instruments_LV2842XLVDDCR_package
from "parts/Guangdong_Hottech_1N5819WS/Guangdong_Hottech_1N5819WS.ato" import Guangdong_Hottech_1N5819WS_package

module TI_LV2842X from AdjustableRegulator:
    """
    High Efficiency Wide Input Voltage Range Buck Regulator

    LV2842 Reference Design
    Vin: 4.5V to 15V
    Vout: 0.8V to 42V
    Iout max: 0.6A
    Iout max peak: 1.2A
    Switching Frequency: 1.1MHz

    """

    # --- Package ---
    package = new Texas_Instruments_LV2842XLVDDCR_package

    # --- Parameters ---
    assert reference_voltage within 0.765V +/- 19mV
    assert power_in.voltage within 4V to 40V
    assert power_out.voltage within 0.765V to 40V
    assert power_out.max_current within 10mA to 600mA  # to be specialized by exact IC
    # K_IND = 0.3 # Ripple factor, 30% of Io  # TODO: simple solver can't handle cross-parameter expressions
    # current_ripple = K_IND * power_out.max_current
    # switching_frequency = 325kHz to 1500kHz

    # --- Internal interfaces ---
    _power_sw_out = new ElectricPower
    _bootstrap = new ElectricSignal
    _enable = new ElectricLogic
    _enable.reference ~ power_in

    trait has_single_electric_reference<ground_only = True>

    # --- Package Connections ---
    power_in.hv ~ package.VIN
    power_in.lv ~ package.GND
    _power_sw_out.hv ~ package.SW
    _bootstrap.line ~ package.CB
    feedback_divider.ref_out.hv ~ package.FB
    _enable.line ~ package.nSHDN

    # Components
    diode = new Diode_1N5819WS
    inductor = new Inductor
    inductor.package = "SMD5x5mm"

    # --- Bootstrap Capacitor ---
    bootstrap_capacitor = new Capacitor
    bootstrap_capacitor.capacitance = 200nF to 1uF
    bootstrap_capacitor.package = "C0402"
    _bootstrap.line ~> bootstrap_capacitor ~> _power_sw_out.hv

    # --- Feedback Divider ---
    assert feedback_divider.current within 1uA to 100uA
    feedback_divider.chain.resistors[0].package = "R0402"
    feedback_divider.chain.resistors[1].package = "R0402"
    # feedback divider FB connection is made directly to package pin above

    # --- Enable ---
    # by default the shutdown pin is internally pulled up,
    # connection it anyway to power in makes routing more compact
    _enable.line ~ power_in.hv

    # --- Input Capacitor ---
    input_cap = new Capacitor
    power_in.hv ~> input_cap ~> power_in.lv
    # assert input_cap.max_voltage >= (power_in.voltage * 2) # DC bias derating factor
    assert input_cap.max_voltage >= 100V
    assert input_cap.capacitance within 2.2uF to 10uF
    input_cap.package = "C1206"

    # --- Output Capacitors ---
    output_caps = new Capacitor[5]
    for cap in output_caps:
        cap.package = "C1206"
        assert cap.max_voltage within 50V to 100V
        assert cap.capacitance within 8uF to 12uF
        power_out.hv ~> cap ~> power_out.lv

    # --- Diode ---
    # lv>A>K>hv
    power_out.lv ~> diode ~> _power_sw_out.hv

    # --- Inductor ---
    _power_sw_out.hv ~> inductor ~> power_out.hv

    # --- Calculations ---
    # TODO: simple solver can't handle complex cross-parameter expressions
    assert inductor.inductance within 10uH to 100uH
    assert inductor.saturation_current >= 1A
    assert inductor.max_current >= 1A

component Diode_1N5819WS from Diode:
    package = new Guangdong_Hottech_1N5819WS_package
    cathode ~ package.K
    anode ~ package.A
