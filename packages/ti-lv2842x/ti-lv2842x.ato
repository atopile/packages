#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("TRAITS")

import Capacitor
import Diode
import Inductor
import ElectricPower
import ElectricLogic
import ElectricSignal
import has_single_electric_reference
from "regulators.ato" import Buck

from "parts/Texas_Instruments_LV2842XLVDDCR/Texas_Instruments_LV2842XLVDDCR.ato" import Texas_Instruments_LV2842XLVDDCR_package
from "parts/Guangdong_Hottech_1N5819WS/Guangdong_Hottech_1N5819WS.ato" import Guangdong_Hottech_1N5819WS_package

module TI_LV2842X from Buck:
    """
    High Efficiency Wide Input Voltage Range Buck Regulator

    LV2842 Reference Design
    Vin: 4.5V to 15V
    Vout: 0.8V to 42V
    Iout max: 0.6A
    Iout max peak: 1.2A
    Switching Frequency: 1.1MHz

    """

    # --- Package ---
    package = new Texas_Instruments_LV2842XLVDDCR_package

    # --- Parameters ---
    assert reference_voltage within 0.765V +/- 19mV
    assert power_in.voltage within 4V to 40V
    assert power_out.voltage >= reference_voltage
    assert power_out.voltage <= 40V
    assert power_out.max_current within 10mA to 600mA  # to be specialized by exact IC
    K_IND = 0.3  # Ripple factor, 30% of Io
    current_ripple = K_IND * power_out.max_current
    switching_frequency = 325kHz to 1500kHz

    # --- Internal interfaces ---
    _power_sw_out = new ElectricPower
    assert _power_sw_out.voltage within -1V to 40V
    _bootstrap = new ElectricSignal
    assert _bootstrap.reference.voltage within 3.8 to 45V
    _feedback = new ElectricSignal
    assert _feedback.reference.voltage within 0V to 5V
    _enable = new ElectricLogic
    _enable.reference ~ power_in

    trait has_single_electric_reference<ground_only = True>

    # --- Package Connections ---
    power_in.hv ~ package.VIN
    power_in.lv ~ package.GND
    _power_sw_out.hv ~ package.SW
    _bootstrap.line ~ package.CB
    _feedback.line ~ package.FB
    _enable.line ~ package.nSHDN

    # Components
    diode = new Diode_1N5819WS
    inductor = new Inductor
    inductor.package = "SMD5x5mm"

    # --- Bootstrap Capacitor ---
    bootstrap_capacitor = new Capacitor
    bootstrap_capacitor.capacitance = 200nF to 1uF
    bootstrap_capacitor.package = "0402"
    bootstrap_capacitor.unnamed[0] ~ _bootstrap.line
    bootstrap_capacitor.unnamed[1] ~ _power_sw_out.hv

    # --- Feedback Divider ---
    feedback_divider.chain.resistors[0].package = "0402"
    feedback_divider.chain.resistors[1].package = "0402"
    feedback_divider.ref_out.hv ~ _feedback.line
    feedback_divider.ref_out.lv ~ _feedback.reference.lv

    # --- Enable ---
    # by default the shutdown pin is internally pulled up,
    # connection it anyway to power in makes routing more compact
    _enable.line ~ power_in.hv

    # --- Input Capacitor ---
    input_cap = new Capacitor
    input_cap.power ~ power_in
    # assert input_cap.max_voltage >= (power_in.voltage * 2) # DC bias derating factor
    assert input_cap.max_voltage >= 100V
    assert input_cap.capacitance within 2.2uF to 10uF
    input_cap.package = "1206"

    # --- Output Capacitors ---
    output_caps = new Capacitor[5]
    output_capacitance = 0 uF
    for cap in output_caps:
        cap.power ~ power_out
        cap.package = "1206"
        # assert cap.max_voltage >= power_out.voltage * 2 # DC bias derating factor
        # assert cap.max_voltage >= 49V
        assert cap.max_voltage within 50V to 100V
        assert cap.capacitance within 8uF to 12uF
        output_capacitance = output_capacitance + cap.capacitance

    # --- Diode ---
    # lv>A>K>hv
    power_out.lv ~> diode ~> _power_sw_out.hv

    # --- Inductor ---
    _power_sw_out.hv ~> inductor ~> power_out.hv

    # --- Calculations ---
    assert inductor.inductance within (power_in.voltage - power_out.voltage) * power_out.voltage / (power_in.voltage * current_ripple * switching_frequency)
    assert inductor.saturation_current >= power_out.max_current * 1.10
    assert inductor.max_current >= power_out.max_current
    duty = power_out.voltage / power_in.voltage
    assert duty <= 0.81  # 81% duty cycle is the maximum for the LV2842
    # voltage_ripple = current_ripple * (ESR + (1/(8*switching_frequency*output_capacitance)))

component Diode_1N5819WS from Diode:
    package = new Guangdong_Hottech_1N5819WS_package
    cathode ~ package.K
    anode ~ package.A
