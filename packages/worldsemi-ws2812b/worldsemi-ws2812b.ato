module WS2812B_2020_HighDensity_Strip:
    """
    High-density WS2812B-2020 LED strip with 10 ultra-compact LEDs.
    Perfect for applications requiring maximum LED density in minimal space.

    Applications:
    - Wearable electronics and fashion
    - High-resolution LED matrices
    - Backlighting for small displays
    - Precision decorative lighting
    - Space-constrained installations
    """

    # Create array of 20 compact LEDs
    leds = new Worldsemi_WS2812B_2020[5]

    # External interfaces
    power = new ElectricPower
    """High-density strip power supply (5V recommended)"""

    data_in = new ElectricLogic
    """Strip data input from microcontroller"""

    data_out = new ElectricLogic
    """Strip data output to next LED"""

    # Connect power to all LEDs
    for led in leds:
        power ~ led.power

    # Chain data signals through all LEDs
    data_in ~> leds[0] ~> leds[1] ~> leds[2] ~> leds[3] ~> leds[4] ~> data_out

    # Additional filtering for 2020 LEDs
    hf_filter_cap = new Capacitor
    hf_filter_cap.capacitance = 10uF +/- 20%
    hf_filter_cap.package = "0603"
    power.hv ~> hf_filter_cap ~> power.lv

    # --- Bridging trait for LED strips ---
    trait can_bridge_by_name<input_name = "data_in", output_name = "data_out">

module WS2812B_2020_Matrix:
    """
    4×4 LED matrix using WS2812B-2020 for high-resolution displays.
    Compact design perfect for wearable displays and indicators.
    """

    # Create 5x5 matrix (25 LEDs total)
    strips = new WS2812B_2020_HighDensity_Strip[5]

    # External interfaces
    power = new ElectricPower
    """Matrix power supply"""

    data_in = new ElectricLogic
    """Matrix data input"""

    data_out = new ElectricLogic
    """Matrix data output to next strip"""

    # Connect power to all LEDs
    for strip in strips:
        power ~ strip.power

    # Chain LEDs in matrix order (row by row)
    data_in ~> strips[0] ~> strips[1] ~> strips[2] ~> strips[3] ~> strips[4] ~> data_out

    # --- Bridging trait for LED strips ---
    trait can_bridge_by_name<input_name = "data_in", output_name = "data_out">
