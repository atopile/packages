#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("TRAITS")

import Capacitor
import ElectricPower
import ElectricLogic
import can_bridge_by_name
from "parts/Worldsemi_WS2812B_2020/Worldsemi_WS2812B_2020.ato" import Worldsemi_WS2812B_2020_package
from "parts/Worldsemi_WS2812B_4020/Worldsemi_WS2812B_4020.ato" import Worldsemi_WS2812B_4020_package
from "parts/Worldsemi_WS2812B_V5_W/Worldsemi_WS2812B_V5_W.ato" import Worldsemi_WS2812B_V5_W_package

module Worldsemi_WS2812B_2020:
    """
    Driver for Worldsemi WS2812B-2020 ultra-compact addressable RGB LED.

    Key features:
    - Ultra-compact 2020 package (2.0mm × 2.0mm × 0.84mm)
    - Integrated RGB LED with WS2812B controller
    - Single-wire serial communication protocol
    - 24-bit color depth (8-bit per R/G/B channel)
    - Wide voltage range: 3V-5.5V
    - Low power consumption: ~ 20mA per LED max
    - High-density applications and wearables
    - 800kHz data rate with 1.25μs pulse width
    """

    # --- Package ---
    package = new Worldsemi_WS2812B_2020_package

    # --- External interfaces ---
    power = new ElectricPower
    """
    Power supply interface (3V-5.5V, typically 5V)
    Ultra-low current: ~ 20mA per LED at full brightness
    Improved power efficiency compared to 5050 variants
    """
    power.required = True

    data_in = new ElectricLogic
    """
    Serial data input for RGB control
    Receives 24-bit GRB data packets at 800kHz
    Compatible with 3.3V and 5V logic levels
    """
    data_in.required = True

    data_out = new ElectricLogic
    """
    Serial data output for chaining to next LED
    Forwards remaining data bits after processing own 24 bits
    Built-in signal reshaping and amplification
    """

    # --- Power supply constraints ---
    assert power.voltage within 3V to 5.5V

    # --- Power decoupling (critical for 2020 package) ---
    decoupling_cap = new Capacitor
    decoupling_cap.capacitance = 100nF +/- 20%
    decoupling_cap.package = "0402"
    power.hv ~> decoupling_cap ~> power.lv

    # --- Package connections ---
    package.VDD ~ power.hv
    package.GND ~ power.lv
    data_in.line ~ package.DI
    package.DO ~ data_out.line

    # --- Bridging trait for LED strips ---
    trait can_bridge_by_name<input_name = "data_in", output_name = "data_out">

