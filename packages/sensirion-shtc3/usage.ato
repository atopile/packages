#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

# --- Standard library imports ---
import ElectricPower
import I2C

# --- Package import ---
from "sensirion-shtc3.ato" import Sensirion_SHTC3


module Usage:
    """
    Minimal usage example for `sensirion-shtc3`.
    Powers the SHTC3 from a 3 V 3 rail and connects it to an I²C bus using the
    fixed address **0x70**.
    """

    # Power rail (3.3 V)
    power_3v3 = new ElectricPower
    power_3v3.voltage = 3.3V

    # I²C bus
    i2c_bus = new I2C

    # Sensor instance
    sensor = new Sensirion_SHTC3

    # Connect power rail
    power_3v3 ~ sensor.power

    # Provide logic reference for the bus
    power_3v3 ~ i2c_bus.scl.reference
    power_3v3 ~ i2c_bus.sda.reference

    # Connect I²C bus
    i2c_bus ~ sensor.i2c
