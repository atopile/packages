#pragma experiment("TRAITS")
#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")

import has_designator_prefix
import has_part_picked
import is_atomic_part

import ElectricPower
import Capacitor
import Resistor
import SPI
import I2C
import I2S
import USB2_0
import JTAG
import UART
import ElectricLogic
import FilterElectricalRC

from "atopile/buttons/buttons.ato" import ButtonPulldown, VerticalButton
from "parts/Espressif_Systems_ESP32_C3_WROOM_02_N4/Espressif_Systems_ESP32_C3_WROOM_02_N4.ato" import Espressif_Systems_ESP32_C3_WROOM_02_N4_package
from "parts/Espressif_Systems_ESP32_C3_WROOM_02_H4/Espressif_Systems_ESP32_C3_WROOM_02_H4.ato" import Espressif_Systems_ESP32_C3_WROOM_02_H4_package
from "parts/Espressif_Systems_ESP32_C3_WROOM_02U_N4/Espressif_Systems_ESP32_C3_WROOM_02U_N4.ato" import Espressif_Systems_ESP32_C3_WROOM_02U_N4_package

module ESP32_C3_WROOM_02_N4 from ESP32_C3_WROOM:
    package -> Espressif_Systems_ESP32_C3_WROOM_02_N4_package

module ESP32_C3_WROOM_02_H4 from ESP32_C3_WROOM:
    package -> Espressif_Systems_ESP32_C3_WROOM_02_H4_package

module ESP32_C3_WROOM_02U_N4 from ESP32_C3_WROOM:
    package -> Espressif_Systems_ESP32_C3_WROOM_02U_N4_package

module ESP32_C3_WROOM:
    """
    This is an esp32-c3 module.
    """
    package = new Espressif_Systems_ESP32_C3_WROOM_02_N4_package

    # Power
    power = new ElectricPower
    power.required = True
    assert power.voltage within 3V to 3.6V
    power.vcc ~ package.P3V3
    power.gnd ~ package.GND
    # assert power.current > 500mA
    # assert operating_temperature within -40C to 85C

    # Power decoupling
    decoupling_capacitors = new Capacitor[2]
    for cap in decoupling_capacitors:
        cap.power ~ power
    decoupling_capacitors[0].capacitance = 100nF +/- 20%
    decoupling_capacitors[1].capacitance = 10uF +/- 20%
    decoupling_capacitors[0].package = "C0402"
    decoupling_capacitors[1].package = "C0805"

    # Enable pin
    enable = new ElectricLogic
    enable.line ~ package.EN
    enable.reference ~ power

    # Enable pullup
    enable_pullup = new Resistor
    enable.line ~> enable_pullup ~> power.vcc
    enable_pullup.resistance = 10kohm +/- 20%
    enable_pullup.package = "R0402"

    # Enable Debounce Capacitor
    enable_debounce_cap = new Capacitor
    enable.line ~> enable_debounce_cap ~> power.gnd
    enable_debounce_cap.capacitance = 1uF +/- 20%
    enable_debounce_cap.package = "C0402"

    # reset button
    reset_button = new ButtonPulldown
    reset_button.button.button -> VerticalButton
    reset_button.output ~ enable
    reset_button.pulldown.resistance = 100ohm +/- 20%
    reset_button.pulldown.package = "R0402"

    # Boot
    boot = new ElectricLogic
    boot.line ~ package.IO9
    boot.reference ~ power

    # Boot Button
    boot_button = new ButtonPulldown
    boot_button.button.button -> VerticalButton
    boot_button.output ~ boot
    boot_button.pulldown.resistance = 100ohm +/- 20%
    boot_button.pulldown.package = "R0402"

    # GPIO
    gpios = new ElectricLogic[22]
    gpios[0].line ~ package.IO0
    gpios[1].line ~ package.IO1
    gpios[2].line ~ package.IO2
    gpios[3].line ~ package.IO3
    gpios[4].line ~ package.IO4
    gpios[5].line ~ package.IO5
    gpios[6].line ~ package.IO6
    gpios[7].line ~ package.IO7
    gpios[8].line ~ package.IO8
    gpios[9].line ~ package.IO9
    gpios[10].line ~ package.IO10
    # gpio[11].no_connect = True
    # gpio[12].no_connect = True
    # gpio[13].no_connect = True
    # gpio[14].no_connect = True
    # gpio[15].no_connect = True
    # gpio[16].no_connect = True
    # gpio[17].no_connect = True
    gpios[18].line ~ package.IO18
    gpios[19].line ~ package.IO19
    gpios[20].line ~ package.IO18
    gpios[21].line ~ package.IO19

    for gpio in gpios:
        gpio.reference ~ power

    # for gpio in gpios[22:34]:
    #     gpio.no_connect = True
    # gpios[43].no_connect = True
    # gpios[44].no_connect = True

    # UART
    uart = new UART[2]
    # UART0
    uart[0].base_uart.tx ~ gpios[21]
    uart[0].base_uart.rx ~ gpios[20]

    # UART1
    uart[1].base_uart.tx ~ gpios[8]
    uart[1].base_uart.rx ~ gpios[9]

    spi = new SPI[3]
    # spi[0].no_connect = True
    # spi[1].no_connect = True

    spi_cs = new ElectricLogic[3]
    # FSPI high speed pinout (interface 4c)
    spi_cs[2] ~ gpios[10]
    spi[2].mosi ~ gpios[4]
    spi[2].sclk ~ gpios[6]
    spi[2].miso ~ gpios[2]

    # connect up I2C
    i2c = new I2C[1]
    # Any GPIOs can be used for I2C
    # i2c.scl ~ gpios[*]
    # i2c.sda ~ gpios[*]
    i2c[0].scl ~ gpios[0]
    i2c[0].sda ~ gpios[1]

    # connect up JTAG
    jtag = new JTAG
    jtag.tck ~ gpios[6]
    jtag.tms ~ gpios[4]
    jtag.tdi ~ gpios[5]
    jtag.tdo ~ gpios[7]
    jtag.vtref ~ power

    # I2S
    i2s = new I2S[1]
    # Any GPIOs can be used for I2S
    i2s[0].sck ~ gpios[3]
    i2s[0].ws ~ gpios[4]
    i2s[0].sd ~ gpios[5]


    # connect up USB
    usb2 = new USB2_0
    usb2.usb_if.d.n ~ gpios[18]
    usb2.usb_if.d.p ~ gpios[19]
