#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
#pragma experiment("MODULE_TEMPLATING")

import I2C, ElectricPower, Capacitor, Addressor, Resistor
from "parts/Sensirion_SHT31_DIS_B2_5kS/Sensirion_SHT31_DIS_B2_5kS.ato" import Sensirion_SHT31_DIS_B2_5kS_package
from "atopile/esp32/esp32_c3.ato" import ESP32_C3_WROOM

module SHT31_driver:
    """Driver for Sensirion SHT31-DIS-B2.5kS temperature & humidity sensor (I²C).

    Exposes:
      * i2c   – I²C bus interface (7-bit addr 0x44 / 0x45)
      * power – Single-rail supply (2.4 V – 5.5 V)
    """

    # --- Interfaces ---
    i2c = new I2C
    power = new ElectricPower

    # --- Address selection (ADDR pin)
    addressor = new Addressor<address_bits=1>
    addressor.base = 0x44  # ADDR=0 → 0x44, ADDR=1 → 0x45
    assert addressor.address is i2c.address
    assert addressor.base is 0x44

    # --- Part instance ---
    ic = new Sensirion_SHT31_DIS_B2_5kS_package

    # --- Connections ---
    # Power rails
    power.hv ~ ic.VDD
    power.lv ~ ic.VSS
    power.lv ~ ic.EPAD  # Thermal/ground pad

    # I²C lines
    i2c.scl.line ~ ic.SCL
    i2c.sda.line ~ ic.SDA
    i2c.scl.reference ~ power
    i2c.sda.reference ~ power

    # Address pin
    addressor.address_lines[0].line ~ ic.ADDR
    addressor.address_lines[0].reference ~ power

    # Reset pin – pulled high (disabled) by default
    ic.NRESET ~ power.hv

    # Unused R pin tied to ground (per datasheet recommendation)
    ic.R ~ power.lv

    # --- Electrical constraints ---
    assert power.voltage within 2.4V to 5.5V

    # --- Decoupling capacitor ---
    decap = new Capacitor
    decap.capacitance = 100nF +/- 20%
    decap.package = "0402"
    power.hv ~> decap ~> power.lv


module Example:
    """Minimal example wiring the SHT31 sensor with an ESP32 MCU."""

    # MCU & sensor
    esp32 = new ESP32_C3_WROOM
    sensor = new SHT31_driver

    # Shared 3V3 rail
    pwr = new ElectricPower
    pwr.voltage = 3.3V
    pwr ~ esp32.power
    pwr ~ sensor.power

    # I²C connection: use ESP32 bus 0
    esp32.i2c[0] ~ sensor.i2c

    # I²C pull-ups on the bus
    # pullups = new Resistor[2]
    # for pu in pullups:
    #     pu.package = "R0402"
    #     pu.resistance = 4.7kohm +/- 10%
    # esp32.i2c[0].sda.line ~> pullups[0] ~> pwr.vcc
    # esp32.i2c[0].scl.line ~> pullups[1] ~> pwr.vcc

    # Optionally expose spare GPIOs etc. (not connected here)
