#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
#pragma experiment("MODULE_TEMPLATING")

# --- Standard library imports ---
import I2C
import ElectricPower
import ElectricLogic
import DifferentialPair
import Resistor
import Capacitor
import can_bridge_by_name
import Addressor

# --- Part import ---
from "parts/TEXAS_INSTRUMENTS_INA232AIDDFR/TEXAS_INSTRUMENTS_INA232AIDDFR.ato" import TEXAS_INSTRUMENTS_INA232AIDDFR_package

module TI_INA232:
    """
    Texas Instruments INA232 high-side/low-side bidirectional current and power monitor.

    Features:
    - I2C interface with 16 programmable addresses
    - High-side or low-side sensing capability
    - 0V to 48V common-mode input voltage range
    - ±75mV full-scale shunt voltage range
    - 16-bit ADC resolution
    - Programmable alerts and overlimit detection
    - SOT-23-8 package
    """

    # --- Package ---
    package = new TEXAS_INSTRUMENTS_INA232AIDDFR_package

    # --- Supply ---
    power = new ElectricPower
    """
    Device power supply (1.7V to 5.5V)
    """
    power.required = True
    assert power.voltage within 1.7V to 5.5V
    power.hv ~ package.VS
    power.lv ~ package.GND

    # --- I²C bus ---
    i2c = new I2C
    """
    I²C bus interface (7-bit addresses 0x40-0x4F based on A0 pin)
    """
    i2c.required = True
    i2c.scl.line ~ package.SCL
    i2c.sda.line ~ package.SDA

    # I2C pull-up resistors
    i2c_pullups = new Resistor[2]
    for r in i2c_pullups:
        r.resistance = 10kohm +/- 5%
        r.package = "0402"
    i2c.scl.line ~> i2c_pullups[0] ~> power.hv
    i2c.sda.line ~> i2c_pullups[1] ~> power.hv

    # --- Alert pin ---
    alert = new ElectricLogic
    """
    Programmable alert output (open-drain, active low)
    """
    alert.required = False
    alert.line ~ package.ALERT
    alert.reference ~ power

    # Alert pin pull-up resistor (10kohm 0402)
    alert_pullup = new Resistor
    alert_pullup.resistance = 10kohm +/- 5%
    alert_pullup.package = "0402"
    alert.line ~> alert_pullup ~> power.hv

    # --- Shunt differential input ---
    shunt_input = new DifferentialPair
    """
    Differential shunt voltage input (±75mV full scale)
    """
    shunt_input.required = False
    shunt_input.p.line ~ package.INpos
    shunt_input.n.line ~ package.INneg

    # --- User-defined maximum current parameter ---
    max_current: current
    """
    Maximum expected current for shunt resistor sizing
    """
    # Default to 1A to provide initial constraint
    max_current.default = 1A

    # INA232 full-scale shunt voltage range
    shunt_voltage_max_range = 65mV to 75mV

    # --- External shunt resistor (designer selects value & package) ---
    shunt = new Resistor
    shunt.package = "1206"  # adequate power rating for most designs
    shunt_input.p.line ~> shunt ~> shunt_input.n.line

    # Recommended shunt value bounds given desired max current
    # Target resistance: shunt_voltage_max_range / max_current = 70mV / max_current
    assert shunt.resistance within shunt_voltage_max_range / max_current

    # --- High-side bridge so designers can insert the monitor inline ---
    power_in = new ElectricPower
    """
    Input power for current sensing (high-side sensing)
    """
    power_in.required = True

    power_out = new ElectricPower
    """
    Output power for current sensing (high-side sensing)
    """
    power_out.required = True

    # Voltage range for high-side sensing
    assert power_in.voltage within 0V to 48V

    # Common ground ties to device ground
    power_in.lv ~ power.lv
    power_out.lv ~ power.lv

    # Bridge VCC path through shunt
    power_in.hv ~> shunt ~> power_out.hv

    # Mark module as a bridge so it can be inserted inline in power path
    trait can_bridge_by_name<input_name = "power_in", output_name = "power_out">

    # --- I²C address selection (A0 pin) ---
    addressor = new Addressor<address_bits=1, states_per_pin=4>
    addressor.base = 0x40
    assert addressor.address is i2c.address
    # Default to base address (0x40), can be overridden by user
    i2c.address.default = 0x40

    addressor.address_lines[0].line ~ package.A0
    addressor.address_lines[0].reference ~ power
    addressor.state_options[0] ~ power.lv  # GND → offset 0
    addressor.state_options[1] ~ power.hv  # VCC → offset 1
    addressor.state_options[2] ~ i2c.sda.line  # SDA → offset 2
    addressor.state_options[3] ~ i2c.scl.line  # SCL → offset 3

    # --- Decoupling capacitor ---
    decoupling_cap = new Capacitor
    decoupling_cap.capacitance = 100nF +/- 20%
    decoupling_cap.package = "0402"
    power.hv ~> decoupling_cap ~> power.lv
