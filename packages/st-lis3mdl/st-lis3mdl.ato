#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import ElectricPower
import I2C
import SPI
import Capacitor
import Resistor
import Addressor
import ElectricLogic

from "parts/STMicroelectronics_LIS3MDLTR/STMicroelectronics_LIS3MDLTR.ato" import STMicroelectronics_LIS3MDLTR_package

module ST_LIS3MDL:
    """STMicroelectronics LIS3MDL 3-axis magnetometer (I²C/SPI).

    Exposes:
      * i2c        – I²C bus interface (7-bit addr 0x1C / 0x1E)
      * power_core – Core supply (2.16V - 3.6V)
      * power_io   – Digital I/O supply (1.71V - 3.6V)
      * int_pin    – Interrupt pin (optional)
      * drdy_pin   – Data ready pin (optional)
    """

    # --- External interfaces ---
    i2c = new I2C
    """I²C bus interface (7-bit addr 0x1C / 0x1E)"""
    i2c.required = True

    power_core = new ElectricPower
    """Core power supply (2.16V - 3.6V)"""
    power_core.required = True
    assert power_core.voltage within 2.16V to 3.6V

    power_io = new ElectricPower
    """Digital I/O power supply (1.71V - 3.6V)"""
    power_io.required = True
    assert power_io.voltage within 1.71V to 3.6V

    int_pin = new ElectricLogic
    """Interrupt pin (optional)"""
    int_pin.reference ~ power_io

    drdy_pin = new ElectricLogic
    """Data ready pin (optional)"""
    drdy_pin.reference ~ power_io

    # --- Package ---
    package = new STMicroelectronics_LIS3MDLTR_package

    # --- I²C address selection (SA1 pin) ---
    addressor = new Addressor<address_bits=1>
    addressor.address_lines[0].line ~ package.SD0_SA1
    addressor.address_lines[0].reference ~ power_io
    addressor.base = 0x1C
    assert addressor.address is i2c.address
    # Default to base address (0x1C), can be overridden by user
    i2c.address.default = 0x1C

    # --- I²C pull-up resistors ---
    scl_pullup = new Resistor
    scl_pullup.resistance = 10kohm +/- 10%
    scl_pullup.package = "0402"
    i2c.scl.line ~> scl_pullup ~> power_io.vcc

    sda_pullup = new Resistor
    sda_pullup.resistance = 10kohm +/- 10%
    sda_pullup.package = "0402"
    i2c.sda.line ~> sda_pullup ~> power_io.vcc

    # --- Decoupling capacitors ---
    decoupling_caps = new Capacitor[3]
    for cap in decoupling_caps:
        cap.capacitance = 100nF +/- 20%
        cap.package = "0402"

    power_core.vcc ~> decoupling_caps[0] ~> power_core.gnd
    power_io.vcc ~> decoupling_caps[1] ~> power_core.gnd
    package.C1 ~> decoupling_caps[2] ~> power_core.gnd

    # --- Package connections ---
    package.Vdd ~ power_core.vcc
    package.Vdd_IO ~ power_io.vcc
    package.GND ~ power_core.gnd
    package.SCL_SPC ~ i2c.scl.line
    package.SDA_SDI_SDO ~ i2c.sda.line
    package.CS ~ power_io.vcc  # I2C mode (CS high)
    package.INT ~ int_pin.line
    package.DRDY ~ drdy_pin.line
