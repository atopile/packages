import ElectricPower, Capacitor, Resistor, SPI, I2C, USB2_0_IF, JTAG, ElectricLogic

from "atopile/buttons/buttons.ato" import ButtonPullup, ButtonSKRPACE010
from "parts/Espressif_Systems_ESP32_S3_WROOM_1_N16R2/Espressif_Systems_ESP32_S3_WROOM_1_N16R2.ato" import Espressif_Systems_ESP32_S3_WROOM_1_N16R2_package

module ESP32S3:
    """
    This is an esp32-s3 module.
    """
    ic = new Espressif_Systems_ESP32_S3_WROOM_1_N16R2_package
    power = new ElectricPower

    # connect up power
    power.vcc ~ ic.P3V3
    power.gnd ~ ic.GND

    # decoupling caps
    lil_cap = new Capacitor
    big_cap_1 = new Capacitor
    big_cap_2 = new Capacitor

    lil_cap.power ~ power
    big_cap_1.power ~ power
    big_cap_2.power ~ power

    lil_cap.capacitance = 100nF +/- 20%
    big_cap_1.capacitance = 10uF +/- 20%
    big_cap_2.capacitance = 10uF +/- 20%

    lil_cap.package = "C0402"
    big_cap_1.package = "C0805"
    big_cap_2.package = "C0805"

    # reset button
    enable_button = new ButtonPullup
    power ~ enable_button.output.reference
    enable_button.output.line ~ ic.EN
    enable_button.btn -> ButtonSKRPACE010

    # connect up USB
    usb2 = new USB2_0_IF
    usb2.d.n ~ ic.IO19
    usb2.d.p ~ ic.IO20

    # connect up JTAG
    jtag = new JTAG
    jtag.tck ~ ic.IO39
    jtag.tms ~ ic.IO42
    jtag.tdi ~ ic.IO41
    jtag.tdo ~ ic.IO40
    jtag.vtref ~ power


    spi2 = new SPI
    spi2_cs = new ElectricLogic
    # FSPI default pinout
    spi2.sclk ~ ic.IO12
    spi2.mosi ~ ic.IO11
    spi2.miso ~ ic.IO13
    spi2_cs.line ~ ic.IO10
    # spi.gnd ~ power.gnd


    # connect up I2C
    i2c = new I2C
    i2c.scl.line ~ ic.IO6
    i2c.sda.line ~ ic.IO7

    # pass through GPIO
    signal io0 ~ ic.IO0
    signal io1 ~ ic.IO1
    signal io2 ~ ic.IO2
    signal io3 ~ ic.IO3
    signal io4 ~ ic.IO4
    signal io5 ~ ic.IO5
    signal io6 ~ ic.IO6 # Already connected to I2C
    signal io7 ~ ic.IO7 # Already connected to I2C
    signal io8 ~ ic.IO8
    signal io9 ~ ic.IO9
    signal io10 ~ ic.IO10 # Already connected to SPI
    signal io11 ~ ic.IO11 # Already connected to SPI
    signal io12 ~ ic.IO12 # Already connected to SPI
    signal io13 ~ ic.IO13 # Already connected to SPI
    signal io14 ~ ic.IO14
    signal io15 ~ ic.IO15
    signal io16 ~ ic.IO16
    signal io17 ~ ic.IO17
    signal io18 ~ ic.IO18
    signal io19 ~ ic.IO19 # Already connected to USB2
    signal io20 ~ ic.IO20 # Already connected to USB2
    signal io21 ~ ic.IO21
    signal io35 ~ ic.IO35
    signal io36 ~ ic.IO36
    signal io37 ~ ic.IO37
    signal io38 ~ ic.IO38
    signal io39 ~ ic.IO39 # Already connected to JTAG
    signal io40 ~ ic.IO40 # Already connected to JTAG
    signal io41 ~ ic.IO41 # Already connected to JTAG
    signal io42 ~ ic.IO42 # Already connected to JTAG
    signal io45 ~ ic.IO45
    signal io46 ~ ic.IO46
    signal io47 ~ ic.IO47
    signal io48 ~ ic.IO48
