import ElectricPower
import I2C

from "atopile/microchip-24lc32/microchip-24lc32.ato" import Microchip_24LC32

module Usage:
    """Minimal example for the Microchip 24LC32 EEPROM."""

    # EEPROM
    eeprom = new Microchip_24LC32

    # Power supply
    power = new ElectricPower
    assert power.voltage within 3.3V +/- 5%
    power ~ eeprom.power

    # I²C bus (would connect to your MCU)
    i2c = new I2C
    i2c ~ eeprom.i2c
