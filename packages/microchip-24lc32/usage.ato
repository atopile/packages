import ElectricPower
import I2C

from "atopile/microchip-24lc32/microchip-24lc32.ato" import Microchip_24LC32

module Usage:
    """Minimal example for the Microchip 24LC32 EEPROM."""

    # EEPROM instance
    eeprom = new Microchip_24LC32

    # Power rail
    power = new ElectricPower
    power.voltage = 3.3V
    power ~ eeprom.power

    # I²C bus
    i2c = new I2C
    i2c ~ eeprom.i2c
