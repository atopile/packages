#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import Resistor
import Capacitor
import SPI
import ElectricLogic
import ElectricPower

from "atopile/sd-card/sd-card.ato" import SDCardAssemblyWithRemovableMicroSDWithSPI
from "atopile/espressif-esp32-c3/espressif-esp32-c3-mini.ato" import ESP32_C3_MINI_1

module Usage:
    mcu = new ESP32_C3_MINI_1
    sd_card = new SDCardAssemblyWithRemovableMicroSDWithSPI

    # Connect micro SD Card
    sd_card.spi ~ mcu.spi
    sd_card.spi_cs ~ mcu.gpio[17]
    sd_card.power ~ mcu.power
