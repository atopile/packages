"""
Logic interface between SD card and e.g MCU.

https://www.sdcard.org/downloads/pls/
"""

#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import DifferentialPair
import ElectricPower
import ElectricLogic
import has_single_electric_reference_shared

interface SDLogic:
    pass

interface SDLogicSDBus from SDLogic:
    power = new ElectricPower
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic
    data = new ElectricLogic[4]
    clock = new ElectricLogic
    chip_select = new ElectricLogic
    command = new ElectricLogic

    assert power.voltage within 3.3 V +/- 5%
    trait has_single_electric_reference_shared


interface SDLogicUHSII from SDLogic:
    # TODO not 100% checked

    # from SDLogic
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic

    power = new ElectricPower[2]
    rclk = new DifferentialPair
    data = new DifferentialPair[2]

    assert power[0].voltage within 2.7 V to 3.6 V
    assert power[1].voltage within 1.7 V to 1.95 V

    trait has_single_electric_reference_shared<gnd_only=True>
    card_detect.reference ~ power[0]
    write_protect.reference ~ power[0]
    # Ensure clock and data differential pairs share the same reference
    rclk.p.reference ~ power[0]
    rclk.n.reference ~ power[0]
    for pair in data:
        pair.p.reference ~ power[0]
        pair.n.reference ~ power[0]


interface SDLogicSDExpress1Lane from SDLogic:
    # SD Express (PCIe) – 1-lane logical interface

    # Common low-speed signals reused from legacy SD bus
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic

    # Power rails
    # [0] – 3 V3 domain  (VDD1 / VDD1a)
    # [1] – 1 V8 domain  (VDD2)
    # [2] – 1 V2 domain  (VDD3 – optional)
    power = new ElectricPower[3]

    # PCIe-specific control
    perst_n = new ElectricLogic   # PCIe PERST# (active low)
    clkreq_n = new ElectricLogic  # PCIe CLKREQ# (open drain, active low)

    # Reference clock provided by host
    refclk = new DifferentialPair

    # Single-lane TX/RX differential pairs
    pcie_tx = new DifferentialPair  # Host → Card
    pcie_rx = new DifferentialPair  # Card → Host

    # Voltage constraints (spec 8.0-draft ‑ Table 3-18)
    assert power[0].voltage within 2.7 V to 3.6 V
    assert power[1].voltage within 1.7 V to 1.95 V
    # VDD3 is optional – keep loose tolerance but document recommended range
    assert power[2].voltage within 1.14 V to 1.30 V

    trait has_single_electric_reference_shared<gnd_only=True>

    # Tie all single-ended signals to the main 3 V3 reference
    for sig in [card_detect, write_protect, perst_n, clkreq_n]:
        sig.reference ~ power[0]

    # Differential pairs share the same reference (common return path)
    refclk.p.reference ~ power[0]; refclk.n.reference ~ power[0]
    pcie_tx.p.reference ~ power[0]; pcie_tx.n.reference ~ power[0]
    pcie_rx.p.reference ~ power[0]; pcie_rx.n.reference ~ power[0]


interface SDLogicSDExpress2Lane from SDLogic:
    # SD Express (PCIe) – 2-lane logical interface

    card_detect = new ElectricLogic
    write_protect = new ElectricLogic

    # Power rails 3 V3, 1 V8, 1 V2 (optional)
    power = new ElectricPower[3]

    perst_n = new ElectricLogic
    clkreq_n = new ElectricLogic
    refclk = new DifferentialPair

    # Two-lane PCIe differential pairs
    pcie_tx = new DifferentialPair[2]  # Host → Card lanes 0/1
    pcie_rx = new DifferentialPair[2]  # Card → Host lanes 0/1

    # Voltage constraints
    assert power[0].voltage within 2.7 V to 3.6 V
    assert power[1].voltage within 1.7 V to 1.95 V
    assert power[2].voltage within 1.14 V to 1.30 V

    trait has_single_electric_reference_shared<gnd_only=True>

    for sig in [card_detect, write_protect, perst_n, clkreq_n]:
        sig.reference ~ power[0]

    refclk.p.reference ~ power[0]; refclk.n.reference ~ power[0]

    for pair in pcie_tx:
        pair.p.reference ~ power[0]
        pair.n.reference ~ power[0]
    for pair in pcie_rx:
        pair.p.reference ~ power[0]
        pair.n.reference ~ power[0]
