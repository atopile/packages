#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import SPI
import Electrical
import ElectricPower
import ElectricSignal
import ElectricLogic
import Resistor
import Capacitor
import has_single_electric_reference_shared

from "atopile/sd-card/slot-pins.ato" import SDSlotPinsSS
from "atopile/sd-card/logic.ato" import SDLogicSDBus

from "parts/Korean_Hroparts_Elec_TF_01A/Korean_Hroparts_Elec_TF_01A.ato" import Korean_Hroparts_Elec_TF_01A_model

module SDSlotDriver:
    pass


module SDSlotDriverSS from SDSlotDriver:
    """
    SD Card driver module, provides common implementation shared by SD cards.
    """
    sd = new SDLogicSDBus
    slot_pins = new SDSlotPinsSS

    # footprint
    sd.power.hv ~ slot_pins.sdcard.VDD
    sd.power.lv ~ slot_pins.sdcard.VSS1
    sd.power.lv ~ slot_pins.sdcard.VSS2
    sd.card_detect.line ~ slot_pins.sdcard.CD
    sd.write_protect.line ~ slot_pins.sdcard.WP
    sd.data[0].line ~ slot_pins.sdcard.DAT0
    sd.data[1].line ~ slot_pins.sdcard.DAT1
    sd.data[2].line ~ slot_pins.sdcard.DAT2
    sd.data[3].line ~ slot_pins.sdcard.CD_DAT3
    sd.clock.line ~ slot_pins.sdcard.CLK
    sd.command.line ~ slot_pins.sdcard.CMD
    sd.chip_select.line ~ slot_pins.sdcard.CD_DAT3


    # driver
    bypass_cap = new Capacitor
    bypass_cap.capacitance = 100 nF +/- 20%
    bypass_cap.package = "C0402"
    bypass_cap.power ~ sd.power
