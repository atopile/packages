"""
Transport protocol SDCard.
"""

#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import SPI
import Electrical
import ElectricPower
import ElectricSignal
import ElectricLogic
import Resistor
import Capacitor
import has_single_electric_reference_shared

from "atopile/sd-card/logic.ato" import SDLogicSDBus

module SDTransport:
    pass

module SDTransportSS from SDTransport:
    pass

module SDTransportSPI from SDTransportSS:
    spi = new SPI
    spi_cs = new ElectricLogic
    sd = new SDLogicSDBus

    spi.required = True
    spi_cs.required = True
    sd.required = True

    # driver
    pullups = new Resistor[3]
    for pullup in pullups:
        pullup.resistance = 10 kohm +/- 5%
        pullup.package = "R0402"
    spi.miso.line ~> pullups[0] ~> spi.reference_shim.hv
    spi.mosi.line ~> pullups[1] ~> spi.reference_shim.hv
    spi.sclk.line ~> pullups[2] ~> spi.reference_shim.hv

    # connect spi
    spi.miso ~> sd.data[0]
    spi.mosi ~> sd.data[1]
    spi.sclk ~> sd.clock
    spi_cs ~> sd.chip_select

    # TODO bug
    #trait has_single_electric_reference_shared
    #spi.reference_shim ~ sd.reference_shim
    spi.reference_shim ~ sd.power


module SDTransportSDBus from SDTransportSS:
    pass

module SDTransportUHSII from SDTransport:
    pass

module SDTransportPCIe from SDTransport:
    pass
