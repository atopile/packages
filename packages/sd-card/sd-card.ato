#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import SPI
import Electrical
import ElectricPower
import ElectricSignal
import ElectricLogic
import Resistor
import Capacitor
import has_part_removed
import has_single_electric_reference

from "atopile/sd-card/slot-driver.ato" import SDSlotDriverSS
from "atopile/sd-card/data-logic.ato" import SDTransportSPI
from "atopile/sd-card/logic.ato" import SDLogicSDBus
from "atopile/sd-card/slots.ato" import SDSlotMicroStandardSpeed
from "atopile/sd-card/card.ato" import SDCardMicroStandardSpeed
from "atopile/sd-card/card-pins.ato" import SDCardPinsSS

from "parts/Korean_Hroparts_Elec_TF_01A/Korean_Hroparts_Elec_TF_01A.ato" import Korean_Hroparts_Elec_TF_01A_model

module SDLogicSDBusOverPins:
    pins = new SDCardPinsSS
    logic = new SDLogicSDBus

    logic.power.hv ~ pins.VDD
    logic.power.lv ~ pins.VSS1
    logic.power.lv ~ pins.VSS2
    logic.card_detect.line ~ pins.CD
    logic.write_protect.line ~ pins.WP
    logic.data[0].line ~ pins.DAT0
    logic.data[1].line ~ pins.DAT1
    logic.data[2].line ~ pins.DAT2
    logic.data[3].line ~ pins.CD_DAT3
    logic.clock.line ~ pins.CLK
    logic.command.line ~ pins.CMD
    logic.chip_select.line ~ pins.CD_DAT3

    # trait has_single_electric_reference
    trait has_part_removed

module SDCardAssemblyWithRemovableMicroSDStandardSpeed:
    """
    This module contains a MicroSD card receptacle with a removable MicroSD
    card running via standard speed.
    """
    # Standard Speed uSD slot
    slot = new SDSlotMicroStandardSpeed
    logic = new SDLogicSDBusOverPins

    logic.pins ~ slot.slot_pins.sdcard

    # interface
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic
    power = new ElectricPower

    # external
    power ~ logic.logic.power
    card_detect ~ logic.logic.card_detect
    write_protect ~ logic.logic.write_protect

    # driver
    slot_driver = new SDSlotDriverSS
    slot.slot_pins ~ slot_driver.slot_pins

    # default
    slot -> Korean_Hroparts_Elec_TF_01A_model

module SDCardAssemblyWithRemovableMicroSDWithSPI:
    """
    This module contains a MicroSD card receptacle with a removable MicroSD
    card with SPI interface.
    """

    # Standard speed assembly & SPI
    ss_assembly = new SDCardAssemblyWithRemovableMicroSDStandardSpeed
    data_logic = new SDTransportSPI

    ss_assembly.logic.logic ~ data_logic.sd

    # interface
    spi = new SPI
    spi_cs = new ElectricLogic

    spi ~ data_logic.spi
    spi_cs ~ data_logic.spi_cs

    # TODO use export
    card_detect = new ElectricLogic
    card_detect ~ ss_assembly.logic.logic.card_detect
    write_protect = new ElectricLogic
    write_protect ~ ss_assembly.logic.logic.write_protect
    power = new ElectricPower
    power ~ ss_assembly.logic.logic.power

    trait has_single_electric_reference

module SDCardAssemblyWithRemovableMicroSDWithSPIWithCardInSlot:
    """
    This module contains a MicroSD card receptacle with a removable MicroSD
    card with SPI interface inserted in the slot.
    """

    # Card
    card = new SDCardMicroStandardSpeed
    spi_assembly = new SDCardAssemblyWithRemovableMicroSDWithSPI

    card.pins ~ spi_assembly.ss_assembly.slot.slot_pins.sdcard
    card.mech_interface ~ spi_assembly.ss_assembly.slot.mech_interface

    # interface
    # TODO use export
    spi = new SPI
    spi_cs = new ElectricLogic
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic
    power = new ElectricPower
    spi ~ spi_assembly.spi
    spi_cs ~ spi_assembly.spi_cs
    card_detect ~ spi_assembly.card_detect
    write_protect ~ spi_assembly.write_protect
    power ~ spi_assembly.power
