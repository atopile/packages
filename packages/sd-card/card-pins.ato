"""
Pin interfaces between SD card and SD receptacle.

https://www.sdcard.org/downloads/pls/
"""

#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import Electrical


interface SDCardPins:
    pass

# SD Card interfaces
interface SDCardPinsSS from SDCardPins:
    """
    | Pin # | SD Mode Name | Type¹  | Description                    | SPI Mode Name | Type¹ | Description            |
    |-------|--------------|--------|--------------------------------|---------------|-------|------------------------|
    | 1     | CD/DAT3²     | I/O/PP³| Card Detect/Data Line [Bit 3]  | CS            | I³    | Chip Select (neg true) |
    | 2     | CMD          | I/O/PP | Command/Response               | DI            | I     | Data In                |
    | 3     | VSS1         | S      | Supply voltage ground          | VSS           | S     | Supply voltage ground  |
    | 4     | VDD          | S      | Supply voltage                 | VDD           | S     | Supply voltage         |
    | 5     | CLK          | I      | Clock                          | SCLK          | I     | Clock                  |
    | 6     | VSS2         | S      | Supply voltage ground          | VSS2          | S     | Supply voltage ground  |
    | 7     | DAT0         | I/O/PP | Data Line [Bit 0]              | DO            | O/PP  | Data Out               |
    | 8     | DAT1⁴        | I/O/PP | Data Line [Bit 1]              | RSV           |       |                        |
    | 9     | DAT2⁵        | I/O/PP | Data Line [Bit 2]              | RSV           |       |                        |
    """

    signal CD_DAT3
    signal CMD
    signal VSS1
    signal VDD
    signal CLK
    signal VSS2
    signal DAT0
    signal DAT1
    signal DAT2
    signal WP # Write protect
    signal CD # Card detect

    pins = new Electrical[9]
    pins[0] ~ CD_DAT3
    pins[1] ~ CMD
    pins[2] ~ VSS1
    pins[3] ~ VDD
    pins[4] ~ CLK
    pins[5] ~ VSS2
    pins[6] ~ DAT0
    pins[7] ~ DAT1
    pins[8] ~ DAT2

interface SDCardPinsUHSII from SDCardPins:
    """
    | Pin # | Name  | Type                                                     | Description       |
    |-------|-------|----------------------------------------------------------|-------------------|
    | 4     | VDD1  | Supply voltage                                           | 2.7V to 3.6V      |
    | 7     | RCLK+ | Differential Signaling: Input                            | Clock Input       |
    | 8     | RCLK- | Differential Signaling: Input                            | Clock Input       |
    | 10    | VSS3  | Ground                                                   |                   |
    | 11    | D0+   | Differential Signaling: Input (FD) / Bidirectional (HD)  | Input in default  |
    | 12    | D0-   | Differential Signaling: Input (FD) / Bidirectional (HD)  | Input in default  |
    | 13    | VSS4  | Ground                                                   |                   |
    | 14    | VDD2  | Supply Voltage 2                                         | 1.70V to 1.95V    |
    | 15    | D1-   | Differential Signaling: Output (FD) / Bidirectional (HD) | Output in default |
    | 16    | D1+   | Differential Signaling: Output (FD) / Bidirectional (HD) | Output in default |
    | 17    | VSS5  | Ground
    """
    pins = new Electrical[17]
    sdbus = new SDCardPins

    pins[0] ~ sdbus.pins[0]
    pins[1] ~ sdbus.pins[1]
    pins[2] ~ sdbus.pins[2]
    pins[3] ~ sdbus.pins[3]
    pins[4] ~ sdbus.pins[4]
    pins[5] ~ sdbus.pins[5]
    pins[6] ~ sdbus.pins[6]
    pins[7] ~ sdbus.pins[7]
    pins[8] ~ sdbus.pins[8]

    signal VDD1
    signal RCLKp
    signal RCLKn
    signal VSS3
    signal D0p
    signal D0n
    signal VSS4
    signal VDD2
    signal D1p
    signal D1n
    signal VSS5

    VDD1 ~ pins[3]
    RCLKp ~ pins[6]
    RCLKn ~ pins[7]
    VSS3 ~ pins[9]
    D0p ~ pins[10]
    D0n ~ pins[11]
    VSS4 ~ pins[12]
    VDD2 ~ pins[13]
    D1p ~ pins[14]
    D1n ~ pins[15]
    VSS5 ~ pins[16]

interface SDCardPinsSDExpress1Lane from SDCardPins:
    """
    | Pin # | Name    | Type                          | Description                                                         |
    |-------|---------|-------------------------------|---------------------------------------------------------------------|
    | 1     | PERST#  | Input signal (active low)     | PE-Reset is a functional reset to the card as defined by the PCIe Mini CEM specification. |
    | 4     | VDD1    | Supply voltage                | 2.7V to 3.6V                                                        |
    | 7     | REFCLK+ | Differential Signaling: Input | Clock Input                                                         |
    | 8     | REFCLK- | Differential Signaling: Input | Clock Input                                                         |
    | 9     | CLKREQ# | I/O (active low, open drain)  | Reference clock request signal. Also used by L1 PM substates        |
    | 10    | VSS3    | Ground                        |                                                                     |
    | 11    | PCIe TX+| Differential Signaling        | Card Input                                                          |
    | 12    | PCIe TX-| Differential Signaling        | Card Input                                                          |
    | 13    | VSS4    | Ground                        |                                                                     |
    | 14    | VDD2    | Supply Voltage 2              | 1.70V to 1.95V                                                      |
    | 15    | PCIe RX-| Differential Signaling        | Card Output                                                         |
    | 16    | PCIe RX+| Differential Signaling        | Card Output                                                         |
    | 17    | VSS5    | Ground                        |                                                                     |
    | 18(1) | VDD3    | Supply Voltage 3              | 1.14V to 1.30V (optional)                                           |
    | 19(2) | VDD1a   | Supply Voltage 4              | 2.7V to 3.6V                                                        |

    (1) Pin #18 can be implemented when card supports VDD3. VDD3 is reserved for Standard Size SD Express.
    (2) Pin #19 is available only when SD Express card is compliant to Part 1 Physical
        Layer Specification Version 8.00 with PCIe Gen4 (Pin #19 does not exist for SD
        Express Card compliant to Part 1 Physical Layer Specification Version 7.XX with PCIe Gen3)
    """
    sdbus = new SDCardPins
    pins = new Electrical[19]

    # connect the sdbus pins to the express pins
    pins[0] ~ sdbus.pins[0]
    pins[1] ~ sdbus.pins[1]
    pins[2] ~ sdbus.pins[2]
    pins[3] ~ sdbus.pins[3]
    pins[4] ~ sdbus.pins[4]
    pins[5] ~ sdbus.pins[5]
    pins[6] ~ sdbus.pins[6]
    pins[7] ~ sdbus.pins[7]
    pins[8] ~ sdbus.pins[8]

    signal PERSTn
    signal VDD1
    signal REFCLKp
    signal REFCLKn
    signal CLKREQn
    signal VSS3
    signal PCIeTXp
    signal PCIeTXn
    signal VSS4
    signal VDD2
    signal PCIeRXp
    signal PCIeRXn
    signal VSS5
    signal VDD3
    signal VDD1a

    PERSTn ~ pins[0]
    VDD1 ~ pins[3]
    REFCLKp ~ pins[6]
    REFCLKn ~ pins[7]
    CLKREQn ~ pins[8]
    VSS3 ~ pins[9]
    PCIeTXp ~ pins[10]
    PCIeTXn ~ pins[11]
    VSS4 ~ pins[12]
    VDD2 ~ pins[13]
    PCIeRXp ~ pins[14]
    PCIeRXn ~ pins[15]
    VSS5 ~ pins[16]
    VDD3 ~ pins[17]
    VDD1a ~ pins[18]

interface SDCardPinsSDExpress2Lane from SDCardPins:
    """
    | Pin # | Name      | Type                          | Description                                                         |
    |-------|-----------|-------------------------------|---------------------------------------------------------------------|
    | 1     | PERST#    | Input signal (active low)     | PE-Reset is a functional reset to the card as defined by the PCIe Mini CEM specification. |
    | 4     | VDD1      | Supply voltage                | 2.7V to 3.6V                                                        |
    | 7     | REFCLK+   | Differential Signaling: Input | Clock Input                                                         |
    | 8     | REFCLK-   | Differential Signaling: Input | Clock Input                                                         |
    | 9     | CLKREQ#   | I/O (active low, open drain)  | Reference clock request signal. Also used by L1 PM substates        |
    | 10    | VSS3      | Ground                        |                                                                     |
    | 11    | PCIe TX0+ | Differential Signaling        | Card Input; lane 0                                                  |
    | 12    | PCIe TX0- | Differential Signaling        | Card Input; lane 0                                                  |
    | 13    | VSS4      | Ground                        |                                                                     |
    | 14    | VDD2      | Supply Voltage 2              | 1.70V to 1.95V                                                      |
    | 15    | PCIe RX0- | Differential Signaling        | Card Output; lane 0                                                 |
    | 16    | PCIe RX0+ | Differential Signaling        | Card Output; lane 0                                                 |
    | 17    | VSS5      | Ground                        |                                                                     |
    | 18(1) | VDD3      | Supply Voltage 3              | 1.14V to 1.30V (optional)                                           |
    | 19(2) | VDD1a     | Supply Voltage 4              | 2.7V to 3.6V (mandatory)                                            |
    | 20    | VSS6      | Ground                        |                                                                     |
    | 21    | PCIe TX1+ | Differential Signaling        | Card Input; lane 1                                                  |
    | 22    | PCIe TX1- | Differential Signaling        | Card Input; lane 1                                                  |
    | 23    | VSS7      | Ground                        |                                                                     |
    | 24    | VDD2a     | Supply Voltage 5              | 1.70V to 1.95V                                                      |
    | 25    | PCIe RX1- | Differential Signaling        | Card Output; lane 1                                                 |
    | 26    | PCIe RX1+ | Differential Signaling        | Card Output; lane 1                                                 |
    | 27    | VSS8      | Ground                        |                                                                     |

    (1) Pin #18 can be implemented when card supports VDD3. VDD3 is reserved for Standard Size SD Express.
    (2) Pin #19 and #24 are mandatory in 2-Lane SD Express card.
    """
    sdbus = new SDCardPins
    pins = new Electrical[27]

    # connect the sdbus pins to the express pins
    pins[0] ~ sdbus.pins[0]
    pins[1] ~ sdbus.pins[1]
    pins[2] ~ sdbus.pins[2]
    pins[3] ~ sdbus.pins[3]
    pins[4] ~ sdbus.pins[4]
    pins[5] ~ sdbus.pins[5]
    pins[6] ~ sdbus.pins[6]
    pins[7] ~ sdbus.pins[7]
    pins[8] ~ sdbus.pins[8]

    signal PERSTn
    signal VDD1
    signal REFCLKp
    signal REFCLKn
    signal CLKREQn
    signal VSS3
    signal PCIeTX0p
    signal PCIeTX0n
    signal VSS4
    signal VDD2
    signal PCIeRX0p
    signal PCIeRX0n
    signal VSS5
    signal VDD3
    signal VDD1a
    signal VSS6
    signal PCIeTX1p
    signal PCIeTX1n
    signal VSS7
    signal VDD2a
    signal PCIeRX1p
    signal PCIeRX1n
    signal VSS8

    PERSTn ~ pins[0]
    VDD1 ~ pins[3]
    REFCLKp ~ pins[6]
    REFCLKn ~ pins[7]
    CLKREQn ~ pins[8]
    VSS3 ~ pins[9]
    PCIeTX0p ~ pins[10]
    PCIeTX0n ~ pins[11]
    VSS4 ~ pins[12]
    VDD2 ~ pins[13]
    PCIeRX0p ~ pins[14]
    PCIeRX0n ~ pins[15]
    VSS5 ~ pins[16]
    VDD3 ~ pins[17]
    VDD1a ~ pins[18]
    VSS6 ~ pins[19]
    PCIeTX1p ~ pins[20]
    PCIeTX1n ~ pins[21]
    VSS7 ~ pins[22]
    VDD2a ~ pins[23]
    PCIeRX1p ~ pins[24]
    PCIeRX1n ~ pins[25]
    VSS8 ~ pins[26]
