"""
SD Card slot pinout on pcb side.
"""

from "atopile/sd-card/card-pins.ato" import SDCardPinsSS, SDCardPinsUHSII, SDCardPinsSDExpress1Lane, SDCardPinsSDExpress2Lane

interface SDSlotPins:
    pass

interface SDSlotPinsSS from SDSlotPins:
    """
    SD slots just connect through to the card pins.
    """
    sdcard = new SDCardPinsSS

interface SDSlotPinsUHSII from SDSlotPins:
    sdcard = new SDCardPinsUHSII

interface SDSlotPinsSDExpress1Lane from SDSlotPins:
    sdcard = new SDCardPinsSDExpress1Lane

interface SDSlotPinsSDExpress2Lane from SDSlotPins:
    sdcard = new SDCardPinsSDExpress2Lane
