#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import SPI
import ElectricPower
import ElectricSignal
import ElectricLogic
import Resistor
import Capacitor
import can_bridge_by_name
import has_single_electric_reference_shared

from "parts/Korean_Hroparts_Elec_TF_01A/Korean_Hroparts_Elec_TF_01A.ato" import Korean_Hroparts_Elec_TF_01A_model

module SDReceptacle:
    sdbus = new SDBus

# SD Card interfaces
interface SDBus:
    signal CD_DAT3
    signal CMD
    signal VSS1
    signal VDD
    signal CLK
    signal VSS2
    signal DAT0
    signal DAT1
    signal DAT2
    signal WP # Write protect
    signal CD # Card detect

interface SDLogical:
    power = new ElectricPower
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic
    data = new ElectricLogic[4]
    clock = new ElectricLogic
    chip_select = new ElectricLogic
    command = new ElectricLogic

    assert power.voltage within 3.3 V +/- 5%
    trait has_single_electric_reference_shared

module SPIDriver:
    spi = new SPI
    spi_cs = new ElectricLogic
    sd = new SDLogical

    spi.required = True
    spi_cs.required = True
    sd.required = True

    # driver
    pullups = new Resistor[3]
    for pullup in pullups:
        pullup.resistance = 10 kohm +/- 5%
        pullup.package = "R0402"
    spi.miso.line ~> pullups[0] ~> sd.power.hv
    spi.mosi.line ~> pullups[1] ~> sd.power.hv
    spi.sclk.line ~> pullups[2] ~> sd.power.hv

    # connect spi
    spi.miso ~> sd.data[0]
    spi.mosi ~> sd.data[1]
    spi.sclk ~> sd.clock
    spi_cs ~> sd.chip_select

module ReceptacleDriver:
    """
    SD Card driver module, provides common implementation shared by SD cards.
    """
    sd = new SDLogical
    receptacle = new SDReceptacle

    # footprint
    sd.power.hv ~ receptacle.sdbus.VDD
    sd.power.lv ~ receptacle.sdbus.VSS1
    sd.power.lv ~ receptacle.sdbus.VSS2
    sd.card_detect.line ~ receptacle.sdbus.CD
    sd.write_protect.line ~ receptacle.sdbus.WP
    sd.data[0].line ~ receptacle.sdbus.DAT0
    sd.data[1].line ~ receptacle.sdbus.DAT1
    sd.data[2].line ~ receptacle.sdbus.DAT2
    sd.data[3].line ~ receptacle.sdbus.CD_DAT3
    sd.clock.line ~ receptacle.sdbus.CLK
    sd.command.line ~ receptacle.sdbus.CMD
    sd.chip_select.line ~ receptacle.sdbus.CD_DAT3


    # driver
    bypass_cap = new Capacitor
    bypass_cap.capacitance = 100 nF +/- 20%
    bypass_cap.package = "C0402"
    bypass_cap.power ~ sd.power

    # default
    receptacle -> Korean_Hroparts_Elec_TF_01A_model


module MicroSDCardAssemblyWithRemovableSPI:
    """
    This module contains a MicroSD card receptacle with a (virtual) removable MicroSD
    card with SPI interface.
    """
    # interface
    spi = new SPI
    spi_cs = new ElectricLogic
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic
    power = new ElectricPower

    #usdcard
    receptacle = new ReceptacleDriver # replace this in your application with a uSD card receptacle package
    sd_logical = new SDLogical
    spi_driver = new SPIDriver

    # external
    card_detect ~ sd_logical.card_detect
    power ~ sd_logical.power
    write_protect ~ sd_logical.write_protect
    spi_driver.spi_cs ~ spi_cs
    spi_driver.spi ~ spi

    # driver
    receptacle.sd ~ sd_logical
    spi_driver.sd ~ sd_logical

