import ElectricPower
import USB2_0
import I2C

from "atopile/st-stusb4500/st-stusb4500.ato" import STUSB4500
from "atopile/usb-connectors/usb-connectors.ato" import USB2_0TypeCHorizontalConnector

module Usage:
    stusb4500 = new STUSB4500
    usb_connector = new USB2_0TypeCHorizontalConnector

    power = new ElectricPower
    power ~ stusb4500.power_vsink
    power ~ usb_connector.usb.usb_if.buspower

    usb_connector.usb ~ stusb4500.usb2

    i2c = new I2C
    stusb4500.i2c ~ i2c
