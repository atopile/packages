#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")

import ElectricPower
import I2C
import ElectricLogic
import Capacitor
import Resistor
import Addressor
from "parts/Maxim_Integrated_DS2482S_800/Maxim_Integrated_DS2482S_800.ato" import Maxim_Integrated_DS2482S_800_package

module ADI_DS2482S_800:
    """
    Analog Devices DS2482S-800 8-Channel I2C to 1-Wire Bus Adapter

    This module provides an interface for the DS2482S-800 chip, which bridges
    I2C communication to up to 8 1-Wire channels. Commonly used for connecting
    multiple DS18B20 temperature sensors or other 1-Wire devices.
    """

    # --- Package ---
    package = new Maxim_Integrated_DS2482S_800_package

    # --- External interfaces ---
    i2c = new I2C
    """
    I2C bus interface with configurable address (0x18-0x1F)
    """
    i2c.required = True

    power = new ElectricPower
    """
    Power supply interface (2.9V to 5.5V operating range)
    """
    power.required = True
    assert power.voltage within 2.9V to 5.5V

    # 8 1-Wire channels
    onewire_channels = new ElectricLogic[8]
    """
    Eight 1-Wire channel outputs for connecting DS18B20 sensors or other 1-Wire devices
    At least one channel should be used for the device to be useful
    """
    for channel in onewire_channels:
        channel.required = False

    # --- Internal power rail ---
    power.hv ~ package.VCC
    power.lv ~ package.GND

    # --- I2C interface ---
    i2c.scl.line ~ package.SCL
    i2c.sda.line ~ package.SDA

    # I2C address configuration (3 address pins: AD0, AD1, AD2)
    addressor = new Addressor<address_bits = 3>
    addressor.base = 0x18
    assert addressor.address is i2c.address
    # Default to base address (0x18), can be overridden by user
    i2c.address.default = 0x18

    # Connect address pins
    addressor.address_lines[0].line ~ package.AD0
    addressor.address_lines[1].line ~ package.AD1
    addressor.address_lines[2].line ~ package.AD2

    # Connect address references to power
    for address_line in addressor.address_lines:
        address_line.reference ~ power

    # --- 1-Wire channel connections ---
    onewire_channels[0].line ~ package.IO0
    onewire_channels[1].line ~ package.IO1
    onewire_channels[2].line ~ package.IO2
    onewire_channels[3].line ~ package.IO3
    onewire_channels[4].line ~ package.IO4
    onewire_channels[5].line ~ package.IO5
    onewire_channels[6].line ~ package.IO6
    onewire_channels[7].line ~ package.IO7

    # Connect 1-Wire channel references to power
    for channel in onewire_channels:
        channel.reference ~ power

    # --- Decoupling capacitors ---
    power_caps = new Capacitor[2]
    for capacitor in power_caps:
        capacitor.capacitance = 100nF +/- 20%
        capacitor.package = "0402"
        power.hv ~> capacitor ~> power.lv

    # --- I2C pull-up resistors ---
    scl_pullup = new Resistor
    scl_pullup.resistance = 10kohm +/- 5%
    scl_pullup.package = "0402"
    power.hv ~> scl_pullup ~> i2c.scl.line

    sda_pullup = new Resistor
    sda_pullup.resistance = 10kohm +/- 5%
    sda_pullup.package = "0402"
    power.hv ~> sda_pullup ~> i2c.sda.line
