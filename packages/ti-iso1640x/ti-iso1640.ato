#pragma experiment("BRIDGE_CONNECT")

import ElectricPower
import I2C
import Electrical

from "components/i2c_isolator.py" import I2CIsolator


from "parts/Texas_Instruments_ISO1640QDWRQ1/Texas_Instruments_ISO1640QDWRQ1.ato" import Texas_Instruments_ISO1640QDWRQ1_package
from "parts/TEXAS_INSTRUMENTS_ISO1640BDR/TEXAS_INSTRUMENTS_ISO1640BDR.ato" import TEXAS_INSTRUMENTS_ISO1640BDR_package


module Texas_Instruments_ISO1640Base:
    signal GND1
    signal GND2
    signal SCL1
    signal SCL2
    signal SDA1
    signal SDA2
    signal VCC1
    signal VCC2

module Texas_Instruments_ISO1640_driver from I2CIsolator:
    """
    Texas Instruments ISO1640 I2C isolator
    """

    # package = new Texas_Instruments_ISO1640QDWRQ1_package
    package = new Texas_Instruments_ISO1640Base

    # Connect power rails to package
    power_rails[0].vcc ~ package.VCC1
    power_rails[0].gnd ~ package.GND1
    power_rails[1].vcc ~ package.VCC2
    power_rails[1].gnd ~ package.GND2

    # Connect I2C lines to package
    i2cs[0].scl.line ~ package.SCL1
    i2cs[0].sda.line ~ package.SDA1
    i2cs[1].scl.line ~ package.SCL2
    i2cs[1].sda.line ~ package.SDA2


module TEXAS_INSTRUMENTS_ISO1640BDR_driver from Texas_Instruments_ISO1640_driver:
    package -> TEXAS_INSTRUMENTS_ISO1640BDR_package

module TEXAS_INSTRUMENTS_ISO1640QDWRQ1_driver from Texas_Instruments_ISO1640_driver:
    package -> Texas_Instruments_ISO1640QDWRQ1_package

module Micro:
    i2c = new I2C
    power = new ElectricPower

module Sensor:
    i2c = new I2C
    power = new ElectricPower

module Test:
    """
    Connect a microcontroller to a sensor via an I2C isolator
    """

    # Components
    micro = new Micro
    sensor = new Sensor
    isolator1 = new TEXAS_INSTRUMENTS_ISO1640BDR_driver # 400V
    # isolator1 = new TEXAS_INSTRUMENTS_ISO1640QDWRQ1_driver # 1500V

    # Power Rails
    power = new ElectricPower
    power_iso = new ElectricPower

    # Connections - isolator is 'bridgable'
    micro.i2c ~> isolator1 ~> sensor.i2c

    # Power
    power ~ micro.power
    power ~ isolator1.power_rails[0]

    # Isolated Power
    power_iso ~ sensor.power
    power_iso ~ isolator1.power_rails[1]
