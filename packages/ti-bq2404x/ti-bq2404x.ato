#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
#pragma experiment("TRAITS")
#pragma experiment("MODULE_TEMPLATING")

import Capacitor
import Resistor
import ElectricPower
import ElectricLogic
import ElectricSignal
import can_bridge_by_name
import has_single_electric_reference

from "parts/TI_BQ24045DSQR/TI_BQ24045DSQR.ato" import TI_BQ24045DSQR_package
from "parts/Texas_Instruments_BQ24040DSQR/Texas_Instruments_BQ24040DSQR.ato" import Texas_Instruments_BQ24040DSQR_package

module BQ24045DSQR from BQ2404XDSQR:
    """
    BQ24045DSQR is a 4.35V version of the BQ2404XDSQR
    """
    package -> TI_BQ24045DSQR_package

module BQ24040DSQR from BQ2404XDSQR:
    """
    BQ24040DSQR is a 4.2V version of the BQ2404XDSQR
    """
    # package -> Texas_Instruments_BQ24040DSQR_package
    pass

module BQ2404XDSQR:
    """
    BQ2404XDSQR 1A 1S Battery Charger
    """
    package = new Texas_Instruments_BQ24040DSQR_package

    # Parameters
    charge_current: current

    # Input power
    power_in = new ElectricPower
    assert power_in.voltage within 4.45V to 6.45V
    power_in.required = True
    power_in.hv ~ package.IN
    power_in.lv ~ package.VSS
    power_in.lv ~ package.EP

    trait has_single_electric_reference
    has_single_electric_reference.reference ~ power_in

    # Output power
    power_batt = new ElectricPower
    power_batt.required = True
    power_batt.hv ~ package.OUT
    power_batt.lv ~ package.VSS

    # Make bridgable - eg power_in ~> charger ~> battery.power
    trait can_bridge_by_name<input_name = "power_in", output_name = "power_batt">

    # Power good - active low
    power_good = new ElectricLogic
    power_good.line ~ package.nPG
    power_good.reference ~ power_in
    power_good.required = False

    # Charge status - active low
    charge_status = new ElectricLogic
    charge_status.line ~ package.nCHG
    charge_status.reference ~ power_in
    charge_status.required = False

    # Temperature connection
    temperature_sense = new ElectricSignal
    temperature_sense.line ~ package.TS
    temperature_sense.reference ~ power_batt
    temperature_sense.required = True

    # Input Capacitor
    input_cap = new Capacitor
    input_cap.package = "0402"
    input_cap.capacitance = 1uF +/- 20%
    power_in.hv ~> input_cap ~> power_in.lv

    # Output Capacitor
    output_cap = new Capacitor
    output_cap.package = "0402"
    output_cap.capacitance = 1uF +/- 20%
    power_batt.hv ~> output_cap ~> power_batt.lv

    # ISet resistor - 540ohm = 1A to 10.8kohm = 100mA (RISET = 540 / IOUT)
    iset_resistor = new Resistor
    package.ISET ~> iset_resistor ~> package.VSS
    iset_resistor.package = "0402"

    # Set default charge current max constraint
    assert charge_current <= 1000mA

    assert iset_resistor.resistance within 540V / charge_current
    assert iset_resistor.resistance within 540ohm to 10.8kohm

    # PRETERM pin (pin 4) left floating for default behavior:
    # 10% termination current, 20% precharge current
    # To customize, add external resistor (1k-10k) from PRETERM to VSS

    # ISET2 - High: input current 500mA max, Low: ISET current, FLOAT: input current 100mA max
    # TODO: should be configured based on:
    # 1. charge_current if charge_current < power_in.max_current
    # 2. elif: power_in.max_current if power_in.max_current not in [100mA, 500mA]
    # 3. else: 100mA or 500mA
    package.ISET2 ~ power_in.hv  # set to 500mA
