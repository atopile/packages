import Electrical

from "parts/Xinyangze_YZ227415084P_01/Xinyangze_YZ227415084P_01.ato" import Xinyangze_YZ227415084P_01_package
from "parts/GENERIC_TESTPOINT/GENERIC_TESTPOINT.ato" import GENERIC_TESTPOINT
from "parts/Sinhoo_SMTSO3060CTJ/Sinhoo_SMTSO3060CTJ.ato" import Sinhoo_SMTSO3060CTJ_package
from "parts/Xinyangze_YZP0265_12060_01/Xinyangze_YZP0265_12060_01.ato" import Xinyangze_YZP0265_12060_01_package
from "parts/Sinhoo_SMTSO3040CTJ/Sinhoo_SMTSO3040CTJ.ato" import Sinhoo_SMTSO3040CTJ_package

module YZ227415084P:
    """
    YZ227415084P pogo pin
    - 80g
    - 7mm extended, board surface to tip
    - 5.5mm depressed, board surface to tip
    """

    package = new Xinyangze_YZ227415084P_01_package
    pogo = new Electrical
    pogo ~ package.1


module Sinhoo_SMTSO3060CTJ:
    """
    Sinhoo SMTSO3060CTJ M3 6mm tin plated patch round nut
    """

    package = new Sinhoo_SMTSO3060CTJ_package

module Xinyangze_YZP0265_12060_01:
    package = new Xinyangze_YZP0265_12060_01_package

    pogo = new Electrical
    pogo ~ package.1

module Sinhoo_SMTSO3040CTJ:
    package = new Sinhoo_SMTSO3040CTJ_package

module PogoPoint:
    net = new Electrical

    testpoint = new GENERIC_TESTPOINT
    testpoint.contact ~ net
