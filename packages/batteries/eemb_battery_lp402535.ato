#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("TRAITS")

import ElectricPower

from "atopile/batteries/batteries.ato" import BatterySecondary

from "parts/EEMB_BATTERY_LP402535/EEMB_BATTERY_LP402535.ato" import EMB_BATTERY_LP402535_package
from "parts/MOLEX_532610271/MOLEX_532610271.ato" import MOLEX_532610271_package

module EMB_BATTERY_LP402535_model from BatterySecondary:
    """
    LP402535 is a 3.6V lithium-ion battery with a capacity of 320mAh.
    """
    package = new EMB_BATTERY_LP402535_package

    assert charge_current_max <= 320mA
    assert discharge_current_max <= 640mA
    assert voltage within 2.750V to 4.200V
    assert capacity within 300mAh to 320mAh

module EMB_BATTERY_LP402535_driver:
    """
    LP402535 driver.
    """
    model = new EMB_BATTERY_LP402535_model
    connector = new MOLEX_532610271_package

    power = new ElectricPower

    power ~ model.power
    power.hv ~ connector.2
    power.lv ~ connector.1
    power.lv ~ connector.3
    power.lv ~ connector.4
