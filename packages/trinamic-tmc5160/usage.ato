#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import ElectricPower
import SPI
import ElectricLogic

from "trinamic-tmc5160.ato" import Trinamic_TMC5160

module Usage:
    """
    Minimal usage example for `trinamic-tmc5160`.
    Shows basic power and SPI connections for the TMC5160 stepper motor driver.
    """

    # Create TMC5160 driver instance
    stepper_driver = new Trinamic_TMC5160

    # --- Power supplies ---
    power_3v3 = new ElectricPower
    """
    3.3V power supply for I/O (VCC_IO)
    """
    power_3v3.voltage = 3.3V +/- 5%

    power_24v = new ElectricPower
    """
    24V power supply for motor drivers (VS and VSA)
    """
    power_24v.voltage = 24V +/- 10%

    # --- SPI bus ---
    spi_bus = new SPI
    """
    SPI bus for communication with TMC5160
    """
    spi_bus.sclk.reference ~ power_3v3
    spi_bus.mosi.reference ~ power_3v3
    spi_bus.miso.reference ~ power_3v3

    # --- Control signals ---
    chip_select = new ElectricLogic
    """
    SPI chip select signal (active low)
    """
    chip_select.reference ~ power_3v3

    # --- Connections ---

    # Connect power supplies
    power_3v3 ~ stepper_driver.power_vccio
    power_24v ~ stepper_driver.power_motor
    power_24v ~ stepper_driver.power_vsa

    # Connect SPI bus
    spi_bus ~ stepper_driver.spi
    chip_select ~ stepper_driver.chip_select

    # Configure the driver for SPI mode (basic setup)
    stepper_driver.spi_mode.line ~ power_3v3.hv  # Enable SPI mode
    stepper_driver.sd_mode.line ~ power_3v3.lv   # Use internal ramp generator
    stepper_driver.test_mode.line ~ power_3v3.lv # Normal operation mode
