#pragma experiment("BRIDGE_CONNECT")

import ElectricPower
import USB2_0
import Resistor
from "parts/kinghelm_KH_TYPE_C_16P/kinghelm_KH_TYPE_C_16P.ato" import kinghelm_KH_TYPE_C_16P_package


module GenericUSBConn:
    usb2 = new USB2_0


module USBCConn from GenericUSBConn:
    signal gnd
    conn = new kinghelm_KH_TYPE_C_16P_package

    # Connect VBUS
    conn.VBUS ~ usb2.usb_if.buspower.hv
    conn.GND ~ usb2.usb_if.buspower.gnd
    conn.EP ~ usb2.usb_if.buspower.gnd

    # Connect USB
    conn.DP1 ~ usb2.usb_if.d.p.line
    conn.DP2 ~ usb2.usb_if.d.p.line
    conn.DN1 ~ usb2.usb_if.d.n.line
    conn.DN2 ~ usb2.usb_if.d.n.line

    # Add CC resistors
    cc1_res = new Resistor
    cc2_res = new Resistor
    cc1_res.resistance = 5.1kohms +/- 20%
    cc2_res.resistance = 5.1kohms +/- 20%
    cc1_res.package = "R0402"
    cc2_res.package = "R0402"

    conn.CC1 ~> cc1_res ~> usb2.usb_if.buspower.gnd
    conn.CC2 ~> cc2_res ~> usb2.usb_if.buspower.gnd
