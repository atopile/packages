#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
#pragma experiment("TRAITS")

import ElectricPower
import ElectricLogic
import Electrical
import DifferentialPair

from "parts/Neutrik_NC3MAAH/Neutrik_NC3MAAH.ato" import Neutrik_NC3MAAH_package
from "parts/Neutrik_NCJ6FA_H/Neutrik_NCJ6FA_H.ato" import Neutrik_NCJ6FA_H_package

module XLR3_Male_PC_Mount:
    """
    Male XLR 3-pin PCB mount connector (Neutrik NC3MAAH)
    
    Standard XLR connector for professional audio applications.
    Designed for direct PCB mounting with through-hole pins.
    Supports balanced audio signals with ground, hot, and cold connections.
    Pin 1: Ground/Shield, Pin 2: Hot (+), Pin 3: Cold (-)
    """

    # --- External interfaces ---
    balanced_audio = new DifferentialPair
    dmx = new DifferentialPair
    shield = new Electrical
    """
    Balanced audio differential pair interface
    """

    # --- Package ---
    package = new Neutrik_NC3MAAH_package
    shield ~ package.4

    # --- Package connections ---
    # Standard XLR pinout for audio applications
    balanced_audio.p.line ~ package.2         # Pin 2: Hot (positive phase)
    balanced_audio.n.line ~ package.3         # Pin 3: Cold (negative phase)
    balanced_audio.p.reference.lv ~ package.1 # Pin 1: Ground
    balanced_audio.n.reference.lv ~ package.1 # Pin 1: Ground

    # Standard XLR pinout for dmx
    dmx.p.line ~ package.3
    dmx.n.line ~ package.2
    dmx.p.reference.lv ~ package.1
    dmx.n.reference.lv ~ package.1



module XLR3_Female_PC_Mount:
    """
    Female XLR 3-pin PCB mount connector (Neutrik NCJ6FA-H)
    
    Standard XLR connector for professional audio applications.
    Designed for direct PCB mounting with through-hole pins.
    Supports balanced audio signals with ground, hot, and cold connections.
    """

    # --- External interfaces ---
    balanced_audio = new DifferentialPair
    dmx = new DifferentialPair
    """
    Balanced audio differential pair interface
    """

    shield = new Electrical
    """
    Ground/shield connection for audio reference and EMI protection
    """

    # --- Package ---
    package = new Neutrik_NCJ6FA_H_package
    shield ~ package.G # Shield

    # --- Package connections ---
    # AUDIO BALANCED
    balanced_audio.p.line ~ package.2        # Pin 2: Hot (positive phase)
    balanced_audio.n.line ~ package.3        # Pin 3: Cold (negative phase)
    # Connect differential pair reference to ground
    balanced_audio.p.reference.lv ~ package.1
    balanced_audio.n.reference.lv ~ package.1


    # AUDIO TRS
    balanced_audio.p.line ~ package.T # TIP HOT
    balanced_audio.n.line ~ package.R # RING COLD
    balanced_audio.p.reference.lv ~ package.S # SLEEVE
    balanced_audio.n.reference.lv ~ package.S # SLEEVE

    # DMX
    dmx.p.line ~ package.3
    dmx.n.line ~ package.2
    dmx.p.reference.lv ~ package.1
    dmx.n.reference.lv ~ package.1