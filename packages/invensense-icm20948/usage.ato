#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

# --- Standard library imports ---
import ElectricPower
import I2C

# --- Package import ---
from "icm20948.ato" import ICM20948_driver


module Usage:
    """
    Minimal usage example for `invensense-icm20948`.
    Supplies the ICM-20948 with separate 3 V 3 (core) and 1 V 8 (I/O) rails and
    attaches it to an I²C bus at the default address **0x68**.
    """

    # Power rails
    power_3v3 = new ElectricPower  # VDD
    power_3v3.voltage = 3.3V

    power_1v8 = new ElectricPower  # VDDIO
    power_1v8.voltage = 1.8V

    # System I²C bus
    i2c_bus = new I2C

    # IMU instance
    imu = new ICM20948_driver

    # Connect power rails
    power_3v3 ~ imu.power_vdd
    power_1v8 ~ imu.power_vddio

    # Provide logic reference for the bus
    power_1v8 ~ i2c_bus.scl.reference
    power_1v8 ~ i2c_bus.sda.reference

    # Connect I²C bus
    i2c_bus ~ imu.i2c

    # (Optional) Set I²C address – defaults to 0x68 (SDO low)
    imu.i2c.address = 0x68
