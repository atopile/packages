#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("TRAITS")
#pragma experiment("FOR_LOOP")
#pragma experiment("MODULE_TEMPLATING")

import I2C
import SPI
import ElectricPower
import ElectricLogic
import Capacitor
import Resistor
import Addressor

from "parts/TDK_INVENSENSE_ICM_20948/TDK_INVENSENSE_ICM_20948.ato" import TDK_INVENSENSE_ICM_20948_package

module Invensense_ICM20948:
    """
    InvenSense ICM-20948 9-axis motion tracking device (3-axis gyroscope, 3-axis accelerometer, 3-axis magnetometer).

    Features:
    - 3-axis gyroscope with ±250, ±500, ±1000, ±2000 dps full scale range
    - 3-axis accelerometer with ±2g, ±4g, ±8g, ±16g full scale range
    - 3-axis magnetometer (AK09916) with ±4900 nT full scale range
    - Digital Motion Processor (DMP) for advanced motion processing
    - I2C and SPI communication interfaces
    - Operating voltage: VDD 1.71V to 3.6V, VDDIO 1.71V to 1.95V
    - Low power consumption with multiple power modes
    - Built-in temperature sensor
    """

    # --- Package ---
    package = new TDK_INVENSENSE_ICM_20948_package

    # --- External interfaces ---
    i2c = new I2C
    """
    I2C interface for communication (7-bit addr 0x68/0x69)
    """
    i2c.required = True
    assert i2c.frequency <= 400kHz

    spi = new SPI
    """
    SPI interface for high-speed communication (up to 7MHz)
    """
    spi.required = False

    power_core = new ElectricPower
    """
    Core power supply (VDD: 1.71V to 3.6V)
    """
    power_core.required = True
    assert power_core.voltage within 1.71V to 3.6V

    power_io = new ElectricPower
    """
    I/O power supply (VDDIO: 1.71V to 1.95V)
    """
    power_io.required = True
    assert power_io.voltage within 1.71V to 1.95V

    # --- Optional control interfaces ---
    cs = new ElectricLogic
    """
    SPI Chip Select pin (active low)
    """
    cs.required = False

    interrupt = new ElectricLogic
    """
    Interrupt pin (INT1) - programmable interrupt output
    """
    interrupt.required = False

    fsync = new ElectricLogic
    """
    Frame synchronization input pin
    """
    fsync.required = False

    # --- Optional auxiliary I2C interface ---
    aux_i2c = new I2C
    """
    Auxiliary I2C interface for external sensors (magnetometer, etc.)
    """
    aux_i2c.required = False

    # --- Power connections ---
    power_core.hv ~ package.VDD
    power_core.lv ~ package.GND
    power_core.lv ~ package.EP

    power_io.hv ~ package.VDDIO
    power_io.lv ~ package.GND
    power_io.lv ~ package.EP

    # Connect exposed pad to ground for thermal and electrical performance
    power_core.lv ~ package.EP

    # --- I2C interface connections ---
    i2c.scl.line ~ package.SCL_SCLK
    i2c.sda.line ~ package.SDA_SDI
    i2c.scl.reference ~ power_io
    i2c.sda.reference ~ power_io

    # --- SPI interface connections (shared pins with I2C) ---
    spi.sclk.line ~ package.SCL_SCLK
    spi.mosi.line ~ package.SDA_SDI
    spi.miso.line ~ package.SDO_AD0
    spi.sclk.reference ~ power_io
    spi.mosi.reference ~ power_io
    spi.miso.reference ~ power_io

    # --- Control pin connections ---
    cs.line ~ package.nCS
    cs.reference ~ power_io

    interrupt.line ~ package.INT1
    interrupt.reference ~ power_io

    fsync.line ~ package.FSYNC
    fsync.reference ~ power_io

    # --- Auxiliary I2C connections ---
    aux_i2c.scl.line ~ package.AUX_CL
    aux_i2c.sda.line ~ package.AUX_DA
    aux_i2c.scl.reference ~ power_io
    aux_i2c.sda.reference ~ power_io

    # --- I2C Address Configuration ---
    # The I2C address is determined by the SDO/AD0 pin using Addressor
    # - SDO/AD0 = GND: Address 0x68
    # - SDO/AD0 = VDD: Address 0x69
    addressor = new Addressor<address_bits = 1>
    addressor.base = 0x68
    addressor.address_lines[0].line ~ package.SDO_AD0
    addressor.address_lines[0].reference ~ power_io
    assert addressor.address is i2c.address
    # Default to base address (0x68), can be overridden by user
    i2c.address.default = 0x68

    # --- I2C Pull-up resistors ---
    i2c_pullups = new Resistor[2]
    for r in i2c_pullups:
        r.resistance = 10kohm +/- 5%
        r.package = "0402"
    power_io.hv ~> i2c_pullups[0] ~> i2c.scl.line
    power_io.hv ~> i2c_pullups[1] ~> i2c.sda.line

    # --- SPI Chip Select Configuration ---
    # For I2C mode, nCS must be pulled high
    cs_pullup = new Resistor
    cs_pullup.resistance = 10kohm +/- 20%
    cs_pullup.package = "0402"
    power_io.hv ~> cs_pullup ~> package.nCS

    # --- Voltage regulator output ---
    # REGOUT provides regulated 1.8V output (up to 50mA)
    # This can be used to power external sensors
    regulator_output = new ElectricLogic
    regulator_output.line ~ package.REGOUT
    regulator_output.reference ~ power_core
    regulator_output.required = False

    # --- Decoupling capacitors ---
    # Core power supply decoupling
    power_core_cap = new Capacitor
    power_core_cap.capacitance = 100nF +/- 20%
    power_core_cap.package = "0402"
    assert power_core_cap.max_voltage >= power_core.voltage * 1.5
    power_core.hv ~> power_core_cap ~> power_core.lv

    # I/O power supply decoupling
    power_io_cap = new Capacitor
    power_io_cap.capacitance = 100nF +/- 20%
    power_io_cap.package = "0402"
    assert power_io_cap.max_voltage >= power_io.voltage * 1.5
    power_io.hv ~> power_io_cap ~> power_io.lv

    # Additional core power filtering (recommended by datasheet)
    power_core_filter = new Capacitor
    power_core_filter.capacitance = 10nF +/- 20%
    power_core_filter.package = "0402"
    assert power_core_filter.max_voltage >= power_core.voltage * 1.5
    power_core.hv ~> power_core_filter ~> power_core.lv
