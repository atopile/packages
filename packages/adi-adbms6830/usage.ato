#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")

from "atopile/pjrc-teensy-4-1/pjrc-teensy_4_1.ato" import PJRC_Teensy_4_1
from "atopile/adi-adbms6830/adi-adbms6830.ato" import ADI_ADBMS6830
from "atopile/adi-adbms6822/adi-adbms6822.ato" import ADI_ADBMS6822
from "atopile/usb-connectors/usb-connectors.ato" import USBCConn
from "atopile/saleae-header/saleae-header.ato" import SaleaeHeaderRightAngle_2, SaleaeHeaderVertical

import ElectricPower, Resistor


module Usage:
    """
    Usage example for the ADBMS6830 with teensy 4.1 microcontroller with ADBMS6822 to bridge 4w SPI to ISOSPI.
    """
    teensy = new PJRC_Teensy_4_1
    adbms6830 = new ADI_ADBMS6830
    adbms6822 = new ADI_ADBMS6822

    # --- External Interfaces ---
    power_hv = new ElectricPower
    """
    High voltage power supply for the ADBMS6830.
    """
    assert power_hv.voltage within 16V to 20V

    power_lv = new ElectricPower
    """
    Low voltage logic level power supply for the teensy and ADBMS6822.
    """
    assert power_lv.voltage within 3.6V to 5.5V

    usbc_connector = new USBCConn
    """
    Power supply and comms for teensy.
    """

    # --- Power Connections ---
    adbms6830.vbat ~ power_hv

    adbms6822.vdds_spi_power ~ power_lv
    adbms6822.vdd_iso_spi_power ~ power_lv
    adbms6822.vp_power ~ power_lv

    # Connect all grounds, not isolated grounds
    adbms6830.vbat.lv ~ power_lv.lv
    adbms6830.vbat.lv ~ power_hv.lv

    # --- SPI Connections ---
    teensy.spi[0] ~ adbms6822.spi[0]
    teensy.chip_select[0] ~ adbms6822.spi_cs[0]
    teensy.spi[1] ~ adbms6822.spi[1]
    teensy.chip_select[1] ~ adbms6822.spi_cs[1]

    # --- isoSPI Connections ---
    adbms6822.isospi_ports[0] ~ adbms6830.iso_a_external
    adbms6822.isospi_ports[1] ~ adbms6830.iso_b_external

    usbc_connector.usb2.usb_if ~ teensy.usb2

    ldo3v3 = new LDK220M_R
    ldo3v3.v_in = 5V +/- 10%
    ldo3v3.v_out = 3.3V +/- 10%

    ldo3v3.power_out ~ power3v3
    usbc.power ~ ldo3v3.power_in


    # --- Saleae Debug Header Connections ---
    # Spi Interface
    saleae_spi_interface = new SaleaeHeaderRightAngle_2

    saleae_spi_interface.headers[0].spi ~ adbms6822.spi[0]
    saleae_spi_interface.headers[0].spi_cs ~ adbms6822.spi_cs[0]
    saleae_spi_interface.headers[1].spi ~ adbms6822.spi[1]
    saleae_spi_interface.headers[1].spi_cs ~ adbms6822.spi_cs[1]

    # BMB Debug
    saleae_bmb_debug = new SaleaeHeaderVertical
    adbms6830.vreg.hv ~ saleae_bmb_debug.header.channels[0].line
    adbms6830.vreg_drive.line ~ saleae_bmb_debug.header.channels[1].line
    adbms6830.vref2.hv ~ saleae_bmb_debug.header.channels[2].line
