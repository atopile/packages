#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import ElectricPower
import Resistor
from "ruben-iteng/connectors/banana_connectors.ato" import DualBananaConnectors_driver
from "parts/Nextron_Z_231012820106/Nextron_Z_231012820106.ato" import IDC_VSH_connector_20pin
from "atopile/logos/logos.ato" import atopile_logo_25x6mm

module ResistorDivider_16ch:

    cellsim_connector = new IDC_VSH_connector_20pin
    """
    Banana connectors for the resistor divider
    """
    banana_connectors = new DualBananaConnectors_driver
    """
    Resistor divider for 16 cell stack
    """
    power_in = new ElectricPower
    """
    Power input for the resistor divider
    """
    power_in.required = True
    cell_voltage = 1.8V to 4.25V
    power_in.voltage = cell_voltage * 16

    cells = new ElectricPower[16]
    """
    Cells for the resistor divider
    """
    res = new Resistor[16]
    """
    Resistors for the resistor divider
    """
    logo = new atopile_logo_25x6mm
    """
    Logo for the resistor divider
    """

    # Banana connector power
    banana_connectors.power ~ power_in

    # Resistor Configuration
    for resistor in res:
        resistor.resistance = 20ohm +/- 1%
        assert resistor.max_power >= 1W #(((cell_voltage)**2) / resistor.resistance) * 1.5 # 1.5x safety factor

    # Connect power input across resistors
    power_in.gnd ~> res[0] ~> res[1] ~> res[2] ~> res[3] ~> res[4] ~> res[5] ~> res[6] ~> res[7] ~> res[8] ~> res[9] ~> res[10] ~> res[11] ~> res[12] ~> res[13] ~> res[14] ~> res[15] ~> power_in.vcc

    # Connect cell outputs across resistor
    cells[0].gnd ~> res[0] ~> cells[0].vcc
    cells[1].gnd ~> res[1] ~> cells[1].vcc
    cells[2].gnd ~> res[2] ~> cells[2].vcc
    cells[3].gnd ~> res[3] ~> cells[3].vcc
    cells[4].gnd ~> res[4] ~> cells[4].vcc
    cells[5].gnd ~> res[5] ~> cells[5].vcc
    cells[6].gnd ~> res[6] ~> cells[6].vcc
    cells[7].gnd ~> res[7] ~> cells[7].vcc
    cells[8].gnd ~> res[8] ~> cells[8].vcc
    cells[9].gnd ~> res[9] ~> cells[9].vcc
    cells[10].gnd ~> res[10] ~> cells[10].vcc
    cells[11].gnd ~> res[11] ~> cells[11].vcc
    cells[12].gnd ~> res[12] ~> cells[12].vcc
    cells[13].gnd ~> res[13] ~> cells[13].vcc
    cells[14].gnd ~> res[14] ~> cells[14].vcc
    cells[15].gnd ~> res[15] ~> cells[15].vcc

    # Connect cell outputs to connector
    cells[0] ~ cellsim_connector.cells[0]
    cells[1] ~ cellsim_connector.cells[1]
    cells[2] ~ cellsim_connector.cells[2]
    cells[3] ~ cellsim_connector.cells[3]
    cells[4] ~ cellsim_connector.cells[4]
    cells[5] ~ cellsim_connector.cells[5]
    cells[6] ~ cellsim_connector.cells[6]
    cells[7] ~ cellsim_connector.cells[7]
    cells[8] ~ cellsim_connector.cells[8]
    cells[9] ~ cellsim_connector.cells[9]
    cells[10] ~ cellsim_connector.cells[10]
    cells[11] ~ cellsim_connector.cells[11]
    cells[12] ~ cellsim_connector.cells[12]
    cells[13] ~ cellsim_connector.cells[13]
    cells[14] ~ cellsim_connector.cells[14]
    cells[15] ~ cellsim_connector.cells[15]

    # Kelvin Power
    cells[0].gnd ~ cellsim_connector.power_kelvin.gnd
    cells[15].vcc ~ cellsim_connector.power_kelvin.vcc

    # Name nets
    cells[0].gnd.override_net_name = "CELL0"
    cells[0].vcc.override_net_name = "CELL1"
    cells[1].vcc.override_net_name = "CELL2"
    cells[2].vcc.override_net_name = "CELL3"
    cells[3].vcc.override_net_name = "CELL4"
    cells[4].vcc.override_net_name = "CELL5"
    cells[5].vcc.override_net_name = "CELL6"
    cells[6].vcc.override_net_name = "CELL7"
    cells[7].vcc.override_net_name = "CELL8"
    cells[8].vcc.override_net_name = "CELL9"
    cells[9].vcc.override_net_name = "CELL10"
    cells[10].vcc.override_net_name = "CELL11"
    cells[11].vcc.override_net_name = "CELL12"
    cells[12].vcc.override_net_name = "CELL13"
    cells[13].vcc.override_net_name = "CELL14"
    cells[14].vcc.override_net_name = "CELL15"
    cells[15].vcc.override_net_name = "CELL16"
