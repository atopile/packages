#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import ElectricPower
import ElectricLogic
import ElectricSignal
import I2C
import SPI
import Capacitor
import Resistor
import UART
import USB2_0

from "atopile/buttons/buttons.ato" import Button
from "atopile/buttons/buttons.ato" import VerticalButton

from "parts/Espressif_Systems_ESP32_S3_WROOM_1_N16R8/Espressif_Systems_ESP32_S3_WROOM_1_N16R8.ato" import Espressif_Systems_ESP32_S3_WROOM_1_N16R8_package

module Espressif_ESP32S3:
    """
    Espressif ESP32-S3-WROOM-1/1U Module
    """
    ic = new Espressif_Systems_ESP32_S3_WROOM_1_N16R8_package

    # Power
    power = new ElectricPower
    power.required = True
    assert power.voltage within 3V to 3.6V

    ic.P3V3 ~ power.hv
    ic.GND ~ power.lv

    # Decoupling Caps
    c_bulk = new Capacitor
    c_bulk.capacitance = 10uF +/- 20%
    c_bulk.package = "0805"
    power.hv ~> c_bulk ~> power.lv

    c_decoupling = new Capacitor
    c_decoupling.capacitance = 100nF +/- 20%
    c_decoupling.package = "0402"
    power.hv ~> c_decoupling ~> power.lv

    # Enable / Reset
    enable = new ElectricLogic
    enable.line ~ ic.EN
    enable.reference ~ power

    # GPIOs (Defined early for component connection)
    io = new ElectricLogic[49]

    # Components
    boot_switch = new Button
    boot_pullup_resistor = new Resistor
    reset_switch = new Button

    # Boot Switch (IO0)
    # Boot mode: IO0 held low during reset
    power.lv ~> boot_switch ~> io[0].line
    power.hv ~> boot_pullup_resistor ~> io[0].line
    boot_switch -> VerticalButton
    boot_pullup_resistor.resistance = 10kohm +/- 1%
    boot_pullup_resistor.package = "0402"

    # Reset Switch (Enable)
    # RC Delay and manual reset
    r_en = new Resistor
    c_en = new Capacitor

    power.hv ~> r_en ~> enable.line
    enable.line ~> c_en ~> power.lv

    # Parallel connection for reset switch
    power.lv ~> reset_switch ~> enable.line
    reset_switch -> VerticalButton

    # RC Delay values
    r_en.resistance = 10kohm +/- 5%
    r_en.package = "0402"
    c_en.capacitance = 1uF +/- 20%
    c_en.package = "0402"

    # UART0
    uart0 = new UART
    uart0.base_uart.tx ~ ic.TXD0
    uart0.base_uart.rx ~ ic.RXD0

    # USB
    usb = new USB2_0
    usb.usb_if.d.p ~ io[20]
    usb.usb_if.d.n ~ io[19]

    # I2C (Default: SDA=IO8, SCL=IO9)
    i2c = new I2C
    i2c.sda ~ io[8]
    i2c.scl ~ io[9]

    # SPI (Default: MOSI=IO11, MISO=IO13, SCK=IO12, CS=IO10)
    spi = new SPI
    spi.mosi ~ io[11]
    spi.miso ~ io[13]
    spi.sclk ~ io[12]

    spi_cs = new ElectricLogic
    spi_cs ~ io[10]
    spi_cs.reference ~ power

    # Touch Pins (TOUCH1-TOUCH14 mapped to GPIO1-GPIO14)
    touch = new ElectricSignal[15]
    touch[1] ~ io[1]
    touch[2] ~ io[2]
    touch[3] ~ io[3]
    touch[4] ~ io[4]
    touch[5] ~ io[5]
    touch[6] ~ io[6]
    touch[7] ~ io[7]
    touch[8] ~ io[8]
    touch[9] ~ io[9]
    touch[10] ~ io[10]
    touch[11] ~ io[11]
    touch[12] ~ io[12]
    touch[13] ~ io[13]
    touch[14] ~ io[14]

    for touch_pin in touch:
        touch_pin.reference ~ power

    adc = new ElectricSignal[21]
    adc[1] ~ io[1]
    adc[2] ~ io[2]
    adc[3] ~ io[3]
    adc[4] ~ io[4]
    adc[5] ~ io[5]
    adc[6] ~ io[6]
    adc[7] ~ io[7]
    adc[8] ~ io[8]
    adc[9] ~ io[9]
    adc[10] ~ io[10]
    adc[11] ~ io[11]
    adc[12] ~ io[12]
    adc[13] ~ io[13]
    adc[14] ~ io[14]
    adc[15] ~ io[15]
    adc[16] ~ io[16]
    adc[17] ~ io[17]
    adc[18] ~ io[18]
    adc[19] ~ io[19]
    adc[20] ~ io[20]

    for adc_pin in adc:
        adc_pin.reference ~ power

    # Map IOs to pins
    io[0].line ~ ic.IO0
    io[1].line ~ ic.IO1
    io[2].line ~ ic.IO2
    io[3].line ~ ic.IO3
    io[4].line ~ ic.IO4
    io[5].line ~ ic.IO5
    io[6].line ~ ic.IO6
    io[7].line ~ ic.IO7
    io[8].line ~ ic.IO8
    io[9].line ~ ic.IO9
    io[10].line ~ ic.IO10
    io[11].line ~ ic.IO11
    io[12].line ~ ic.IO12
    io[13].line ~ ic.IO13
    io[14].line ~ ic.IO14
    io[15].line ~ ic.IO15
    io[16].line ~ ic.IO16
    io[17].line ~ ic.IO17
    io[18].line ~ ic.IO18
    io[19].line ~ ic.IO19 # USB D-
    io[20].line ~ ic.IO20 # USB D+
    io[21].line ~ ic.IO21

    # 22-25 are NC/N.A. on WROOM-1

    # 26-34 are largely internal/flash/NC on various modules, checking specific package
    # WROOM-1 datasheet says IO26-IO32 are used for SPI flash/PSRAM usually?
    # Looking at part definition:
    # signal IO35 ~ pin 28
    # ...
    # It skips from 21 to 35 in the part definition provided earlier
    # except IO45, 46, 47, 48 which are mapped.

    io[35].line ~ ic.IO35
    io[36].line ~ ic.IO36
    io[37].line ~ ic.IO37
    io[38].line ~ ic.IO38
    io[39].line ~ ic.IO39
    io[40].line ~ ic.IO40
    io[41].line ~ ic.IO41
    io[42].line ~ ic.IO42

    io[45].line ~ ic.IO45
    io[46].line ~ ic.IO46
    io[47].line ~ ic.IO47
    io[48].line ~ ic.IO48

    # Set reference for all IO pins
    for io_pin in io:
        io_pin.reference ~ power
