#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
#pragma experiment("MODULE_TEMPLATING")

import Electrical
import ElectricPower
import ElectricLogic
import I2C
import Resistor
import Capacitor
import Addressor

from "parts/Vishay_Intertech_VCNL4020_GS08/Vishay_Intertech_VCNL4020_GS08.ato" import Vishay_Intertech_VCNL4020_GS08_package

module Vishay_VCNL4020:
    """
    Vishay VCNL4020 fully integrated proximity and ambient light sensor

    Features:
    - Operating voltage: 2.5V to 3.6V
    - I2C interface with fixed address 0x13
    - Proximity detection with IR LED and photodiode
    - Ambient light sensing with photodiode
    - Interrupt functionality
    - Operating temperature: -40°C to +85°C
    - Supply current: 90µA typical (proximity mode)
    - 16-bit resolution for both proximity and ambient light
    - Built-in IR LED with adjustable current
    """

    # --- External interfaces ---
    i2c = new I2C
    """
    I2C bus interface (fixed 7-bit address 0x13)
    """
    i2c.required = True

    power = new ElectricPower
    """
    Main power supply for the sensor (2.5V to 3.6V)
    """
    power.required = True

    interrupt = new ElectricLogic
    """
    Interrupt output pin (active low)
    """
    interrupt.required = False

    # --- Power rail constraints ---
    assert power.voltage within 2.5V to 3.6V

    # --- I2C configuration ---
    # VCNL4020 has a fixed I2C address of 0x13
    assert i2c.address is 0x13

    # --- I2C pull-up resistors ---
    i2c_pullup_scl = new Resistor
    i2c_pullup_sda = new Resistor

    for pullup in [i2c_pullup_scl, i2c_pullup_sda]:
        pullup.resistance = 10kohm +/- 20%
        pullup.package = "0402"

    power.hv ~> i2c_pullup_scl ~> i2c.scl.line
    power.hv ~> i2c_pullup_sda ~> i2c.sda.line

    # --- Interrupt pull-up resistor ---
    interrupt_pullup = new Resistor
    interrupt_pullup.resistance = 10kohm +/- 20%
    interrupt_pullup.package = "0402"

    power.hv ~> interrupt_pullup ~> interrupt.line

    # --- Decoupling capacitors ---
    power_cap = new Capacitor
    power_cap.capacitance = 100nF +/- 20%
    power_cap.package = "0402"

    power.hv ~> power_cap ~> power.lv

    # --- Package connections ---
    package = new Vishay_Intertech_VCNL4020_GS08_package

    # Power connections
    package.VDD ~ power.hv
    package.GND ~ power.lv

    # I2C connections
    package.SCL ~ i2c.scl.line
    package.SDA ~ i2c.sda.line

    # Interrupt connection
    package.INT ~ interrupt.line
    interrupt.reference ~ power

    # IR LED connections (internal - no external connections needed)
    # IRanode and IRcathode are used internally by the IC
