#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")

import ElectricPower

from "NetTie.py" import NetTie

module Usage:
    """
    Example of using netties.

    Net ties are used to connect different nets together on the PCB,
    typically for connecting ground planes or power islands.
    """

    # 2-pin SMD net tie with 0.5mm pads
    basic_nettie = new NetTie<width=0.5, pin_count=2, pad_type="SMD", connect_gnd=True>
    power_a = new ElectricPower
    power_b = new ElectricPower

    # Connect power interfaces to net tie
    basic_nettie.power[0] ~ power_a
    basic_nettie.power[1] ~ power_b
