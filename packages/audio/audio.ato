import ElectricPower
import Resistor
import DifferentialPair
import ElectricSignal

from "parts/BOOMELE_AV_5/BOOMELE_AV_5.ato" import BOOMELE_AV_5_package
from "parts/HOOYA_DIN_323PP/HOOYA_DIN_323PP.ato" import HOOYA_DIN_323PP_package
from "parts/HOOYA_DIN_327/HOOYA_DIN_327.ato" import HOOYA_DIN_327_package
from "parts/SHOU_HAN_PJ_320D/SHOU_HAN_PJ_320D.ato" import SHOU_HAN_PJ_320D_package
from "parts/Texas_Instruments_NE5532ADR/Texas_Instruments_NE5532ADR.ato" import Texas_Instruments_NE5532ADR_package

# System Audio Analog Electrical Balanced XLR XLR_c

# ------------------------------------------------------------------------------
# INTERFACES
# ------------------------------------------------------------------------------
interface SystemAudioStereo:
    l = new Audio
    r = new Audio

interface SystemAudioMono:
    line = new Audio

interface SystemAudioDolby5_1:
    front_left = new Audio
    front_right = new Audio
    center = new Audio
    subwoofer = new Audio
    surround_left = new Audio
    surround_right = new Audio

interface Audio:
    pass

interface DMX:
    # What use is DMX if just one diff pair?
    data = new DifferentialPair

interface ClearCom:
    power = new ElectricPower
    duplex_audio = new ElectricSignal

interface AudioBalanced:
    dp = new DifferentialPair
    dp.p.reference ~ dp.n.reference
    # carries<Audio>

# ------------------------------------------------------------------------------
# XLR CONNECTORS
# ------------------------------------------------------------------------------
module XLR3Header:
    """
        XLR 3 Pin Male Header
    """
    signal pin1
    signal pin2
    signal pin3
    signal gnd

    package = new HOOYA_DIN_327_package
    package.1 ~ pin1
    package.2 ~ pin2
    package.3 ~ pin3
    package.G ~ gnd

module XLR3HeaderBalanced from XLR3Header:
    """
        XLR 3 Pin Male Header wired for one balanced audio channel
    """
    balanced = new AudioBalanced
    balanced.dp.p.line ~ pin2
    balanced.dp.n.line ~ pin3
    balanced.dp.p.reference.gnd ~ pin1

module XLR3Receptacle:
    """
        XLR 3 Pin Female Socket Receptacle
    """
    signal pin1
    signal pin2
    signal pin3
    signal gnd

    package = new HOOYA_DIN_323PP_package
    package.1 ~ pin1
    package.2 ~ pin2
    package.3 ~ pin3
    package.G ~ gnd

module XLR3ReceptacleBalanced from XLR3Receptacle:
    """
        XLR 3 Pin Female Socket Receptacle wired for one balanced audio channel
    """
    balanced = new AudioBalanced
    balanced.dp.p.line ~ pin2
    balanced.dp.n.line ~ pin3
    balanced.dp.p.reference.gnd ~ pin1

module XLR3ReceptacleDMX from XLR3Receptacle:
    dmx = new DMX
    dmx.data.p.line ~ pin3
    dmx.data.n.line ~ pin2
    dmx.data.p.reference.gnd ~ pin1
    dmx.data.n.reference.gnd ~ pin1

# ------------------------------------------------------------------------------
# RCA CONNECTORS
# ------------------------------------------------------------------------------
module RCAReceptacle:
    signal inner_sleeve
    signal outer_shell

    package = new BOOMELE_AV_5_package #TODO: Please someone find a non-yellow rca
    package.1 ~ inner_sleeve
    package.2 ~ outer_shell

module RCAReceptacleSingleEnded from RCAReceptacle:
    line = new ElectricSignal
    line.line ~ inner_sleeve
    line.reference.gnd ~ outer_shell

# ------------------------------------------------------------------------------
# TRS CONNECTORS
# ------------------------------------------------------------------------------
module TRSReceptacle:
    signal tip
    signal ring
    signal sleeve

    package = new SHOU_HAN_PJ_320D_package
    package.1 ~ sleeve
    package.2 ~ sleeve
    package.3 ~ ring
    package.4 ~ tip

module TRSReceptacleBalanced from TRSReceptacle:
    # Balanced
    # carries<Audio>
    balanced = new DifferentialPair
    balanced.p.line ~ tip
    balanced.n.line ~ ring
    balanced.p.reference.gnd ~ sleeve
    balanced.n.reference.gnd ~ sleeve

module TRSReceptacleStereo from TRSReceptacle:
    # Stereo
    # carries<Audio>
    left = new ElectricSignal
    right = new ElectricSignal
    left.line ~ tip
    right.line ~ ring
    left.reference.gnd ~ sleeve
    right.reference.gnd ~ sleeve

module TRRSReceptacle:
    """
        TRRS Receptacle, Ring 1 is nearest to the tip
    """
    signal tip
    signal ring1
    signal ring2
    signal sleeve

    package = new SHOU_HAN_PJ_320D_package
    package.1 ~ sleeve
    package.2 ~ ring2
    package.3 ~ ring1
    package.4 ~ tip

module TRRSReceptacleMicrophone from TRRSReceptacle:
    #carries<Audio>
    left = new ElectricSignal
    right = new ElectricSignal
    microphone = new ElectricSignal
    sleeve ~ microphone.reference.gnd
    sleeve ~ left.reference.gnd
    sleeve ~ right.reference.gnd