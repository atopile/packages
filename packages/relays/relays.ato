"""
Power relays:
HK4100F Series:
SPDT 3A 5V: C12072
SPDT 3A 12V: C13467
SPDT 5A 24V: C38031

G2R-2 Series:
DPDT 5A 5V: C469145
DPDT 5A 12V: C48903
DPDT 5A 24V: C14539

HF115F Series:
DPDT 8A 5V: C9226
DPDT 8A 12V: C163534
DPDT 8A 24V: C34915

Signal Relays:
SPDT 1A 3V: C397232
SPDT 1A 5V: C152705
SPDT 1A 12V: C31113
SPDT 1A 24V: C28694

DPDT 1A 3V: C2153097
DPDT 1A 5V: C47190
DPDT 1A 12V: C397192
DPDT 1A 24V: C5278023

Bistable relays:
DPDT 1A 3V: C6259328
DPDT 1A 5V: C2153173
"""

# Uni-stable relays

module LogicLevelRelaySPDT3A5V from LogicLevelRelayBase:
    relay = new RelaySPDT3A5V
    coil_power.hv ~> relay.coil ~> coil_switch ~> coil_power.lv
    assert coil_power.voltage is relay.coil.voltage

module LogicLevelRelaySPDT3A12V from LogicLevelRelayBase:
    relay = new RelaySPDT3A12V
    coil_power.hv ~> relay.coil ~> coil_switch ~> coil_power.lv
    assert coil_power.voltage is relay.coil.voltage

