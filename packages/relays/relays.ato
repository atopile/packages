module LogicLevelBistableRelayDPDT1A3V from LogicLevelBistableRelayBase:
    relay = new BistableRelayDPDT1A3V
    coil_driver.motor_outs[1] ~> relay.coil ~> coil_driver.motor_outs[0]
    assert coil_power.voltage is relay.coil.voltage

module LogicLevelBistableRelayDPDT1A5V from LogicLevelBistableRelayBase:
