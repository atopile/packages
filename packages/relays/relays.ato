#     coil_power.hv ~> indicator_led ~> coil_switch.mosfet.source


module LogicLevelRelayHack:
    coil_power = new ElectricPower
    enable = new ElectricLogic
    coil_switch = new LowSideNFETSwitch
    indicator_led = new LEDIndicatorGreen
    coil = new Coil

    # Enable connection
    enable ~ coil_switch.enable

    # Coil connection
    coil_power.hv ~> coil ~> coil_switch ~> coil_power.lv

    # Led connection + config
    indicator_led.power.voltage = coil_power.voltage
    indicator_led.current = 0.5mA +/- 10%
    coil_power.hv ~> indicator_led ~> coil_switch.mosfet.source


# Power relays:
# HK4100F Series:
# SPDT 3A 5V: C12072
# SPDT 3A 12V: C13467
# SPDT 5A 24V: C38031

# G2R-2 Series:
# DPDT 5A 5V: C469145
# DPDT 5A 12V: C48903
# DPDT 5A 24V: C14539

# HF115F Series:
# DPDT 8A 5V: C9226
# DPDT 8A 12V: C163534
# DPDT 8A 24V: C34915

# Signal Relays:
# SPDT 1A 3V: C397232
# SPDT 1A 5V: C152705
# SPDT 1A 12V: C31113
# SPDT 1A 24V: C28694

# DPDT 1A 3V: C2153097
# DPDT 1A 5V: C47190
# DPDT 1A 12V: C397192
# DPDT 1A 24V: C5278023
