    trait is_atomic_part<manufacturer = "Omron Electronics", partnumber = "G6KU-2F-Y-TR DC5", footprint = "RELAY-SMD_G6KU-2F-Y.kicad_mod", symbol = "G6KU-2F-Y-TRDC5.kicad_sym", model = "RELAY-SMD_G6KU-2F-Y.STEP">
    trait has_part_picked::by_supplier<supplier_id = "lcsc", supplier_partno = "C2153173", manufacturer = "Omron Electronics", partno = "G6KU-2F-Y-TR DC5">
