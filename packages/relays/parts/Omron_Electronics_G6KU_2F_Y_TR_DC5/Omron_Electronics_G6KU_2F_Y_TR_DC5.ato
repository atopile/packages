module BistableRelayDPDT1A5V from RelayDPDT:
    package = new Omron_Electronics_G6KU_2F_Y_TR_DC5_package
    package.8 ~> coil ~> package.1

    # Switch 0
    package.3 ~> switch_nc[0] ~> package.2
    package.3 ~> switch_no[0] ~> package.4

    # Switch 1
    package.6 ~> switch_nc[1] ~> package.7
    package.6 ~> switch_no[1] ~> package.5

    assert coil.voltage within 5V +/- 10%
    assert coil.resistance within 237ohm +/- 10%
