    trait is_atomic_part<manufacturer = "Omron Electronics", partnumber = "G6KU-2F-Y-TR DC3", footprint = "RELAY-SMD_G6KU-2F-Y.kicad_mod", symbol = "G6KU-2F-Y-TRDC3.kicad_sym", model = "RELAY-SMD_G6KU-2F-Y.STEP">
