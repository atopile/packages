module BistableRelayDPDT1A3V from RelayDPDT:
    package = new Omron_Electronics_G6KU_2F_Y_TR_DC3_package
    package.8 ~> coil ~> package.1

    # Switch 0
    package.3 ~> switch_nc[0] ~> package.2
    package.3 ~> switch_no[0] ~> package.4

    # Switch 1
    package.6 ~> switch_nc[1] ~> package.7
    package.6 ~> switch_no[1] ~> package.5

    assert coil.voltage within 3V +/- 10%
    assert coil.resistance within 91ohm +/- 10%
