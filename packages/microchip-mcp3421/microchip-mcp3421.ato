# Updated: MCP3421 18-bit Delta-Sigma ADC with I2C Interface
#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

# --- Imports ---
import ElectricPower
import I2C
import DifferentialPair
import Capacitor
import Resistor

from "parts/Microchip_Tech_MCP3421A0T_E_CH/Microchip_Tech_MCP3421A0T_E_CH.ato" import Microchip_Tech_MCP3421A0T_E_CH_package

module Microchip_MCP3421:
    """
    Driver for Microchip MCP3421 18-bit, single-channel I²C ADC.

    Exposes:
      * power         – Single-rail supply (2.7V – 5.5V)
      * i2c           – I²C bus interface (fixed address 0x68)
      * analog_input  – Differential analog input pair (Vinpos/Vinneg)

    Features internal 2.048V reference, no external reference needed.
    """

    # --- External interfaces ---
    power = new ElectricPower
    """
    Main power supply for the ADC (2.7V – 5.5V)
    """
    power.required = True
    assert power.voltage within 2.7V to 5.5V

    i2c = new I2C
    """
    I²C bus interface (fixed address 0x68)
    """
    i2c.required = True
    i2c.scl.reference ~ power
    i2c.sda.reference ~ power

    analog_input = new DifferentialPair
    """
    Differential analog input pair (positive and negative inputs)
    """
    analog_input.single_electric_reference.reference ~ power

    # --- I²C addressing ---
    # MCP3421 has a fixed I2C address of 0x68
    i2c.address = 0x68

    # I2C pull-up resistors (soft pullups)
    i2c_pullups = new Resistor[2]
    for r in i2c_pullups:
        r.resistance = 4.7kohm +/- 5%
        r.package = "0402"
    i2c.scl.line ~> i2c_pullups[0] ~> i2c.scl.reference.hv
    i2c.sda.line ~> i2c_pullups[1] ~> i2c.sda.reference.hv

    # --- Decoupling capacitors ---
    # Main power supply decoupling - 100nF
    decoup_main = new Capacitor
    decoup_main.capacitance = 100nF +/- 20%
    decoup_main.package = "0402"
    power.hv ~> decoup_main ~> power.lv

    # Additional VDD decoupling - 10µF
    decoup_vdd = new Capacitor
    decoup_vdd.capacitance = 10uF +/- 20%
    decoup_vdd.package = "0805"
    power.hv ~> decoup_vdd ~> power.lv

    # --- Package ---
    package = new Microchip_Tech_MCP3421A0T_E_CH_package

    # Power connections
    package.VDD ~ power.hv
    package.VSS ~ power.lv

    # I2C connections
    package.SCL ~ i2c.scl.line
    package.SDA ~ i2c.sda.line

    # Differential analog input connections
    package.Vinpos ~ analog_input.p.line
    package.Vinneg ~ analog_input.n.line
