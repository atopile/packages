#pragma experiment("FOR_LOOP")
#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")

from "lattice-ecp5.ato" import Lattice_ECP5_driver
from "atopile/st-stm32h723/st-stm32h723.ato" import ST_STM32H723
from "samsung-ddr3-driver.ato" import Samsung_K4B4G1646E_BYMA_driver
from "atopile/ti-tlv75901/ti-tlv75901.ato" import TI_TLV75901
from "atopile/microchip-lan8742a/microchip-lan8742a.ato" import Microchip_LAN8742A
from "atopile/rj45-connectors/rj45-connectors.ato" import RJ45_Horizontal_TH_Magnetics
from "atopile/usb-connectors/usb-connectors.ato" import USB2_0TypeCHorizontalConnector
from "atopile/programming-headers/programming-headers.ato" import TC2050_ARM_Cortex
from "atopile/indicator-leds/indicator-leds.ato" import LEDIndicatorGreen
from "atopile/indicator-leds/indicator-leds.ato" import LEDIndicatorBlue
from "atopile/indicator-leds/indicator-leds.ato" import LEDIndicatorYellow

from "parts/hanxia_HX_PZ2_54_2x8P_TP/hanxia_HX_PZ2_54_2x8P_TP.ato" import hanxia_HX_PZ2_54_2x8P_TP_package
from "parts/Murata_Electronics_BLM15PX121SN1D/Murata_Electronics_BLM15PX121SN1D.ato" import Murata_Electronics_BLM15PX121SN1D_package
from "parts/Nichicon_UWX1C470MCL1GB/Nichicon_UWX1C470MCL1GB.ato" import Nichicon_UWX1C470MCL1GB_package
from "parts/Winbond_Elec_W25Q128JVSIQ/Winbond_Elec_W25Q128JVSIQ.ato" import Winbond_Elec_W25Q128JVSIQ_package
from "parts/Samtec_PCIE_164_02_F_D_TH/Samtec_PCIE_164_02_F_D_TH.ato" import Samtec_PCIE_164_02_F_D_TH_package

import Electrical
import ElectricPower
import ElectricLogic
import Capacitor
import Resistor

# ============================================================================
# SPI Flash driver for FPGA bitstream storage + OTA
# ============================================================================
module SPI_Flash_W25Q128:
    package = new Winbond_Elec_W25Q128JVSIQ_package

    power = new ElectricPower
    assert power.voltage within 3.3V +/- 10%
    power.hv ~ package.VCC
    power.lv ~ package.GND

    # WP# and HOLD# pulled high to disable write protection
    r_wp = new Resistor
    r_wp.resistance = 10kohm +/- 5%
    r_wp.package = "0402"
    package.IO2 ~ r_wp.unnamed[0]
    r_wp.unnamed[1] ~ power.hv

    r_hold = new Resistor
    r_hold.resistance = 10kohm +/- 5%
    r_hold.package = "0402"
    package.IO3 ~ r_hold.unnamed[0]
    r_hold.unnamed[1] ~ power.hv

    # Decoupling
    cap = new Capacitor
    cap.package = "0402"
    cap.capacitance = 100nF +/- 20%
    cap.max_voltage = 6.3V
    power.hv ~> cap ~> power.lv

# ============================================================================
# Probe Connector - PCIe x16 slot repurposed for 100 probe channels
# ============================================================================
module ProbeConnector:
    "PCIe x16 card-edge slot with ~100 signal channels + GND/3V3 interleave"
    package = new Samtec_PCIE_164_02_F_D_TH_package

    power_ref = new ElectricPower

    # 100 probe channels as ElectricLogic
    ch = new ElectricLogic[100]
    for c in ch:
        c.reference ~ power_ref

    # GND assignment: every 5th pin on each side (A1,A6,A11,...  B1,B6,B11,...)
    package.A1 ~ power_ref.lv
    package.A6 ~ power_ref.lv
    package.A11 ~ power_ref.lv
    package.A16 ~ power_ref.lv
    package.A21 ~ power_ref.lv
    package.A26 ~ power_ref.lv
    package.A31 ~ power_ref.lv
    package.A36 ~ power_ref.lv
    package.A41 ~ power_ref.lv
    package.A46 ~ power_ref.lv
    package.A51 ~ power_ref.lv
    package.A56 ~ power_ref.lv
    package.A61 ~ power_ref.lv
    package.A66 ~ power_ref.lv
    package.A71 ~ power_ref.lv
    package.A76 ~ power_ref.lv
    package.A82 ~ power_ref.lv

    package.B1 ~ power_ref.lv
    package.B6 ~ power_ref.lv
    package.B11 ~ power_ref.lv
    package.B16 ~ power_ref.lv
    package.B21 ~ power_ref.lv
    package.B26 ~ power_ref.lv
    package.B31 ~ power_ref.lv
    package.B36 ~ power_ref.lv
    package.B41 ~ power_ref.lv
    package.B46 ~ power_ref.lv
    package.B51 ~ power_ref.lv
    package.B56 ~ power_ref.lv
    package.B61 ~ power_ref.lv
    package.B66 ~ power_ref.lv
    package.B71 ~ power_ref.lv
    package.B76 ~ power_ref.lv
    package.B82 ~ power_ref.lv

    # 3V3 reference pins
    package.A81 ~ power_ref.hv
    package.B81 ~ power_ref.hv

    # Side A signal channels (ch[0]-ch[49])
    ch[0].line ~ package.A2
    ch[1].line ~ package.A3
    ch[2].line ~ package.A4
    ch[3].line ~ package.A5
    ch[4].line ~ package.A7
    ch[5].line ~ package.A8
    ch[6].line ~ package.A9
    ch[7].line ~ package.A10
    ch[8].line ~ package.A12
    ch[9].line ~ package.A13
    ch[10].line ~ package.A14
    ch[11].line ~ package.A15
    ch[12].line ~ package.A17
    ch[13].line ~ package.A18
    ch[14].line ~ package.A19
    ch[15].line ~ package.A20
    ch[16].line ~ package.A22
    ch[17].line ~ package.A23
    ch[18].line ~ package.A24
    ch[19].line ~ package.A25
    ch[20].line ~ package.A27
    ch[21].line ~ package.A28
    ch[22].line ~ package.A29
    ch[23].line ~ package.A30
    ch[24].line ~ package.A32
    ch[25].line ~ package.A33
    ch[26].line ~ package.A34
    ch[27].line ~ package.A35
    ch[28].line ~ package.A37
    ch[29].line ~ package.A38
    ch[30].line ~ package.A39
    ch[31].line ~ package.A40
    ch[32].line ~ package.A42
    ch[33].line ~ package.A43
    ch[34].line ~ package.A44
    ch[35].line ~ package.A45
    ch[36].line ~ package.A47
    ch[37].line ~ package.A48
    ch[38].line ~ package.A49
    ch[39].line ~ package.A50
    ch[40].line ~ package.A52
    ch[41].line ~ package.A53
    ch[42].line ~ package.A54
    ch[43].line ~ package.A55
    ch[44].line ~ package.A57
    ch[45].line ~ package.A58
    ch[46].line ~ package.A59
    ch[47].line ~ package.A60
    ch[48].line ~ package.A62
    ch[49].line ~ package.A63

    # Side B signal channels (ch[50]-ch[99])
    ch[50].line ~ package.B2
    ch[51].line ~ package.B3
    ch[52].line ~ package.B4
    ch[53].line ~ package.B5
    ch[54].line ~ package.B7
    ch[55].line ~ package.B8
