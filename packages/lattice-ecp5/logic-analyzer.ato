#pragma experiment("FOR_LOOP")
#pragma experiment("TRAITS")

from "lattice-ecp5.ato" import Lattice_ECP5_driver
from "parts/hanxia_HX_PZ2_54_2x8P_TP/hanxia_HX_PZ2_54_2x8P_TP.ato" import hanxia_HX_PZ2_54_2x8P_TP_package
from "../samsung-ddr3/samsung-ddr3.ato" import K4B2G1646F_BCMA_driver

import ElectricPower
import ElectricLogic

module Logic_Analyzer:
    ecp5 = new Lattice_ECP5_driver
    ddr3 = new K4B2G1646F_BCMA_driver

    power_3v3 = new ElectricPower
    power_3v3.voltage = 3.3V +/- 5%
    power_3v3 ~ ecp5.model.power_3v3

    power_vccaux = new ElectricPower
    power_vccaux.voltage = 2.5V +/- 5%
    power_vccaux ~ ecp5.power_vccaux




    # IO References
    for vccio in ecp5.model.power_vccio:
        vccio ~ power_3v3

    # IO Headers
    io_header = new IO_Header[25]

    for h in io_header:
        h.power_reference ~ power_3v3

