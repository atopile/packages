# ============================================================================
# Main Logic Analyzer Module
# ============================================================================
module Logic_Analyzer:
    # --- Core ICs ---
    mcu = new ST_STM32H723
    ecp5 = new Lattice_ECP5_driver
    ddr = new Samsung_K4B4G1646E_BYMA_driver

    # --- Networking ---
    phy = new Microchip_LAN8742A
    rj45 = new RJ45_Horizontal_TH_Magnetics

    # --- Connectors ---
    usb_connector = new USB2_0TypeCHorizontalConnector
    probe = new ProbeConnector
    prog_header = new TC2050_ARM_Cortex

    # --- SPI Flash ---
    spi_flash = new SPI_Flash_W25Q128

    # --- Status LEDs ---
    led_power = new LEDIndicatorGreen
    led_link = new LEDIndicatorYellow
    led_capture = new LEDIndicatorBlue

    # ========================================================================
    # Power Rails
    # ========================================================================
    power_5v0 = new ElectricPower
    power_5v0.voltage = 5.0V +/- 5%
    power_5v0.hv.override_net_name = "5V0"

    power_3v3 = new ElectricPower
    power_3v3.voltage = 3.3V +/- 5%
    power_3v3.hv.override_net_name = "3V3"

    power_2v5 = new ElectricPower
    power_2v5.voltage = 2.5V +/- 5%
    power_2v5.hv.override_net_name = "2V5"

    power_1v35 = new ElectricPower
    power_1v35.voltage = 1.35V +/- 5%
    power_1v35.hv.override_net_name = "1V35"

    power_1v35_ddr_int = new ElectricPower
    power_1v35_ddr_int.voltage = 1.35V +/- 5%
    power_1v35_ddr_int.hv.override_net_name = "1V35_int"

    power_1v1 = new ElectricPower
    power_1v1.voltage = 1.1V +/- 5%
    power_1v1.hv.override_net_name = "1V1"

    # Common ground
    gnd = new Electrical
    power_5v0.lv ~ gnd
    power_3v3.lv ~ gnd
    power_2v5.lv ~ gnd
    power_1v35.lv ~ gnd
    power_1v35_ddr_int.lv ~ gnd
    power_1v1.lv ~ gnd

    # ========================================================================
    # USB-C Power Input
    # ========================================================================
    usb_connector.usb.usb_if.buspower ~ power_5v0

    # ========================================================================
    # Voltage Regulators
    # ========================================================================
    cap_5v0_bulk = new Nichicon_UWX1C470MCL1GB_package
    power_5v0.hv ~ cap_5v0_bulk.1; cap_5v0_bulk.2 ~ power_5v0.lv

    reg_3v3 = new TI_TLV75901
    power_5v0 ~> reg_3v3 ~> power_3v3
    cap_3v3_bulk = new Capacitor
    cap_3v3_bulk.package = "1206"
    cap_3v3_bulk.capacitance = 22uF +/- 20%
    cap_3v3_bulk.max_voltage = 6.3V
    power_3v3.hv ~> cap_3v3_bulk ~> power_3v3.lv

    reg_2v5 = new TI_TLV75901
    power_5v0 ~> reg_2v5 ~> power_2v5
    cap_2v5_bulk = new Capacitor
    cap_2v5_bulk.package = "1206"
    cap_2v5_bulk.capacitance = 22uF +/- 20%
    cap_2v5_bulk.max_voltage = 6.3V
    power_2v5.hv ~> cap_2v5_bulk ~> power_2v5.lv

    reg_1v35 = new TI_TLV75901
    power_3v3 ~> reg_1v35 ~> power_1v35
    cap_1v35_bulk = new Capacitor
    cap_1v35_bulk.package = "1206"
    cap_1v35_bulk.capacitance = 22uF +/- 20%
    cap_1v35_bulk.max_voltage = 6.3V
    power_1v35.hv ~> cap_1v35_bulk ~> power_1v35.lv

    fb_1v35_int = new Murata_Electronics_BLM15PX121SN1D_package
    power_1v35.hv ~ fb_1v35_int.1; power_1v35_ddr_int.hv ~ fb_1v35_int.2
    cap_1v35_int_bulk = new Capacitor
    cap_1v35_int_bulk.package = "0603"
    cap_1v35_int_bulk.capacitance = 10uF +/- 20%
    cap_1v35_int_bulk.max_voltage = 6.3V
    power_1v35_ddr_int.hv ~> cap_1v35_int_bulk ~> power_1v35_ddr_int.lv

    reg_1v1 = new TI_TLV75901
    power_3v3 ~> reg_1v1 ~> power_1v1
    cap_1v1_bulk = new Capacitor
    cap_1v1_bulk.package = "1210"
    cap_1v1_bulk.capacitance = 47uF +/- 20%
    cap_1v1_bulk.max_voltage = 6.3V
    power_1v1.hv ~> cap_1v1_bulk ~> power_1v1.lv

    # ========================================================================
    # MCU Power + USB
    # ========================================================================
    mcu.power_3v3 ~ power_3v3
    usb_connector.usb ~ mcu.usb

    # ========================================================================
    # FPGA Power
    # ========================================================================
    ecp5.model.power_core ~ power_1v1
    ecp5.power_vccaux ~ power_2v5

    ecp5.model.power_vccio[0] ~ power_3v3
    ecp5.model.power_vccio[1] ~ power_3v3
    ecp5.model.power_vccio[2] ~ power_3v3
    ecp5.model.power_vccio[3] ~ power_3v3
    ecp5.model.power_vccio[6] ~ power_1v35
    ecp5.model.power_vccio[7] ~ power_1v35
    ecp5.model.power_vccio[8] ~ power_3v3

    # ========================================================================
    # DDR3 Power + Wiring
    # ========================================================================
    ddr.model.power_external ~ power_1v35
    ddr.model.power_internal ~ power_1v35_ddr_int

    # Control Lines
    ddr.model.n_chip_select ~ ecp5.model.io_bank_6[16]
    ddr.model.n_write_enable ~ ecp5.model.io_bank_6[6]
    ddr.model.clock_enable ~ ecp5.model.io_bank_6[28]
    ddr.model.n_column_address_strobe ~ ecp5.model.io_bank_6[20]
    ddr.model.n_row_address_strobe ~ ecp5.model.io_bank_6[30]
    ddr.model.odt ~ ecp5.model.io_bank_6[26]
    ddr.model.n_reset ~ ecp5.model.io_bank_6[3]

    # Clock pair
    ddr.model.ck ~ ecp5.model.io_bank_6[24]
    ddr.model.n_ck ~ ecp5.model.io_bank_6[25]

    # Address bus (Bank 6)
    ddr.model.address[0] ~ ecp5.model.io_bank_6[15]
    ddr.model.address[1] ~ ecp5.model.io_bank_6[8]
    ddr.model.address[2] ~ ecp5.model.io_bank_6[11]
    ddr.model.address[3] ~ ecp5.model.io_bank_6[13]
    ddr.model.address[4] ~ ecp5.model.io_bank_6[9]
    ddr.model.address[5] ~ ecp5.model.io_bank_6[4]
    ddr.model.address[6] ~ ecp5.model.io_bank_6[12]
    ddr.model.address[7] ~ ecp5.model.io_bank_6[1]
    ddr.model.address[8] ~ ecp5.model.io_bank_6[10]
    ddr.model.address[9] ~ ecp5.model.io_bank_6[0]
    ddr.model.address[10] ~ ecp5.model.io_bank_6[21]
    ddr.model.address[11] ~ ecp5.model.io_bank_6[5]
    ddr.model.address[12] ~ ecp5.model.io_bank_6[14]
    ddr.model.address[13] ~ ecp5.model.io_bank_6[2]
    ddr.model.address[14] ~ ecp5.model.io_bank_6[7]

    ddr.model.bank_address[0] ~ ecp5.model.io_bank_6[23]
    ddr.model.bank_address[1] ~ ecp5.model.io_bank_6[17]
    ddr.model.bank_address[2] ~ ecp5.model.io_bank_6[19]

    # Data - upper byte (Bank 7)
    ddr.model.upper.data[0] ~ ecp5.model.io_bank_7[0]
    ddr.model.upper.data[1] ~ ecp5.model.io_bank_7[1]
    ddr.model.upper.data[2] ~ ecp5.model.io_bank_7[2]
    ddr.model.upper.data[3] ~ ecp5.model.io_bank_7[3]
    ddr.model.upper.data[4] ~ ecp5.model.io_bank_7[4]
    ddr.model.upper.data[5] ~ ecp5.model.io_bank_7[5]
    ddr.model.upper.data[6] ~ ecp5.model.io_bank_7[6]
    ddr.model.upper.data[7] ~ ecp5.model.io_bank_7[7]

    # Data - lower byte (Bank 7)
    ddr.model.lower.data[0] ~ ecp5.model.io_bank_7[8]
    ddr.model.lower.data[1] ~ ecp5.model.io_bank_7[9]
    ddr.model.lower.data[2] ~ ecp5.model.io_bank_7[10]
    ddr.model.lower.data[3] ~ ecp5.model.io_bank_7[11]
    ddr.model.lower.data[4] ~ ecp5.model.io_bank_7[12]
    ddr.model.lower.data[5] ~ ecp5.model.io_bank_7[13]
    ddr.model.lower.data[6] ~ ecp5.model.io_bank_7[14]
    ddr.model.lower.data[7] ~ ecp5.model.io_bank_7[15]

    # Data strobes (Bank 7)
    ddr.model.lower.dqs ~ ecp5.model.io_bank_7[16]
    ddr.model.lower.n_dqs ~ ecp5.model.io_bank_7[17]
    ddr.model.upper.dqs ~ ecp5.model.io_bank_7[18]
    ddr.model.upper.n_dqs ~ ecp5.model.io_bank_7[19]

    # Data masks (Bank 7)
    ddr.model.lower.dm ~ ecp5.model.io_bank_7[20]
    ddr.model.upper.dm ~ ecp5.model.io_bank_7[21]

    # ========================================================================
    # Ethernet: LAN8742A PHY + RJ45
    # ========================================================================
    phy.power_3v3 ~ power_3v3
    # Connect RMII signals individually (different interface types between packages)
    phy.rmii.ref_clk ~ mcu.rmii.ref_clk
    phy.rmii.txd[0] ~ mcu.rmii.txd[0]
    phy.rmii.txd[1] ~ mcu.rmii.txd[1]
    phy.rmii.tx_en ~ mcu.rmii.tx_en
    phy.rmii.rxd[0] ~ mcu.rmii.rxd[0]
    phy.rmii.rxd[1] ~ mcu.rmii.rxd[1]
    phy.rmii.crs_dv ~ mcu.rmii.crs_dv
    # Connect MDIO signals individually
    phy.mdio.mdc ~ mcu.mdio.mdc
    phy.mdio.mdio ~ mcu.mdio.mdio
    phy.ethernet ~ rj45.ethernet
    rj45.shield ~ gnd
    # PHY LEDs are connected automatically via phy.ethernet ~ rj45.ethernet

    # ========================================================================
    # SPI Flash: ECP5 boot + STM32 OTA writes (shared bus)
    # ========================================================================
    spi_flash.power ~ power_3v3

    # FPGA sysCONFIG → Flash (direct, FPGA is SPI master during boot)
    # CFG_0 = MISO (flash DO → FPGA), CFG_1 = MOSI (FPGA → flash DI)
    # CFG_2 = CS (FPGA → flash nCS), CCLK = CLK
    ecp5.model.cclk.line ~ spi_flash.package.CLK
    ecp5.model.cfg[0].line ~ spi_flash.package.DO
    ecp5.model.cfg[1].line ~ spi_flash.package.DI
    ecp5.model.cfg[2].line ~ spi_flash.package.nCS

    # STM32 SPI[0] → Flash (through series resistors, for OTA bitstream writes)
    # FPGA tri-states config pins when PROGRAMN is asserted low
    r_flash_sck = new Resistor
    r_flash_sck.resistance = 100ohm +/- 5%
    r_flash_sck.package = "0402"
    mcu.spi[0].sclk.line ~ r_flash_sck.unnamed[0]
    r_flash_sck.unnamed[1] ~ spi_flash.package.CLK

    r_flash_mosi = new Resistor
    r_flash_mosi.resistance = 100ohm +/- 5%
    r_flash_mosi.package = "0402"
    mcu.spi[0].mosi.line ~ r_flash_mosi.unnamed[0]
    r_flash_mosi.unnamed[1] ~ spi_flash.package.DI

    # MISO doesn't need series resistor (read-only from STM32)
    mcu.spi[0].miso.line ~ spi_flash.package.DO

    # STM32 GPIO for flash CS (active low)
    r_flash_cs = new Resistor
    r_flash_cs.resistance = 100ohm +/- 5%
    r_flash_cs.package = "0402"
    mcu.gpio_c[13].line ~ r_flash_cs.unnamed[0]
    r_flash_cs.unnamed[1] ~ spi_flash.package.nCS

    # STM32 controls FPGA PROGRAMN for boot/OTA
    mcu.gpio_f[0].line ~ ecp5.model.programn.line

    # ========================================================================
    # FPGA ↔ STM32: FMC 8-bit parallel data bus (Bank 2)
    # ========================================================================
    # High-bandwidth path for captured sample readout
    # FMC_D[0:7] data lines
    mcu.gpio_d[14].line ~ ecp5.model.io_bank_2[0].line
    mcu.gpio_d[15].line ~ ecp5.model.io_bank_2[1].line
    mcu.gpio_d[0].line ~ ecp5.model.io_bank_2[2].line
    mcu.gpio_d[1].line ~ ecp5.model.io_bank_2[3].line
    mcu.gpio_e[7].line ~ ecp5.model.io_bank_2[4].line
    mcu.gpio_e[8].line ~ ecp5.model.io_bank_2[5].line
    mcu.gpio_e[9].line ~ ecp5.model.io_bank_2[6].line
    mcu.gpio_e[10].line ~ ecp5.model.io_bank_2[7].line

    # FMC control: NOE (read), NWE (write), NE1 (chip select), FIFO_READY (IRQ)
    mcu.gpio_d[4].line ~ ecp5.model.io_bank_2[8].line
    mcu.gpio_d[5].line ~ ecp5.model.io_bank_2[9].line
    mcu.gpio_d[7].line ~ ecp5.model.io_bank_2[10].line
    mcu.gpio_e[0].line ~ ecp5.model.io_bank_2[11].line

    # ========================================================================
    # FPGA ↔ STM32: SPI control bus (Bank 3)
    # ========================================================================
    # Low-bandwidth register interface for config, status, arm/disarm
    mcu.spi[1].sclk.line ~ ecp5.model.io_bank_3[0].line
    mcu.spi[1].mosi.line ~ ecp5.model.io_bank_3[1].line
    mcu.spi[1].miso.line ~ ecp5.model.io_bank_3[2].line
    mcu.gpio_c[9].line ~ ecp5.model.io_bank_3[3].line

    # ========================================================================
    # Probe Channels → FPGA IO Banks
    # ========================================================================
    probe.power_ref ~ power_3v3

    # Bank 0: 24 channels → probe ch[0]-ch[23]
    probe.ch[0] ~ ecp5.model.io_bank_0[0]
    probe.ch[1] ~ ecp5.model.io_bank_0[1]
    probe.ch[2] ~ ecp5.model.io_bank_0[2]
    probe.ch[3] ~ ecp5.model.io_bank_0[3]
    probe.ch[4] ~ ecp5.model.io_bank_0[4]
    probe.ch[5] ~ ecp5.model.io_bank_0[5]
    probe.ch[6] ~ ecp5.model.io_bank_0[6]
    probe.ch[7] ~ ecp5.model.io_bank_0[7]
    probe.ch[8] ~ ecp5.model.io_bank_0[8]
    probe.ch[9] ~ ecp5.model.io_bank_0[9]
    probe.ch[10] ~ ecp5.model.io_bank_0[10]
    probe.ch[11] ~ ecp5.model.io_bank_0[11]
    probe.ch[12] ~ ecp5.model.io_bank_0[12]
    probe.ch[13] ~ ecp5.model.io_bank_0[13]
    probe.ch[14] ~ ecp5.model.io_bank_0[14]
    probe.ch[15] ~ ecp5.model.io_bank_0[15]
    probe.ch[16] ~ ecp5.model.io_bank_0[16]
    probe.ch[17] ~ ecp5.model.io_bank_0[17]
    probe.ch[18] ~ ecp5.model.io_bank_0[18]
    probe.ch[19] ~ ecp5.model.io_bank_0[19]
    probe.ch[20] ~ ecp5.model.io_bank_0[20]
    probe.ch[21] ~ ecp5.model.io_bank_0[21]
    probe.ch[22] ~ ecp5.model.io_bank_0[22]
    probe.ch[23] ~ ecp5.model.io_bank_0[23]

    # Bank 1: 32 channels → probe ch[24]-ch[55]
    probe.ch[24] ~ ecp5.model.io_bank_1[0]
    probe.ch[25] ~ ecp5.model.io_bank_1[1]
    probe.ch[26] ~ ecp5.model.io_bank_1[2]
    probe.ch[27] ~ ecp5.model.io_bank_1[3]
    probe.ch[28] ~ ecp5.model.io_bank_1[4]
    probe.ch[29] ~ ecp5.model.io_bank_1[5]
    probe.ch[30] ~ ecp5.model.io_bank_1[6]
    probe.ch[31] ~ ecp5.model.io_bank_1[7]
    probe.ch[32] ~ ecp5.model.io_bank_1[8]
    probe.ch[33] ~ ecp5.model.io_bank_1[9]
    probe.ch[34] ~ ecp5.model.io_bank_1[10]
    probe.ch[35] ~ ecp5.model.io_bank_1[11]
    probe.ch[36] ~ ecp5.model.io_bank_1[12]
    probe.ch[37] ~ ecp5.model.io_bank_1[13]
    probe.ch[38] ~ ecp5.model.io_bank_1[14]
    probe.ch[39] ~ ecp5.model.io_bank_1[15]
    probe.ch[40] ~ ecp5.model.io_bank_1[16]
    probe.ch[41] ~ ecp5.model.io_bank_1[17]
    probe.ch[42] ~ ecp5.model.io_bank_1[18]
    probe.ch[43] ~ ecp5.model.io_bank_1[19]
    probe.ch[44] ~ ecp5.model.io_bank_1[20]
    probe.ch[45] ~ ecp5.model.io_bank_1[21]
    probe.ch[46] ~ ecp5.model.io_bank_1[22]
    probe.ch[47] ~ ecp5.model.io_bank_1[23]
    probe.ch[48] ~ ecp5.model.io_bank_1[24]
    probe.ch[49] ~ ecp5.model.io_bank_1[25]
    probe.ch[50] ~ ecp5.model.io_bank_1[26]
    probe.ch[51] ~ ecp5.model.io_bank_1[27]
    probe.ch[52] ~ ecp5.model.io_bank_1[28]
    probe.ch[53] ~ ecp5.model.io_bank_1[29]
    probe.ch[54] ~ ecp5.model.io_bank_1[30]
    probe.ch[55] ~ ecp5.model.io_bank_1[31]

    # Bank 2 remaining (after FMC uses [0:11]): 16 channels → probe ch[56]-ch[71]
    probe.ch[56] ~ ecp5.model.io_bank_2[12]
    probe.ch[57] ~ ecp5.model.io_bank_2[13]
    probe.ch[58] ~ ecp5.model.io_bank_2[14]
    probe.ch[59] ~ ecp5.model.io_bank_2[15]
    probe.ch[60] ~ ecp5.model.io_bank_2[16]
    probe.ch[61] ~ ecp5.model.io_bank_2[17]
    probe.ch[62] ~ ecp5.model.io_bank_2[18]
    probe.ch[63] ~ ecp5.model.io_bank_2[19]
    probe.ch[64] ~ ecp5.model.io_bank_2[20]
    probe.ch[65] ~ ecp5.model.io_bank_2[21]
    probe.ch[66] ~ ecp5.model.io_bank_2[22]
    probe.ch[67] ~ ecp5.model.io_bank_2[23]
    probe.ch[68] ~ ecp5.model.io_bank_2[24]
    probe.ch[69] ~ ecp5.model.io_bank_2[25]
    probe.ch[70] ~ ecp5.model.io_bank_2[26]
    probe.ch[71] ~ ecp5.model.io_bank_2[27]

    # Bank 3 remaining (after SPI ctrl uses [0:3]): 24 channels → probe ch[72]-ch[95]
    probe.ch[72] ~ ecp5.model.io_bank_3[4]
    probe.ch[73] ~ ecp5.model.io_bank_3[5]
    probe.ch[74] ~ ecp5.model.io_bank_3[6]
    probe.ch[75] ~ ecp5.model.io_bank_3[7]
    probe.ch[76] ~ ecp5.model.io_bank_3[8]
    probe.ch[77] ~ ecp5.model.io_bank_3[9]
    probe.ch[78] ~ ecp5.model.io_bank_3[10]
    probe.ch[79] ~ ecp5.model.io_bank_3[11]
    probe.ch[80] ~ ecp5.model.io_bank_3[12]
    probe.ch[81] ~ ecp5.model.io_bank_3[13]
    probe.ch[82] ~ ecp5.model.io_bank_3[14]
    probe.ch[83] ~ ecp5.model.io_bank_3[15]
    probe.ch[84] ~ ecp5.model.io_bank_3[16]
    probe.ch[85] ~ ecp5.model.io_bank_3[17]
    probe.ch[86] ~ ecp5.model.io_bank_3[18]
    probe.ch[87] ~ ecp5.model.io_bank_3[19]
    probe.ch[88] ~ ecp5.model.io_bank_3[20]
    probe.ch[89] ~ ecp5.model.io_bank_3[21]
    probe.ch[90] ~ ecp5.model.io_bank_3[22]
    probe.ch[91] ~ ecp5.model.io_bank_3[23]
    probe.ch[92] ~ ecp5.model.io_bank_3[24]
    probe.ch[93] ~ ecp5.model.io_bank_3[25]
    probe.ch[94] ~ ecp5.model.io_bank_3[26]
    probe.ch[95] ~ ecp5.model.io_bank_3[27]

    # Remaining ch[96]-ch[99] from Bank 2 loopback-capable pins
    probe.ch[96] ~ ecp5.model.io_bank_2[28]
    probe.ch[97] ~ ecp5.model.io_bank_2[29]
    probe.ch[98] ~ ecp5.model.io_bank_2[30]
    probe.ch[99] ~ ecp5.model.io_bank_2[31]

    # ========================================================================
    # Self-Test Loopback Paths
    # ========================================================================
    # FPGA→FPGA loopback: Bank 2 outputs [28:31] → Bank 0 inputs [20:23]
    # These share probe ch[96:99] (Bank 2 side) and ch[20:23] (Bank 0 side).
    # FPGA drives pattern on [28:31], captures on [20:23] via probe connector traces.

    # FPGA→STM32 loopback: Bank 3 outputs [28:29] → STM32 GPIO
    ecp5.model.io_bank_3[28].line ~ mcu.gpio_e[1].line
    ecp5.model.io_bank_3[29].line ~ mcu.gpio_e[2].line

    # ========================================================================
    # Programming Header (STM32 SWD)
    # ========================================================================
    prog_header.swd ~ mcu.swd

    # ========================================================================
    # Status LEDs
    # ========================================================================
    # Power LED: always on when 3V3 is present
    led_power.power ~ power_3v3

    # Link LED: driven by STM32 GPIO
    led_link.power.hv ~ mcu.gpio_g[0].line
    led_link.power.lv ~ gnd

    # Capture LED: driven by STM32 GPIO
    led_capture.power.hv ~ mcu.gpio_g[1].line
    led_capture.power.lv ~ gnd

    # ========================================================================
    # Self-Test Voltage Dividers (for STM32 ADC monitoring)
    # ========================================================================
    # 5V0 rail: 10k/10k divider → PA0 (2.5V at ADC input)
    r_mon_5v_top = new Resistor
    r_mon_5v_top.resistance = 10kohm +/- 1%
    r_mon_5v_top.package = "0402"
    r_mon_5v_bot = new Resistor
    r_mon_5v_bot.resistance = 10kohm +/- 1%
    r_mon_5v_bot.package = "0402"
    power_5v0.hv ~ r_mon_5v_top.unnamed[0]
    r_mon_5v_top.unnamed[1] ~ mcu.gpio_a[0].line
    mcu.gpio_a[0].line ~ r_mon_5v_bot.unnamed[0]
    r_mon_5v_bot.unnamed[1] ~ gnd

    # 3V3 rail: 10k/10k divider → PA2 (1.65V at ADC input)
    r_mon_3v3_top = new Resistor
    r_mon_3v3_top.resistance = 10kohm +/- 1%
    r_mon_3v3_top.package = "0402"
    r_mon_3v3_bot = new Resistor
    r_mon_3v3_bot.resistance = 10kohm +/- 1%
    r_mon_3v3_bot.package = "0402"
    power_3v3.hv ~ r_mon_3v3_top.unnamed[0]
    r_mon_3v3_top.unnamed[1] ~ mcu.gpio_a[2].line
    mcu.gpio_a[2].line ~ r_mon_3v3_bot.unnamed[0]
    r_mon_3v3_bot.unnamed[1] ~ gnd

    # 2V5, 1V35, 1V1 are within 3.3V ADC range — direct sense with 100k to ADC
    r_mon_2v5 = new Resistor
    r_mon_2v5.resistance = 100kohm +/- 1%
    r_mon_2v5.package = "0402"
    power_2v5.hv ~ r_mon_2v5.unnamed[0]
    r_mon_2v5.unnamed[1] ~ mcu.gpio_a[3].line

    r_mon_1v35 = new Resistor
    r_mon_1v35.resistance = 100kohm +/- 1%
    r_mon_1v35.package = "0402"
    power_1v35.hv ~ r_mon_1v35.unnamed[0]
    r_mon_1v35.unnamed[1] ~ mcu.gpio_a[4].line

    r_mon_1v1 = new Resistor
    r_mon_1v1.resistance = 100kohm +/- 1%
    r_mon_1v1.package = "0402"
    power_1v1.hv ~ r_mon_1v1.unnamed[0]
    r_mon_1v1.unnamed[1] ~ mcu.gpio_a[5].line
