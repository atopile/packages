#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import Electrical
import ElectricPower
import ElectricLogic
import JTAG
import Capacitor
import Resistor

from "parts/Lattice_LFE5U_25F_6BG256C/Lattice_LFE5U_25F_6BG256C.ato" import Lattice_LFE5U_25F_6BG256C_package
from "atopile/ti-tlv75901/ti-tlv75901.ato" import TI_TLV75901
from "atopile/programming-headers/programming-headers.ato" import JTAG_10PIN
from "parts/Murata_Electronics_BLM15PX121SN1D/Murata_Electronics_BLM15PX121SN1D.ato" import Murata_Electronics_BLM15PX121SN1D_package                 

# Model defines pin types
module Lattice_ECP5_model:

    # Package
    package = new Lattice_LFE5U_25F_6BG256C_package

    # Ground
    gnd = new Electrical
    gnd.override_net_name = "GND"
    gnd ~ package.GND

    # Power
    power_3v3 = new ElectricPower
    assert power_3v3.voltage within 3.3V +/- 5%
    power_3v3.lv ~ gnd

    # Core Power
    power_vcc = new ElectricPower
    assert power_vcc.voltage within 1.1V +/- 3%
    power_vcc.hv ~ package.VCC
    power_vcc.lv ~ gnd

    # Aux Power
    power_vccaux_filtered = new ElectricPower
    assert power_vccaux_filtered.voltage within 2.5V +/- 5%
    power_vccaux_filtered.hv ~ package.VCCAUX
    power_vccaux_filtered.lv ~ gnd

    # IO Power
    power_vccio = new ElectricPower[9]
    for p in power_vccio:
        p.required = True
        p.lv ~ gnd
    
    power_vccio[0].hv ~ package.VCCIO0
    power_vccio[1].hv ~ package.VCCIO1
    power_vccio[2].hv ~ package.VCCIO2
    power_vccio[3].hv ~ package.VCCIO3
    # power_vccio[4] ~ package.VCCIO4 # there is no VCCIO4
    # power_vccio[5] ~ package.VCCIO5 # there is no VCCIO5
    power_vccio[6].hv ~ package.VCCIO6
    power_vccio[7].hv ~ package.VCCIO7
    power_vccio[8].hv ~ package.VCCIO8
    
    # JTAG
    jtag = new JTAG
    jtag.tck.line ~ package.TCK
    jtag.tms.line ~ package.TMS
    jtag.tdi.line ~ package.TDI
    jtag.tdo.line ~ package.TDO
    jtag.vtref ~ power_vccio[8] # JTAG signals are referenced to VCCIO8

    # sysCONFIG
    cfg = new ElectricLogic[3]
    initn = new ElectricLogic
    programn = new ElectricLogic
    done = new ElectricLogic
    cclk = new ElectricLogic
    cfg[0].line ~ package.CFG_0
    cfg[1].line ~ package.CFG_1
    cfg[2].line ~ package.CFG_2
    initn.line ~ package.INITN
    programn.line ~ package.PROGRAMN
    done.line ~ package.DONE
    cclk.line ~ package.CCLK

    # sysCONFIG signals are referenced to VCCIO8
    power_vccio[8] ~ initn.reference
    power_vccio[8] ~ programn.reference
    power_vccio[8] ~ done.reference
    power_vccio[8] ~ cclk.reference
    for c in cfg:
        power_vccio[8] ~ c.reference 

    # # Button - from OrangeCrab
    # button = new ElectricLogic
    # button.line ~ package.PL38C

    # # RBG LED - from OrangeCrab
    # rgb_led = new ElectricLogic[3]
    # rgb_led[0].line ~ package.PR38A
    # rgb_led[1].line ~ package.PR41A
    # rgb_led[2].line ~ package.PR29C

    # IO Banks
    io_bank_0 = new ElectricLogic[24]
    io_bank_1 = new ElectricLogic[32]
    io_bank_2 = new ElectricLogic[32]
    io_bank_3 = new ElectricLogic[32]
    io_bank_6 = new ElectricLogic[32]
    io_bank_7 = new ElectricLogic[32]
    io_bank_8 = new ElectricLogic[13]

    for io in io_bank_0:
        io.reference ~ power_vccio[0]
    for io in io_bank_1:
        io.reference ~ power_vccio[1]
    for io in io_bank_2:
        io.reference ~ power_vccio[2]
    for io in io_bank_3:
        io.reference ~ power_vccio[3]
    for io in io_bank_6:
        io.reference ~ power_vccio[6]
    for io in io_bank_7:
        io.reference ~ power_vccio[7]
    for io in io_bank_8:
        io.reference ~ power_vccio[8]
        
#region
    io_bank_0[23].line ~ package.PT29B
    io_bank_0[22].line ~ package.PT27B
    io_bank_0[21].line ~ package.PT29A
    io_bank_0[20].line ~ package.PT27A
