module Lattice_ECP5:

    # Base
    ecp5 = new Lattice_ECP5_base

    gnd = new Electrical
    gnd ~ ecp5.gnd

    power_3v3 = new ElectricPower
    power_3v3 ~ ecp5.power_3v3

    # Programming Header
    programming_header = new JTAG_10PIN
    programming_header.jtag ~ ecp5.jtag

    # --- I/O Channels ---
    ch_headers = new hanxia_HX_PZ2_54_2x8P_TP_package[18]
    for header in ch_headers:
        header.1 ~ gnd
        header.3 ~ gnd
        header.5 ~ gnd
        header.7 ~ gnd
        header.9 ~ gnd
        header.11 ~ gnd
        header.13 ~ gnd
        header.15 ~ gnd
