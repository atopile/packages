module MicroSDCardAssemblyWithRemovableSPI:
    """
    This module contains a MicroSD card receptacle with a (virtual) removable MicroSD
    card with SPI interface.
    """
    # interface
    spi = new SPI
    spi_cs = new ElectricLogic
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic
    power = new ElectricPower

    #usdcard
    receptacle = new SDReceptacle # replace this in your application with a uSD card receptacle package
    slot_driver = new SDSlotDriver
    sd_logical = new SDLogical

    # external
    spi.miso ~ sd_logical.data[0]
    spi.mosi ~ sd_logical.data[1]
    spi.sclk ~ sd_logical.clock
    spi_cs ~ sd_logical.chip_select
    card_detect ~ sd_logical.card_detect
    power ~ sd_logical.power
    write_protect ~ sd_logical.write_protect

    # driver
    slot_driver.sd_card_interface ~ sd_logical

    pullups = new Resistor[3]
    for pullup in pullups:
        pullup.resistance = 10 kohm +/- 5%
        pullup.package = "R0402"
    spi.miso.line ~> pullups[0] ~> power.hv
    spi.mosi.line ~> pullups[1] ~> power.hv
    spi.sclk.line ~> pullups[2] ~> power.hv

    # footprint
    sd_logical.power.hv ~ receptacle.sdbus.VDD
    sd_logical.power.lv ~ receptacle.sdbus.VSS1
    sd_logical.power.lv ~ receptacle.sdbus.VSS2
    sd_logical.card_detect.line ~ receptacle.sdbus.CD
    sd_logical.write_protect.line ~ receptacle.sdbus.WP
    sd_logical.data[0].line ~ receptacle.sdbus.DAT0
    sd_logical.data[1].line ~ receptacle.sdbus.DAT1
    sd_logical.data[2].line ~ receptacle.sdbus.DAT2
    sd_logical.data[3].line ~ receptacle.sdbus.CD_DAT3
    sd_logical.clock.line ~ receptacle.sdbus.CLK
    sd_logical.command.line ~ receptacle.sdbus.CMD
    sd_logical.chip_select.line ~ receptacle.sdbus.CD_DAT3

interface SDLogical:
    # This is NOW being used as an SD card
    power = new ElectricPower
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic
    data = new ElectricLogic[4]
    clock = new ElectricLogic
    chip_select = new ElectricLogic
    command = new ElectricLogic

module SDAssembly:
    """
    Assembly has both a receptacle and a theoretical SD card in it and nothing else captured as design intent in the model
    We allow anything that behaves as an SD card, limited by the set of existing operational SD cards, as long as it behaves like an sd card.
    """
    low = new SDBus
    # DRIVER CIRCUITRY
    bypass_cap = new Capacitor # Are these needed on EEMC? Maybe only in socketed version
    bypass_cap.capacitance = 100 nF +/- 20%
    bypass_cap.package = "C0402"
    # bypass_cap.power ~ sd_card_interface.power

