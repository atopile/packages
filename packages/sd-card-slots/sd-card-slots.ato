module PushPullMicroSDSPI:
    pass

# Standard/Full-size SD card slots
# TODO: Add PushPush variant (spring loaded)
module PushPullSD:
    """
        Push pull full-size SD card slot, card is not spring loaded
    """
    package = new XUNPU_SD_102_package

    power = new ElectricPower
    power.vcc ~ package.VDD
    power.gnd ~ package.VSS1
    power.gnd ~ package.VSS2
    power.gnd ~ package.EP

    bypass_cap = new Capacitor
    bypass_cap.capacitance = 100 nF +/- 20%
    bypass_cap.package = "C0402"
    bypass_cap.power ~ power

    write_protect = new ElectricLogic
    write_protect.line ~ package.nWP

module PushPullSDSPI from PushPullSD:
    spi = new SPI
    spi_cs = new ElectricSignal
    power ~ spi.sclk.reference
    spi.miso.line ~ package.DAT0
    spi.mosi.line ~ package.CMD
    spi.sclk.line ~ package.CLK
    spi_cs.line ~ package.CD_DAT3

module PushPullSD4bit from PushPullSD:
    sd_4bit = new SD4bit
    sd_4bit.clk ~ package.CLK
    sd_4bit.cmd ~ package.CMD
    sd_4bit.data0 ~ package.DAT0
    sd_4bit.data1 ~ package.DAT1
    sd_4bit.data2 ~ package.DAT2
    sd_4bit.cd_data3 ~ package.CD_DAT3
    sd_4bit.gnd ~ power.gnd

module PushPullSDUHS1 from PushPullSD:
    uhs1 = new UHS1
    uhs1.clk ~ package.CLK
    uhs1.cmd ~ package.CMD
    uhs1.data0 ~ package.DAT0
    uhs1.data1 ~ package.DAT1
    uhs1.data2 ~ package.DAT2
    uhs1.cd_data3 ~ package.CD_DAT3
    uhs1.gnd ~ power.gnd

module PushPushSD:
    """
        Push push full-size SD card slot, card is spring loaded
    """
    package = new SOFNG_SD_006M_package

    power = new ElectricPower
    power.vcc ~ package.VDD
    power.gnd ~ package.Vss1
    power.gnd ~ package.Vss2
    power.gnd ~ package.12
    power.gnd ~ package.13

    bypass_cap = new Capacitor
    bypass_cap.capacitance = 100 nF +/- 20%
    bypass_cap.package = "C0402"
    bypass_cap.power ~ power

    write_protect = new ElectricLogic
    write_protect.line ~ package.WP

module PushPushSDSPI from PushPushSD:
    spi = new SPI
    spi_cs = new ElectricSignal
    power ~ spi.sclk.reference
    spi.miso.line ~ package.DAT0
    spi.mosi.line ~ package.CMD
    spi.sclk.line ~ package.CLK
    spi_cs.line ~ package.CD_DAT3

module PushPushSD4bit from PushPushSD:
    sd_4bit = new SD4bit
    sd_4bit.clk ~ package.CLK
    sd_4bit.cmd ~ package.CMD
    sd_4bit.data0 ~ package.DAT0
    sd_4bit.data1 ~ package.DAT1
    sd_4bit.data2 ~ package.DAT2
    sd_4bit.cd_data3 ~ package.CD_DAT3
    sd_4bit.gnd ~ power.gnd

module PushPushSDUHS1 from PushPushSD:
    uhs1 = new UHS1
    uhs1.clk ~ package.CLK
    uhs1.cmd ~ package.CMD
    uhs1.data0 ~ package.DAT0
    uhs1.data1 ~ package.DAT1
    uhs1.data2 ~ package.DAT2
    uhs1.cd_data3 ~ package.CD_DAT3
    uhs1.gnd ~ power.gnd

# SD Card interfaces
interface SD4bit:
    signal data0
    signal data1
    signal data2
    signal cd_data3
    signal clk
    signal cmd
    signal gnd

# UHS-1 104Mbps
# UHS-2 312Mbps
# UHS-3 624Mbps
interface UHS1:
    signal data0
    signal data1
    signal data2
    signal cd_data3
    signal clk
    signal cmd
    signal gnd

interface UHS2:
    pass

interface UHS3:
    pass

interface SDExpress:
    pass
    # PCIe

#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import Resistor, Capacitor
from "atopile/esp32/esp32_c3.ato" import ESP32_C3_WROOM
# from "atopile/sd-card-slots/sd-card-slots.ato" import PushPushMicroSDSPI
from "atopile/usb-connectors/usb-connectors.ato" import USBCConn
from "atopile/ti-tlv75901/ti-tlv75901.ato" import TLV75901_driver

module PushPushMicroSDSPI_Example:
    esp32 = new ESP32_C3_WROOM
    sd_card = new PushPullSDSPI
    micro_sd_card = new PushPushMicroSDSPI
    usbc = new USBCConn
    ldo_3v3 = new TLV75901_driver

    # Configure LDO
    ldo_3v3.v_in = 5V +/- 5%
    ldo_3v3.v_out = 3.3V +/- 3%

    # Connect USB
    usbc.usb2 ~ esp32.usb2
    usbc.usb2.usb_if.buspower ~> ldo_3v3 ~> esp32.power

    # Connect SD Card
    sd_card.spi ~ esp32.spi[2]
    sd_card.spi_cs ~ esp32.spi_cs[2]
    sd_card.power ~ esp32.power
    pullups = new Resistor[3]
    for pullup in pullups:
        pullup.resistance = 10 kohm +/- 5%
        pullup.package = "R0402"
    sd_card.spi.miso.line ~> pullups[0] ~> esp32.power.hv
    sd_card.spi.mosi.line ~> pullups[1] ~> esp32.power.hv
    sd_card.spi.sclk.line ~> pullups[2] ~> esp32.power.hv

    # Connect micro SD Card
    micro_sd_card.spi ~ esp32.spi[2]
    micro_sd_card.spi_cs ~ esp32.gpios[3]
    micro_sd_card.power ~ esp32.power
    micro_pullups = new Resistor[3]
    for pullup in micro_pullups:
        pullup.resistance = 10 kohm +/- 5%
        pullup.package = "R0402"
    micro_sd_card.spi.miso.line ~> micro_pullups[0] ~> esp32.power.hv
    micro_sd_card.spi.mosi.line ~> micro_pullups[1] ~> esp32.power.hv
    micro_sd_card.spi.sclk.line ~> micro_pullups[2] ~> esp32.power.hv
