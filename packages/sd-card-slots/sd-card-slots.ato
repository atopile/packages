import SPI, ElectricPower, ElectricSignal, ElectricLogic
from "parts/Korean_Hroparts_Elec_TF_01A/Korean_Hroparts_Elec_TF_01A.ato" import Korean_Hroparts_Elec_TF_01A_package
from "parts/XUNPU_SD_102/XUNPU_SD_102.ato" import XUNPU_SD_102_package
from "parts/SOFNG_SD_006M/SOFNG_SD_006M.ato" import SOFNG_SD_006M_package

# microSD card slots
## Push Push
module PushPushMicroSD:
    """
        Push push microSD card slot, card is spring loaded
    """
    package = new Korean_Hroparts_Elec_TF_01A_package

    power = new ElectricPower
    power.vcc ~ package.VDD
    power.gnd ~ package.VSS
    power.gnd ~ package.GND

    bypass_cap = new Capacitor
    bypass_cap.capacitance = 100 nF +/- 20%
    bypass_cap.package = "C0402"
    bypass_cap.power ~ power

module PushPushMicroSDSPI from PushPushMicroSD:
    spi = new SPI
    spi_cs = new ElectricSignal
    power ~ spi.sclk.reference
    spi.miso.line ~ package.DAT0D0
    spi.mosi.line ~ package.CMDDI
    spi.sclk.line ~ package.CLKSCLK
    spi_cs.line ~ package.CDDAT3CS

module PushPushMicroSD4bit from PushPushMicroSDSPI:
    sd_4bit = new SD4bit
    sd_4bit.clk ~ package.CLKSCLK
    sd_4bit.cmd ~ package.CMDDI
    sd_4bit.data0 ~ package.DAT0D0
    sd_4bit.data1 ~ package.DAT1RSV
    sd_4bit.data2 ~ package.DAT2RSV
    sd_4bit.cd_data3 ~ package.CDDAT3CS
    sd_4bit.gnd ~ package.GND

module PushPushMicroSDUHS1 from PushPushMicroSD:
    uhs1 = new UHS1
    uhs1.clk ~ package.CLKSCLK
    uhs1.cmd ~ package.CMDDI
    uhs1.data0 ~ package.DAT0D0
    uhs1.data1 ~ package.DAT1RSV
    uhs1.data2 ~ package.DAT2RSV
    uhs1.cd_data3 ~ package.CDDAT3CS
    uhs1.gnd ~ package.GND

# Push Pull
