    """

    """

module SDReceptacle:
    sdbus = new SDBus

# module SDAssemblyMicroSD from SDAssembly:
#     receptacle = new Korean_Hroparts_Elec_TF_01A_model
#     low ~ receptacle.sdbus

module _SD:
    sdbus = new SDBus
    power = new ElectricPower

module SD4bit_:
    card = new _SD

    sd_4bit = new SD4bit
    sd_4bit.clk ~ card.sdbus.CLK
    sd_4bit.cmd ~ card.sdbus.CMD
    sd_4bit.data0 ~ card.sdbus.DAT0
    sd_4bit.data1 ~ card.sdbus.DAT1
    sd_4bit.data2 ~ card.sdbus.DAT2
    sd_4bit.cd_data3 ~ card.sdbus.CD_DAT3
    sd_4bit.gnd ~ card.power.gnd

module SDUHS1:
    card = new _SD

    uhs1 = new UHS1
    uhs1.clk ~ card.sdbus.CLK
    uhs1.cmd ~ card.sdbus.CMD
    uhs1.data0 ~ card.sdbus.DAT0
    uhs1.data1 ~ card.sdbus.DAT1
    uhs1.data2 ~ card.sdbus.DAT2
    uhs1.cd_data3 ~ card.sdbus.CD_DAT3
    uhs1.gnd ~ card.power.gnd

# SD Card interfaces
interface SDBus:
    signal CD_DAT3
    signal CMD
    signal VSS1
    signal VDD
    signal CLK
    signal VSS2
    signal DAT0
    signal DAT1
    signal DAT2
    signal WP # Write protect
    signal CD # Card detect

interface SD4bit:
    signal data0
    signal data1
    signal data2
    signal cd_data3
    signal clk
    signal cmd
    signal gnd

# UHS-1 104Mbps
# UHS-2 312Mbps
# UHS-3 624Mbps
interface UHS1:
    signal data0
    signal data1
    signal data2
    signal cd_data3
    signal clk
    signal cmd
    signal gnd

interface UHS2:
    pass

interface UHS3:
    pass

interface SDExpress:
    pass
    # PCIe

#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import Resistor
import Capacitor
from "parts/Korean_Hroparts_Elec_TF_01A/Korean_Hroparts_Elec_TF_01A_driver.ato" import Korean_Hroparts_Elec_TF_01A_model

module VirtualMicroController:
    spi = new SPI
    gpio = new ElectricLogic
    power = new ElectricPower

module PushPushMicroSDSPI_Example:
    microcontroller = new VirtualMicroController
    micro_sd_card = new MicroSDCardAssemblyWithRemovableSPI

    # Connect micro SD Card
    micro_sd_card.spi ~ microcontroller.spi
    micro_sd_card.spi_cs ~ microcontroller.gpio
    micro_sd_card.power ~ microcontroller.power

    micro_sd_card.receptacle -> Korean_Hroparts_Elec_TF_01A_model
