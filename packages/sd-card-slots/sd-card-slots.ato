import SPI
import ElectricPower
import ElectricSignal
import ElectricLogic

import can_bridge_by_name

from "parts/XUNPU_SD_102/XUNPU_SD_102_driver.ato" import XUNPU_SD_102_driver
from "parts/Korean_Hroparts_Elec_TF_01A/Korean_Hroparts_Elec_TF_01A_driver.ato" import Korean_Hroparts_Elec_TF_01A_driver
from "parts/SOFNG_SD_006M/SOFNG_SD_006M_driver.ato" import SOFNG_SD_006M_driver

module SDSlot:
    sdbus = new SDBus

module MicroSDSlot from SDSlot:
    mech_receptacle = new SDMicroSlotMechanicalInterface

module StandardSDSlot from SDSlot:
    mech_receptacle = new SDStandardSlotMechanicalInterface

module SDSlotDriver:
    """
    SD Card driver module, provides common implementation shared by SD cards.
    """
    sd_card_interface = new SDInterface
    bypass_cap = new Capacitor
    bypass_cap.capacitance = 100 nF +/- 20%
    bypass_cap.package = "C0402"
    bypass_cap.power ~ sd_card_interface.power

module SDSPI:
    card = new SDSlot # Replace with sd card driver instance

    spi = new SPI
    spi_cs = new ElectricSignal
    card.power ~ spi.sclk.reference
    spi.miso.line ~ card.sdbus.DAT0
    spi.mosi.line ~ card.sdbus.CMD
    spi.sclk.line ~ card.sdbus.CLK
    spi_cs.line ~ card.sdbus.CD_DAT3

module SD:
    """
    SD Card module, provides common implementation shared by SD cards.
    """
    mech_card = new SDMicroSlotMechanicalInterface

interface SDMicroSlotMechanicalInterface:
    pass

interface SDStandardSlotMechanicalInterface:
    pass

interface SDProtocol:
    pass

module SDTransit:
    low = new SDLogical
    high = new SDProtocol

    trait can_bridge_by_name<input_name="low", output_name="high">

module SDTransitSPI from SDTransit:
    spi = new SPI
    spi_cs = new ElectricSignal

    spi.clk ~ SDLogical.clock
    spi.miso ~ SDLogical.data
    spi.mosi ~ SDLogical.command
    spi_cs ~ SDLogical.chip_select






interface SDLogical:
    # This is NOW being used as an SD card
    power = new ElectricPower
    card_detect = new ElectricLogic
    write_protect = new ElectricLogic
    data = new ElectricLogic[4]
    clock = new ElectricLogic
    chip_select = new ElectricLogic
    command = new ElectricLogic

module SDAssembly:
    """
    Assembly has both a receptacle and a theoretical SD card in it and nothing else captured as design intent in the model
    We allow anything that behaves as an SD card, limited by the set of existing operational SD cards, as long as it behaves like an sd card.
    """
    low = new SDBus
    # DRIVER CIRCUITRY
    bypass_cap = new Capacitor # Are these needed on EEMC? Maybe only in socketed version
    bypass_cap.capacitance = 100 nF +/- 20%
    bypass_cap.package = "C0402"
    bypass_cap.power ~ sd_card_interface.power

module SDAssemblySocketed from SDAssembly:
    """

    """

module SDReceptacle:
    sdbus = new SDBus

module SDAssemblyMicroSD from SDAssembly:
    receptacle = new Korean_Hroparts_Elec_TF_01A_model
    low ~ receptacle.sdbus


module SD4bit:
    card = new _SD

    sd_4bit = new SD4bit
    sd_4bit.clk ~ card.sdbus.CLK
    sd_4bit.cmd ~ card.sdbus.CMD
    sd_4bit.data0 ~ card.sdbus.DAT0
    sd_4bit.data1 ~ card.sdbus.DAT1
    sd_4bit.data2 ~ card.sdbus.DAT2
    sd_4bit.cd_data3 ~ card.sdbus.CD_DAT3
    sd_4bit.gnd ~ card.power.gnd

module SDUHS1:
    card = new _SD

    uhs1 = new UHS1
    uhs1.clk ~ card.sdbus.CLK
    uhs1.cmd ~ card.sdbus.CMD
    uhs1.data0 ~ card.sdbus.DAT0
    uhs1.data1 ~ card.sdbus.DAT1
    uhs1.data2 ~ card.sdbus.DAT2
    uhs1.cd_data3 ~ card.sdbus.CD_DAT3
    uhs1.gnd ~ card.power.gnd

# SD Card interfaces
interface SDBus:
    signal CD_DAT3
    signal CMD
    signal VSS1
    signal VDD
    signal CLK
    signal VSS2
    signal DAT0
    signal DAT1
    signal DAT2
    signal WP # Write protect
    signal CD # Card detect


interface SD4bit:
    signal data0
    signal data1
    signal data2
    signal cd_data3
    signal clk
    signal cmd
    signal gnd

# UHS-1 104Mbps
# UHS-2 312Mbps
# UHS-3 624Mbps
interface UHS1:
    signal data0
    signal data1
    signal data2
    signal cd_data3
    signal clk
    signal cmd
    signal gnd

interface UHS2:
    pass

interface UHS3:
    pass

interface SDExpress:
    pass
    # PCIe

#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
import Resistor, Capacitor
from "atopile/esp32/esp32_c3.ato" import ESP32_C3_WROOM
# from "atopile/sd-card-slots/sd-card-slots.ato" import PushPushMicroSDSPI
from "atopile/usb-connectors/usb-connectors.ato" import USBCConn
from "atopile/ti-tlv75901/ti-tlv75901.ato" import TLV75901_driver

module PushPushMicroSDSPI_Example:
    esp32 = new ESP32_C3_WROOM
    sd_card = new PushPullSDSPI
    micro_sd_card = new PushPushMicroSDSPI
    usbc = new USBCConn
    ldo_3v3 = new TLV75901_driver

    # Configure LDO
    ldo_3v3.v_in = 5V +/- 5%
    ldo_3v3.v_out = 3.3V +/- 3%

    # Connect USB
    usbc.usb2 ~ esp32.usb2
    usbc.usb2.usb_if.buspower ~> ldo_3v3 ~> esp32.power

    # Connect SD Card
    sd_card.spi ~ esp32.spi[2]
    sd_card.spi_cs ~ esp32.spi_cs[2]
    sd_card.power ~ esp32.power
    pullups = new Resistor[3]
    for pullup in pullups:
        pullup.resistance = 10 kohm +/- 5%
        pullup.package = "R0402"
    sd_card.spi.miso.line ~> pullups[0] ~> esp32.power.hv
    sd_card.spi.mosi.line ~> pullups[1] ~> esp32.power.hv
    sd_card.spi.sclk.line ~> pullups[2] ~> esp32.power.hv

    # Connect micro SD Card
    micro_sd_card.spi ~ esp32.spi[2]
    micro_sd_card.spi_cs ~ esp32.gpios[3]
    micro_sd_card.power ~ esp32.power
    micro_pullups = new Resistor[3]
    for pullup in micro_pullups:
        pullup.resistance = 10 kohm +/- 5%
        pullup.package = "R0402"
    micro_sd_card.spi.miso.line ~> micro_pullups[0] ~> esp32.power.hv
    micro_sd_card.spi.mosi.line ~> micro_pullups[1] ~> esp32.power.hv
    micro_sd_card.spi.sclk.line ~> micro_pullups[2] ~> esp32.power.hv
