module SDSlot:
    sdbus = new SDBus

module MicroSDSlot from SDSlot:
    mech_receptacle = new SDMicroSlotMechanicalInterface

module StandardSDSlot from SDSlot:
    mech_receptacle = new SDStandardSlotMechanicalInterface

module SDSlotDriver:
    """
    SD Card driver module, provides common implementation shared by SD cards.
    """
    sd_card_interface = new SDLogical
    bypass_cap = new Capacitor
    bypass_cap.capacitance = 100 nF +/- 20%
    bypass_cap.package = "C0402"
    bypass_cap.power ~ sd_card_interface.power

