#pragma experiment("FOR_LOOP")

from "sd-card-slots.ato" import _SDCard
from "sd-card-slots.ato" import SDCardDriver

from "parts/XUNPU_SD_102/XUNPU_SD_102.ato" import XUNPU_SD_102_package

module XUNPU_SD_102_driver from _SDCard:
    """
    Driver for XUNPU_SD_102 microSD card slot with SDBus Interface

    Push pull standard/Full-size SD card slot
    """
    package = new XUNPU_SD_102_package
    driver = new SDCardDriver
    driver.card_power ~ power

    sdbus.CD_DAT3 ~ package.CD_DAT3
    sdbus.CMD ~ package.CMD
    sdbus.VSS1 ~ package.VSS1
    sdbus.VDD ~ package.VDD
    sdbus.CLK ~ package.CLK
    sdbus.VSS2 ~ package.VSS2
    sdbus.DAT0 ~ package.DAT0
    sdbus.DAT1 ~ package.DAT1
    sdbus.DAT2 ~ package.DAT2
