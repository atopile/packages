#pragma experiment("TRAITS")
import has_designator_prefix
import is_atomic_part
import has_part_removed
import has_part_picked

component atopile_Logo_4x4mm_package:
    """atopile Logo 4x4mm"""

    trait is_atomic_part<manufacturer="atopile", partnumber="Logo_4x4mm", footprint="atopile_Logo_4x4mm.kicad_mod", symbol="atopile_Logo_4x4mm.kicad_sym">
    trait has_designator_prefix<prefix="LOGO">
    trait has_part_removed

    has_part_picked = False
