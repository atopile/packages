#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import ElectricPower
import I2C
import Capacitor
import Resistor
import Crystal_Oscillator
import ElectricLogic
import DifferentialPair
import Electrical

from "parts/NXP_Semicon_PN5321A3HN_C106_51/NXP_Semicon_PN5321A3HN_C106_51.ato" import NXP_Semicon_PN5321A3HN_C106_51_package
from "parts/Murata_Electronics_LQW18CNR56J00D/Murata_Electronics_LQW18CNR56J00D.ato" import Murata_Electronics_LQW18CNR56J00D_driver
from "parts/Yangxing_Tech_X32252712MSB4SI/Yangxing_Tech_X32252712MSB4SI.ato" import Yangxing_Tech_X32252712MSB4SI_driver

module NXP_PN5321_driver:

    package = new NXP_Semicon_PN5321A3HN_C106_51_package

    tx1_inductor = new Murata_Electronics_LQW18CNR56J00D_driver
    tx2_inductor = new Murata_Electronics_LQW18CNR56J00D_driver
    tx1_series_capacitor = new Capacitor
    tx2_series_capacitor = new Capacitor
    tx1_decouple_capacitor = new Capacitor
    tx2_decouple_capacitor = new Capacitor
    tx1_mid_decouple_capacitor = new Capacitor
    tx2_mid_decouple_capacitor = new Capacitor
    rx_capacitor = new Capacitor
    rx_resistor = new Resistor
    vmid_resistor = new Resistor
    oscillator = new Yangxing_Tech_X32252712MSB4SI_driver

    reset = new ElectricLogic
    interrupt = new ElectricLogic
    antenna_output = new DifferentialPair
    i2c = new I2C
    power_3v3 = new ElectricPower
    power_tvdd = new ElectricPower
    power_vbat = new ElectricPower
    power_dvdd = new ElectricPower
    power_pvdd = new ElectricPower
    power_avdd = new ElectricPower
    power_svdd = new ElectricPower
    power_vmid = new ElectricPower

    # All power rails connected to 3v3 (external power supply)
    for rail in [power_3v3, power_tvdd, power_vbat, power_dvdd, power_pvdd, power_avdd, power_svdd]:
        rail ~ power_3v3

    # Connect power rails to IC
    power_dvdd.vcc ~ package.DVDD
    power_dvdd.gnd ~ package.DVSS
    power_dvdd.gnd ~ package.EP
    power_tvdd.vcc ~ package.TVDD
    power_tvdd.gnd ~ package.TVSS1
    power_tvdd.gnd ~ package.TVSS2
    power_pvdd.vcc ~ package.PVDD
    power_pvdd.gnd ~ package.DVSS
    power_avdd.vcc ~ package.AVDD
    power_avdd.gnd ~ package.AVSS
    power_svdd.vcc ~ package.SVDD
    power_svdd.gnd ~ package.DVSS
    power_vmid.vcc ~ package.VMID
    power_vmid.gnd ~ package.DVSS
    power_vbat.vcc ~ package.VBAT
    power_vbat.gnd ~ package.DVSS

    # Decoupling caps for power rails
    vbat_cap = new Capacitor
    vbat_cap.capacitance = 100nF +/- 20%
    vbat_cap.package = "C0402"
    power_vbat.vcc ~> vbat_cap ~> power_vbat.gnd

    svdd_cap = new Capacitor
    svdd_cap.capacitance = 100nF +/- 20%
    svdd_cap.package = "C0402"
    power_svdd.vcc ~> svdd_cap ~> power_svdd.gnd

    avdd_cap = new Capacitor
    avdd_cap.capacitance = 100nF +/- 20%
    avdd_cap.package = "C0402"
    power_avdd.vcc ~> avdd_cap ~> power_avdd.gnd

    pvdd_cap = new Capacitor
    pvdd_cap.capacitance = 100nF +/- 20%
    pvdd_cap.package = "C0402"
    power_pvdd.vcc ~> pvdd_cap ~> power_pvdd.gnd

    dvdd_cap = new Capacitor
    dvdd_cap.capacitance = 100nF +/- 20%
    dvdd_cap.package = "C0402"
    power_dvdd.vcc ~> dvdd_cap ~> power_dvdd.gnd

    vmid_cap = new Capacitor
    vmid_cap.capacitance = 100nF +/- 20%
    vmid_cap.package = "C0402"
    power_vmid.vcc ~> vmid_cap ~> power_vmid.gnd

    power_tvdd_caps = new Capacitor[2]
    power_tvdd_caps[0].capacitance = 10uF +/- 20%
    power_tvdd_caps[0].package = "C0603"
    power_tvdd_caps[1].capacitance = 100nF +/- 20%
    power_tvdd_caps[1].package = "C0402"

    for cap in power_tvdd_caps:
        power_tvdd.vcc ~> cap ~> power_tvdd.gnd

    power_dvdd_caps = new Capacitor[2]
    power_dvdd_caps[0].capacitance = 10uF +/- 20%
    power_dvdd_caps[0].package = "C0603"
    power_dvdd_caps[1].capacitance = 100nF +/- 20%
    power_dvdd_caps[1].package = "C0402"

    for cap in power_dvdd_caps:
        power_dvdd.vcc ~> cap ~> power_dvdd.gnd

    # Antenna
    tx1_mid = new Electrical
    tx1_mid.override_net_name = "tx_1_mid"
    tx1_mid ~> tx1_series_capacitor ~> antenna_output.p.line

    tx1_mid ~> tx1_inductor ~> package.TX1
    tx1_mid ~> tx1_mid_decouple_capacitor ~> power_tvdd.gnd
    antenna_output.p.line ~> tx1_decouple_capacitor ~> power_tvdd.gnd

    tx2_mid = new Electrical
    tx2_mid.override_net_name = "tx_2_mid"
    tx2_mid ~> tx2_series_capacitor ~> antenna_output.n.line
    tx2_mid ~> tx2_inductor ~> package.TX2
    tx2_mid ~> tx2_mid_decouple_capacitor ~> power_tvdd.gnd
    antenna_output.n.line ~> tx2_decouple_capacitor ~> power_tvdd.gnd
    tx2_mid ~> rx_capacitor ~> package.RX
    tx2_mid ~> rx_resistor ~> package.RX

    power_vmid.hv ~> vmid_resistor ~> package.RX


    # Interrupt and reset
    interrupt.line ~ package.P70_IRQ
    interrupt.reference ~ power_3v3
    reset.line ~ package.RSTOUT_N
    reset.reference ~ power_3v3

    # I2C
    i2c.scl.line ~ package.MOSI_SDA_HSU_TX
    i2c.scl.reference ~ power_3v3
    i2c.sda.line ~ package.NSS_P50_SCL_HSU_RX
    i2c.sda.reference ~ power_3v3

    # Select communication mode
    # I2C = I0: 1, I1: 0 - Default
    # UART = I0: 0, I1: 0
    # SPI = I0: 0, I1: 1
    package.I0 ~ power_3v3.hv
    package.I1 ~ power_3v3.lv

    # Oscillator
    package.OSCIN ~> oscillator ~> package.OSCOUT
    power_3v3.gnd ~ oscillator.gnd

    # Antenna components
    tx1_series_capacitor.package = "C0402"
    tx2_series_capacitor.package = "C0402"
    tx1_mid_decouple_capacitor.package = "C0402"
    tx2_mid_decouple_capacitor.package = "C0402"
    tx1_decouple_capacitor.package = "C0402"
    tx2_decouple_capacitor.package = "C0402"
    rx_capacitor.package = "C0402"
    vmid_resistor.package = "R0402"
    rx_resistor.package = "R0402"

    tx1_mid_decouple_capacitor.capacitance = 220pF +/- 20%
    tx2_mid_decouple_capacitor.capacitance = 220pF +/- 20%
    tx1_decouple_capacitor.capacitance = 100pF +/- 20%
    tx2_decouple_capacitor.capacitance = 100pF +/- 20%
    rx_capacitor.capacitance = 100nF +/- 20%
    vmid_resistor.resistance = 1kohm +/- 5%
    rx_resistor.resistance = 1kohm +/- 5%

    # TESTEN
    package.TESTEN ~ power_3v3.gnd
