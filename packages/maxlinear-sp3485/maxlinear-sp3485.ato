#pragma experiment("BRIDGE_CONNECT")

import ElectricPower
import ElectricLogic
import DifferentialPair
import Capacitor
import UART_Base

# Autogenerated part expected after installing JLCPCB part C8963
# Directory and filename follow existing patterns (underscores for special chars)
from "parts/MaxLinear_SP3485EN_L_TR/MaxLinear_SP3485EN_L_TR.ato" import MaxLinear_SP3485EN_L_TR_package


module MaxLinear_SP3485:
  """
  MaxLinear SP3485EN-L/TR — 3.3V low-power half-duplex RS-485 transceiver (up to 10 Mbps).
  Exposes UART-side logic, driver/receiver enables, and the RS-485 A/B bus.
  """

  # --- External interfaces ---
  power = new ElectricPower
  """
  Primary 3.3V supply for the transceiver.
  """
  power.required = True
  assert power.voltage within 3V to 3.6V

  uart = new UART_Base
  """
  UART interface for microcontroller connection
  """
  uart.tx.reference ~ power
  uart.rx.reference ~ power

  driver_enable = new ElectricLogic
  """
  Driver enable (DE). High enables the driver onto the bus.
  """
  driver_enable.reference ~ power

  n_receiver_enable = new ElectricLogic
  """
  Receiver enable (RE). Active-low: low enables receiver output on RO.
  """
  n_receiver_enable.reference ~ power

  rs485_bus = new DifferentialPair
  """
  RS-485 differential bus. p -> A, n -> B.
  """
  rs485_bus.reference_shim ~ power

  # --- Decoupling capacitors ---
  vcc_decoupling = new Capacitor
  vcc_decoupling.capacitance = 100nF +/- 20%
  vcc_decoupling.package = "0402"
  power.hv ~> vcc_decoupling ~> power.lv

  # --- Package (physical part) ---
  package = new MaxLinear_SP3485EN_L_TR_package

  # Power
  package.VCC ~ power.hv
  package.GND ~ power.lv

  # UART side
  package.DI ~ uart.tx.line
  package.RO ~ uart.rx.line
  package.DE ~ driver_enable.line
  package.nRE ~ n_receiver_enable.line

  # RS-485 bus side
  package.A ~ rs485_bus.p.line
  package.B ~ rs485_bus.n.line
