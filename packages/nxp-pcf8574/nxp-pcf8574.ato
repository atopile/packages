#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

# --- Imports ---
import ElectricPower
import I2C
import ElectricLogic
import Capacitor
import Resistor
import Addressor

from "parts/NXP_Semicon_PCF8574AT_3_518/NXP_Semicon_PCF8574AT_3_518.ato" import NXP_Semicon_PCF8574AT_3_518_package

module NXP_PCF8574:
    """
    Driver for NXP PCF8574 8-bit I²C GPIO expander.

    Exposes:
      * power        – Single-rail supply (2.5 V – 6.0 V)
      * i2c          – I²C bus interface (base address 0x20)
      * interrupt    – Interrupt output (active low, open-drain)
      * gpio[0:7]    – 8-bit GPIO lines (P0-P7)
    """

    # --- Package ---
    package = new NXP_Semicon_PCF8574AT_3_518_package

    # --- External interfaces ---
    power = new ElectricPower
    power.required = True
    assert power.voltage within 2.5V to 6.0V

    i2c = new I2C
    i2c.required = True

    interrupt = new ElectricLogic

    gpio = new ElectricLogic[8]

    # --- I²C bus ---
    i2c_pullups = new Resistor[2]
    for r in i2c_pullups:
        r.resistance = 10kohm +/- 10%
        r.package = "0402"

    i2c.scl.line ~> i2c_pullups[0] ~> power.hv
    i2c.sda.line ~> i2c_pullups[1] ~> power.hv
    i2c.scl.reference ~ power
    i2c.sda.reference ~ power

    # --- Address selection (A2:A1:A0) ---
    addressor = new Addressor<address_bits=3>
    addressor.base = 0x20  # 0x20–0x27 for PCF8574
    package.A0 ~ addressor.address_lines[0].line
    package.A1 ~ addressor.address_lines[1].line
    package.A2 ~ addressor.address_lines[2].line
    for addr_line in addressor.address_lines:
        addr_line.reference ~ power
    assert addressor.address is i2c.address
    # Default to base address (0x20), can be overridden by user
    i2c.address.default = 0x20

    # --- Interrupt line ---
    interrupt.reference ~ power

    # --- Interrupt pull-up ---
    interrupt_pullup = new Resistor
    interrupt_pullup.resistance = 10kohm +/- 10%
    interrupt_pullup.package = "0402"
    interrupt.line ~> interrupt_pullup ~> power.hv

    # --- Decoupling capacitors ---
    decoup = new Capacitor
    decoup.capacitance = 100nF +/- 20%
    decoup.package = "0402"
    power.hv ~> decoup ~> power.lv

    # --- Reference each GPIO line to the power rail ---
    for gpio_pin in gpio:
        gpio_pin.reference ~ power

    # --- Package connections ---
    package.VDD ~ power.hv
    package.VSS ~ power.lv
    package.SCL ~ i2c.scl.line
    package.SDA ~ i2c.sda.line
    package.nINT ~ interrupt.line
    package.P0 ~ gpio[0].line
    package.P1 ~ gpio[1].line
    package.P2 ~ gpio[2].line
    package.P3 ~ gpio[3].line
    package.P4 ~ gpio[4].line
    package.P5 ~ gpio[5].line
    package.P6 ~ gpio[6].line
    package.P7 ~ gpio[7].line
