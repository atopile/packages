#pragma experiment("TRAITS")
#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("FOR_LOOP")
#pragma experiment("BRIDGE_CONNECT")
import I2C
import Addressor
import Capacitor
import Resistor
import ElectricPower
import ElectricLogic

from "parts/MICROCHIP_TECHNOLOGY_MCP9601_E_MX/MICROCHIP_TECHNOLOGY_MCP9601_E_MX.ato" import MICROCHIP_TECHNOLOGY_MCP9601_E_MX_package

module Microchip_MCP9601:
    """
    Microchip MCP9601 thermocouple EMF to temperature converter

    Features:
    - Thermocouple EMF to °C converter with integrated cold-junction compensation
    - Supports 8 thermocouple types: K, J, T, N, S, E, B, R
    - Temperature accuracy: ±0.5°C (typical), ±1.5°C (maximum)
    - Operating voltage: 2.7V to 5.5V
    - Low power consumption: 300µA (typical operation), 2µA (shutdown)
    - Open-circuit and short-circuit detection (MCP9601 feature)
    - 4 programmable temperature alert outputs
    - 18-bit ADC with selectable resolution (12-18 bit)
    - I2C interface with 8 possible addresses (0x60-0x67)
    - Digital filtering and burst mode capability
    - Package: 20-Lead MQFN
    """

    # --- Package instantiation and connections ---
    package = new MICROCHIP_TECHNOLOGY_MCP9601_E_MX_package

    # --- External interfaces ---
    power = new ElectricPower
    """
    Main power supply for the thermocouple amplifier
    """
    power.required = True
    assert power.voltage within 2.7V to 5.5V

    i2c = new I2C
    """
    I²C bus interface (7-bit addr 0x60 to 0x67)
    """
    i2c.required = True
    i2c.reference_shim ~ power

    # --- Thermocouple differential inputs ---
    thermocouple_positive = new ElectricLogic
    """
    Thermocouple positive input (VIN+)
    """
    thermocouple_positive.reference ~ power

    thermocouple_negative = new ElectricLogic
    """
    Thermocouple negative input (VIN-)
    """
    thermocouple_negative.reference ~ power

    # --- Alert outputs (4 programmable + 2 fault detection) ---
    alert1 = new ElectricLogic
    """
    Programmable temperature alert output 1
    """
    alert1.reference ~ power

    alert2 = new ElectricLogic
    """
    Programmable temperature alert output 2
    """
    alert2.reference ~ power

    alert3 = new ElectricLogic
    """
    Programmable temperature alert output 3
    """
    alert3.reference ~ power

    alert4 = new ElectricLogic
    """
    Programmable temperature alert output 4
    """
    alert4.reference ~ power

    # --- MCP9601 specific: open/short-circuit detection outputs ---
    oc_alert = new ElectricLogic
    """
    Open-Circuit detection alert output (MCP9601 feature)
    """
    oc_alert.reference ~ power

    sc_alert = new ElectricLogic
    """
    Short-Circuit detection alert output (MCP9601 feature)
    """
    sc_alert.reference ~ power

    vsense = new ElectricLogic
    """
    Thermocouple fault detection sense input (for open/short detection)
    """
    vsense.reference ~ power

    # --- I²C address configuration ---
    """
    I2C Address Configuration via Resistor Divider Network

    The MCP9601 supports 8 I2C addresses (0x60 to 0x67) using a single ADDR pin
    with resistor voltage dividers. Connect the ADDR pin as follows:

    Address | Configuration
    --------|-------------
    0x60    | ADDR pin to GND via 0Ω resistor (allows easy address changes)
    0x61    | ADDR pin to voltage divider: R1=10kΩ to VDD, R2=2.2kΩ to GND
    0x62    | ADDR pin to voltage divider: R1=10kΩ to VDD, R2=4.3kΩ to GND
    0x63    | ADDR pin to voltage divider: R1=10kΩ to VDD, R2=7.5kΩ to GND
    0x64    | ADDR pin to voltage divider: R1=10kΩ to VDD, R2=13kΩ to GND
    0x65    | ADDR pin to voltage divider: R1=10kΩ to VDD, R2=22kΩ to GND
    0x66    | ADDR pin to voltage divider: R1=10kΩ to VDD, R2=43kΩ to GND
    0x67    | ADDR pin tied to VDD

    For multiple MCP9601 devices on the same I2C bus, use different addresses.
    Standard 5% tolerance resistors are sufficient, though 1% provides better matching.
    """
    i2c.address = 0x60

    # Address selection resistor (0Ω to GND for address 0x60)
    addr_resistor = new Resistor
    addr_resistor.resistance = 0ohm +/- 0.1ohm
    addr_resistor.package = "0402"

    # I2C pull-up resistors (soft pullups for robustness)
    i2c_pullups = new Resistor[2]
    for r in i2c_pullups:
        r.resistance = 10kohm +/- 1%
        r.package = "0402"
    i2c.scl.line ~> i2c_pullups[0] ~> i2c.scl.reference.hv
    i2c.sda.line ~> i2c_pullups[1] ~> i2c.sda.reference.hv

    # --- Decoupling capacitors ---
    power_caps = new Capacitor[2]
    for capacitor in power_caps:
        capacitor.capacitance = 100nF +/- 20%
        capacitor.package = "0402"
        power.hv ~> capacitor ~> power.lv

    # Power connections
    package.VDD ~ power.hv
    package.GND ~ power.lv
    package.EP ~ power.lv  # Exposed pad to ground

    # Thermocouple inputs
    package.VINpos ~ thermocouple_positive.line
    package.VINneg ~ thermocouple_negative.line

    # I2C connections
    package.SCL ~ i2c.scl.line
    package.SDA ~ i2c.sda.line
    package.ADDR ~> addr_resistor ~> power.lv  # ADDR to GND via 0Ω resistor for address 0x60

    # Alert outputs
    package.Alert1 ~ alert1.line
    package.Alert2 ~ alert2.line
    package.Alert3 ~ alert3.line
    package.Alert4 ~ alert4.line

    # Fault detection (MCP9601 specific features)
    package.OCAlert ~ oc_alert.line
    package.SCAlert ~ sc_alert.line
    package.VSENSE ~ vsense.line
