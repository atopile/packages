#pragma experiment("TRAITS")

import I2S
import PDM
import ElectricSignal
import ElectricPower
import has_single_electric_reference
import has_part_removed

module Microphone:
    """
    Microphone base class
    """
    trait has_part_removed

module MicrophoneAnalog from Microphone:
    """
    Microphone with pre-amplified analog interface
    """
    power = new ElectricPower
    power.required = True
    analog = new ElectricSignal
    analog.required = True

module MicrophoneI2S from Microphone:
    """
    Microphone with I2S interface
    """
    i2s = new I2S
    power = new ElectricPower
    i2s.required = True
    power.required = True

    trait has_single_electric_reference

module MicrophonePDM from Microphone:
    """
    Microphone with PDM interface
    """
    pdm = new PDM
    power = new ElectricPower
    pdm.required = True
    power.required = True

    trait has_single_electric_reference
