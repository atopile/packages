#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
import has_single_electric_reference_shared
import Capacitor
import ElectricPower
import I2S

from "microphone.ato" import MicrophoneI2S

from "parts/KNOWLES_SPH0641LU4H_1/KNOWLES_SPH0641LU4H_1.ato" import KNOWLES_SPH0641LU4H_1_package

module Knowles_SPH0641LU4H_1_driver from MicrophoneI2S:
    """
    The SPH0645LM4H-B is a miniature, low power, bottom port microphone with an I2S digital output.
    The solution consists of a proven high performance SiSonic™ acoustic sensor, a serial Analog to
    Digital convertor, and an interface to condition the signal into an industry standard 24 bits I2S
    format. The I2S interface simplifies the integration in the system and allow direct interconnect to
    digital processors, application processors and microcontroller. Saving the need of an external audio
    codec, the SPH0645LM4H-B is perfectly suitable for portable applications where size and power
    consumption are a constraint.
    """
    package = new KNOWLES_SPH0641LU4H_1_package

    assert power.voltage within 1.62V to 3.6V
    assert i2s.sample_rate within 32 kHz to 64 kHz
    assert i2s.bit_depth is 24 bit # 18bit precision, the LSBs are filled with zeros

    power.hv ~ package.VDD
    power.lv ~ package.GROUND
    i2s.sck.line ~ package.CLOCK
    i2s.ws.line ~ package.SELECT
    i2s.sd.line ~ package.DATA

    decoupling_capacitor = new Capacitor
    decoupling_capacitor.package = "C0402"
    # assert decoupling_capacitor.temperature_coefficient is "C0G" # should specify C0G to avoid piezoelectric affect according to datasheet
    assert decoupling_capacitor.max_voltage >= power.voltage * 1.5
    assert decoupling_capacitor.capacitance within 100 nF +/- 30%
    power.hv ~> decoupling_capacitor ~> power.lv

    rf_filter_capacitor = new Capacitor
    rf_filter_capacitor.package = "C0402"
    assert rf_filter_capacitor.max_voltage >= power.voltage * 1.5
    assert rf_filter_capacitor.capacitance within 200 pF +/- 30%
    power.hv ~> rf_filter_capacitor ~> power.lv

module Knowles_SPH0641LU4H_1_example:
    """
    Minimal example of how to use the Knowles SPH0641LU4H I2S microphone.
    """
    #from "atopile/microphones/knowles_sph0641lu4h_1.ato" import Knowles_SPH0641LU4H_1_driver

    microphone = new Knowles_SPH0641LU4H_1_driver

    power_3v3 = new ElectricPower
    power_3v3 ~ microphone.power

    i2s = new I2S
    i2s ~ microphone.i2s
