import ElectricPower
import ElectricSignal
import Electrical

from "parts/ALPSALPINE_RS60N11M9A0F/ALPSALPINE_RS60N11M9A0F.ato" import ALPSALPINE_RS60N11M9A0F_package

module AlpsAlpine_RS60N11M9A0F:
    """
    AlpsAlpine RS60N11M9A0F motorized fader with touch sense.
    """
    # motor
    motor_positive = new Electrical
    motor_positive.required = True
    motor_negative = new Electrical
    motor_negative.required = True

    motor_rated_voltage: V
    assert motor_rated_voltage <= 10V +/- 10%

    motor_rated_current: A
    assert motor_rated_current <= 800mA

    # potentiometer
    potentiometer_signal = new ElectricSignal
    """
    Signal from the potentiometer.
    """
    potentiometer_signal.required = True
    assert potentiometer_signal.reference.voltage <= 10V

    touch_sense = new ElectricSignal
    """
    Touch sense signal (for making the fader knob touch sensitive)
    """

    # --- Package Connections ---
    package = new ALPSALPINE_RS60N11M9A0F_package

    # Motor
    motor_positive ~ package.A
    motor_negative ~ package.B

    # Potentiometer
    potentiometer_signal.reference.hv ~ package.3
    potentiometer_signal.line ~ package.2
    potentiometer_signal.reference.lv ~ package.1

    # Touch Sense
    touch_sense.line ~ package.T
