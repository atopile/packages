import ElectricPower
import ElectricSignal

from "parts/ALPSALPINE_RS60N11M9A0F/ALPSALPINE_RS60N11M9A0F.ato" import ALPSALPINE_RS60N11M9A0F_package

module AlpsAlpine_RS60N11M9A0F:
    # --- Package ---
    package = new ALPSALPINE_RS60N11M9A0F_package

    # --- External Interfaces ---
    motor_drive_p = new ElectricSignal
    motor_drive_n = new ElectricSignal
    motor_power = new ElectricPower
    """
    Positive and negative drive signals to the DC motor.
    """
    motor_drive_p.required = True
    motor_drive_n.required = True

    potentiometer_power = new ElectricPower
    """
    Power supply for the potentiometer.
    """
    potentiometer_power.required = True
    assert potentiometer_power.voltage <= 40V

    potentiometer_sense = new ElectricSignal
    """
    Sense signal from the potentiometer.
    """
    potentiometer_sense.required = True

    touch_sense = new ElectricSignal
    """
    Touch sense signal from the touch sensor.
    """

    # --- Package Connections ---

    # Motor
    motor_drive_p.line ~ package.A
    motor_drive_n.line ~ package.B
    motor_power ~ motor_drive_p.reference
    motor_power ~ motor_drive_n.reference

    # Potentiometer
    potentiometer_power.hv ~ package.3
    potentiometer_sense.line ~ package.2
    potentiometer_power.lv ~ package.1
    potentiometer_sense.reference ~ potentiometer_power

    # Touch Sense
    touch_sense.line ~ package.T
