    connector.A60 ~ lanes[10].rx.p.line     # HSIp(10) - Lane 10 receive data +
    connector.A61 ~ lanes[10].rx.n.line     # HSIn(10) - Lane 10 receive data -
    connector.A62 ~ power.v12.lv            # Ground
    connector.A63 ~ power.v12.lv            # Ground
    connector.A64 ~ lanes[11].rx.p.line     # HSIp(11) - Lane 11 receive data +
