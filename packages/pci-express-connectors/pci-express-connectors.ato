    connector.A78 ~ power.v12.lv            # Ground
    connector.A79 ~ power.v12.lv            # Ground
    connector.A80 ~ lanes[15].rx.p.line     # HSIp(15) - Lane 15 receive data +
    connector.A81 ~ lanes[15].rx.n.line     # HSIn(15) - Lane 15 receive data -
    connector.A82 ~ power.v12.lv            # Ground

    # B-side pins (1-82)
    connector.B1 ~ power.v12.hv             # +12V
    connector.B2 ~ power.v12.hv             # +12V
    connector.B3 ~ power.v12.hv             # +12V
    connector.B4 ~ power.v12.lv             # Ground
    connector.B5 ~ smbus.scl.line           # SMCLK
    connector.B6 ~ smbus.sda.line           # SMDAT
    connector.B7 ~ power.v12.lv             # Ground
    connector.B8 ~ power.v3_3.hv            # +3.3V
    connector.B9 ~ jtag.n_trst.line         # TRST#
    connector.B10 ~ power.v3_3_aux.hv       # +3.3V aux
    connector.B11 ~ signals.wake.line       # WAKE#
    # Key notch
    # connector.B12 ~ signals.clkreq.line   # CLKREQ# (Clock Request Signal - optional)
    connector.B13 ~ power.v12.lv            # Ground
    connector.B14 ~ lanes[0].tx.p.line      # HSOp(0) - Lane 0 transmit data +
    connector.B15 ~ lanes[0].tx.n.line      # HSOn(0) - Lane 0 transmit data -
    connector.B16 ~ power.v12.lv            # Ground
    connector.B17 ~ signals.prsnt2.line     # PRSNT2#
    connector.B18 ~ power.v12.lv            # Ground
    connector.B19 ~ lanes[1].tx.p.line      # HSOp(1) - Lane 1 transmit data +
    connector.B20 ~ lanes[1].tx.n.line      # HSOn(1) - Lane 1 transmit data -
    connector.B21 ~ power.v12.lv            # Ground
    connector.B22 ~ power.v12.lv            # Ground
    connector.B23 ~ lanes[2].tx.p.line      # HSOp(2) - Lane 2 transmit data +
    connector.B24 ~ lanes[2].tx.n.line      # HSOn(2) - Lane 2 transmit data -
    connector.B25 ~ power.v12.lv            # Ground
    connector.B26 ~ power.v12.lv            # Ground
    connector.B27 ~ lanes[3].tx.p.line      # HSOp(3) - Lane 3 transmit data +
    connector.B28 ~ lanes[3].tx.n.line      # HSOn(3) - Lane 3 transmit data -
    connector.B29 ~ power.v12.lv            # Ground
    # connector.B30                         # PWRBRK# (Power Brake - optional)
    connector.B31 ~ signals.prsnt2.line     # PRSNT2#
    connector.B32 ~ power.v12.lv            # Ground
    connector.B33 ~ lanes[4].tx.p.line      # HSOp(4) - Lane 4 transmit data +
    connector.B34 ~ lanes[4].tx.n.line      # HSOn(4) - Lane 4 transmit data -
    connector.B35 ~ power.v12.lv            # Ground
    connector.B36 ~ power.v12.lv            # Ground
    connector.B37 ~ lanes[5].tx.p.line      # HSOp(5) - Lane 5 transmit data +
    connector.B38 ~ lanes[5].tx.n.line      # HSOn(5) - Lane 5 transmit data -
    connector.B39 ~ power.v12.lv            # Ground
    connector.B40 ~ power.v12.lv            # Ground
    connector.B41 ~ lanes[6].tx.p.line      # HSOp(6) - Lane 6 transmit data +
    connector.B42 ~ lanes[6].tx.n.line      # HSOn(6) - Lane 6 transmit data -
    connector.B43 ~ power.v12.lv            # Ground
    connector.B44 ~ power.v12.lv            # Ground
    connector.B45 ~ lanes[7].tx.p.line      # HSOp(7) - Lane 7 transmit data +
    connector.B46 ~ lanes[7].tx.n.line      # HSOn(7) - Lane 7 transmit data -
    connector.B47 ~ power.v12.lv            # Ground
    connector.B48 ~ signals.prsnt2.line     # PRSNT2#
    connector.B49 ~ power.v12.lv            # Ground
    connector.B50 ~ lanes[8].tx.p.line      # HSOp(8) - Lane 8 transmit data +
    connector.B51 ~ lanes[8].tx.n.line      # HSOn(8) - Lane 8 transmit data -
    connector.B52 ~ power.v12.lv            # Ground
    connector.B53 ~ power.v12.lv            # Ground
    connector.B54 ~ lanes[9].tx.p.line      # HSOp(9) - Lane 9 transmit data +
    connector.B55 ~ lanes[9].tx.n.line      # HSOn(9) - Lane 9 transmit data -
    connector.B56 ~ power.v12.lv            # Ground
    connector.B57 ~ power.v12.lv            # Ground
    connector.B58 ~ lanes[10].tx.p.line     # HSOp(10) - Lane 10 transmit data +
    connector.B59 ~ lanes[10].tx.n.line     # HSOn(10) - Lane 10 transmit data -
    connector.B60 ~ power.v12.lv            # Ground
    connector.B61 ~ power.v12.lv            # Ground
    connector.B62 ~ lanes[11].tx.p.line     # HSOp(11) - Lane 11 transmit data +
    connector.B63 ~ lanes[11].tx.n.line     # HSOn(11) - Lane 11 transmit data -
    connector.B64 ~ power.v12.lv            # Ground
    connector.B65 ~ power.v12.lv            # Ground
    connector.B66 ~ lanes[12].tx.p.line     # HSOp(12) - Lane 12 transmit data +
    connector.B67 ~ lanes[12].tx.n.line     # HSOn(12) - Lane 12 transmit data -
    connector.B68 ~ power.v12.lv            # Ground
    connector.B69 ~ power.v12.lv            # Ground
    connector.B70 ~ lanes[13].tx.p.line     # HSOp(13) - Lane 13 transmit data +
    connector.B71 ~ lanes[13].tx.n.line     # HSOn(13) - Lane 13 transmit data -
    connector.B72 ~ power.v12.lv            # Ground
    connector.B73 ~ power.v12.lv            # Ground
    connector.B74 ~ lanes[14].tx.p.line     # HSOp(14) - Lane 14 transmit data +
    connector.B75 ~ lanes[14].tx.n.line     # HSOn(14) - Lane 14 transmit data -
    connector.B76 ~ power.v12.lv            # Ground
    connector.B77 ~ power.v12.lv            # Ground
    connector.B78 ~ lanes[15].tx.p.line     # HSOp(15) - Lane 15 transmit data +
    connector.B79 ~ lanes[15].tx.n.line     # HSOn(15) - Lane 15 transmit data -
    connector.B80 ~ power.v12.lv            # Ground
    connector.B81 ~ signals.prsnt2.line     # PRSNT2#
    connector.B82 ~ power.v12.lv            # Ground

    # Power rail connections
    power.v3_3.lv ~ power.v12.lv; power.v3_3_aux.lv ~ power.v12.lv

    # Set power references
    for sig in [signals.prsnt1, signals.prsnt2, signals.perst, signals.wake, signals.refclk_p, signals.refclk_n]:
        sig.reference ~ power.v3_3

    for lane in lanes:
        lane.rx.p.reference_shim ~ power.v3_3; lane.rx.n.reference_shim ~ power.v3_3; lane.tx.p.reference_shim ~ power.v3_3; lane.tx.n.reference_shim ~ power.v3_3

    jtag.reference_shim ~ power.v3_3

    jtag.vtref ~ power.v3_3

    smbus.reference_shim ~ power.v3_3
