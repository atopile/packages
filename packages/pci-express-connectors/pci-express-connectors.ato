    connector.A21 ~ lanes[1].rx.p.line      # HSIp(1) - Lane 1 receive data +
    connector.A22 ~ lanes[1].rx.n.line      # HSIn(1) - Lane 1 receive data -
    connector.A23 ~ power.v12.lv            # Ground
    connector.A24 ~ power.v12.lv            # Ground
    connector.A25 ~ lanes[2].rx.p.line      # HSIp(2) - Lane 2 receive data +
    connector.A26 ~ lanes[2].rx.n.line      # HSIn(2) - Lane 2 receive data -
    connector.A27 ~ power.v12.lv            # Ground
    connector.A28 ~ power.v12.lv            # Ground
    connector.A29 ~ lanes[3].rx.p.line      # HSIp(3) - Lane 3 receive data +
    connector.A30 ~ lanes[3].rx.n.line      # HSIn(3) - Lane 3 receive data -
    connector.A31 ~ power.v12.lv            # Ground
    # connector.A32                       # Reserved (no connection)
    # connector.A33                       # Reserved (no connection)
    connector.A34 ~ power.v12.lv            # Ground
    connector.A35 ~ lanes[4].rx.p.line      # HSIp(4) - Lane 4 receive data +
    connector.A36 ~ lanes[4].rx.n.line      # HSIn(4) - Lane 4 receive data -
    connector.A37 ~ power.v12.lv            # Ground
    connector.A38 ~ power.v12.lv            # Ground
    connector.A39 ~ lanes[5].rx.p.line      # HSIp(5) - Lane 5 receive data +
    connector.A40 ~ lanes[5].rx.n.line      # HSIn(5) - Lane 5 receive data -
    connector.A41 ~ power.v12.lv            # Ground
