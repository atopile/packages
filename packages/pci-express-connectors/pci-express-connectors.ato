    connector.A68 ~ lanes[12].rx.p.line     # HSIp(12) - Lane 12 receive data +
    connector.A69 ~ lanes[12].rx.n.line     # HSIn(12) - Lane 12 receive data -
    connector.A70 ~ power.v12.lv            # Ground
