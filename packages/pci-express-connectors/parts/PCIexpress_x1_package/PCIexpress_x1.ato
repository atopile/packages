#pragma experiment("TRAITS")
import has_designator_prefix
import is_atomic_part

component PCIexpress_x1:
    trait is_atomic_part<manufacturer="Generic", partnumber="PCIexpress_x1", footprint="PCIexpress_x1.kicad_mod", symbol="PCIexpress.kicad_sym", model="">
    trait has_designator_prefix<prefix="J">

    # A-side pins (component side)
    pin A1   # PRSNT1#
    pin A2   # +12V
    pin A3   # +12V
    pin A4   # Ground
    pin A5   # TCK
    pin A6   # TDI
    pin A7   # TDO
    pin A8   # TMS
    pin A9   # +3.3V
    pin A10  # +3.3V
    pin A11  # PERST#
    pin A12  # Ground
    pin A13  # REFCLK+
    pin A14  # REFCLK-
    pin A15  # Ground
    pin A16  # HSIp(0)
    pin A17  # HSIn(0)
    pin A18  # Ground

    # B-side pins (solder side)
    pin B1   # +12V
    pin B2   # +12V
    pin B3   # +12V
    pin B4   # Ground
    pin B5   # SMCLK
    pin B6   # SMDAT
    pin B7   # Ground
    pin B8   # +3.3V
    pin B9   # TRST#
    pin B10  # +3.3V_aux
    pin B11  # WAKE#
    pin B12  # CLKREQ#
    pin B13  # Ground
    pin B14  # HSOp(0)
    pin B15  # HSOn(0)
    pin B16  # Ground
    pin B17  # PRSNT2#
    pin B18  # Ground
