#pragma experiment("TRAITS")
import has_designator_prefix
import is_atomic_part

component PCIexpress_x8:
    trait is_atomic_part<manufacturer="Generic", partnumber="PCIexpress_x8", footprint="PCIexpress_x8.kicad_mod", symbol="PCIexpress.kicad_sym", model="">
    trait has_designator_prefix<prefix="J">

    # A-side pins (component side) - x1 portion
    pin A1   # ~PRSNT1
    pin A2   # +12V
    pin A3   # +12V
    pin A4   # GND
    pin A5   # TCK
    pin A6   # TDI
    pin A7   # TDO
    pin A8   # TMS
    pin A9   # +3.3V
    pin A10  # +3.3V
    pin A11  # ~PERST
    pin A12  # GND
    pin A13  # REFCLK+
    pin A14  # REFCLK-
    pin A15  # GND
    pin A16  # PERp0
    pin A17  # PERn0
    pin A18  # GND

    # A-side pins (component side) - x4 additional lanes
    pin A19  # RSVD
    pin A20  # GND
    pin A21  # PERp1
    pin A22  # PERn1
    pin A23  # GND
    pin A24  # GND
    pin A25  # PERp2
    pin A26  # PERn2
    pin A27  # GND
    pin A28  # GND
    pin A29  # PERp3
    pin A30  # PERn3
    pin A31  # GND
    pin A32  # RSVD

    # A-side pins (component side) - x8 additional lanes
    pin A33  # RSVD
    pin A34  # GND
    pin A35  # PERp4
    pin A36  # PERn4
    pin A37  # GND
    pin A38  # GND
    pin A39  # PERp5
    pin A40  # PERn5
    pin A41  # GND
    pin A42  # GND
    pin A43  # PERp6
    pin A44  # PERn6
    pin A45  # GND
    pin A46  # GND
    pin A47  # PERp7
    pin A48  # PERn7
    pin A49  # GND

    # B-side pins (solder side) - x1 portion
    pin B1   # +12V
    pin B2   # +12V
    pin B3   # +12V
    pin B4   # GND
    pin B5   # SMCLK
    pin B6   # SMDAT
    pin B7   # GND
    pin B8   # +3.3V
    pin B9   # ~JTAG_TRST
    pin B10  # +3.3V_aux
    pin B11  # ~WAKE
    pin B12  # RSVD
    pin B13  # GND
    pin B14  # PETp0
    pin B15  # PETn0
    pin B16  # GND
    pin B17  # ~PRSNT2
    pin B18  # GND

    # B-side pins (solder side) - x4 additional lanes
    pin B19  # RSVD
    pin B20  # GND
    pin B21  # PETp1
    pin B22  # PETn1
    pin B23  # GND
    pin B24  # GND
    pin B25  # PETp2
    pin B26  # PETn2
    pin B27  # GND
    pin B28  # GND
    pin B29  # PETp3
    pin B30  # PETn3
    pin B31  # GND
    pin B32  # RSVD

    # B-side pins (solder side) - x8 additional lanes
    pin B33  # RSVD
    pin B34  # GND
    pin B35  # PETp4
    pin B36  # PETn4
    pin B37  # GND
    pin B38  # GND
    pin B39  # PETp5
    pin B40  # PETn5
    pin B41  # GND
    pin B42  # GND
    pin B43  # PETp6
    pin B44  # PETn6
    pin B45  # GND
    pin B46  # GND
    pin B47  # PETp7
    pin B48  # PETn7
    pin B49  # GND
