
import ElectricPower
import I2C
import I2S

from "atopile/ti-tas5825mrhbr/ti-tas5825mrhbr.ato" import Texas_Instruments_TAS5825MRHBR

module Usage:
    """
    Minimal usage example for ti-tas5825mrhbr.
    Texas Instruments TAS5825MRHBR audio amplifier example
    """

    amp = new Texas_Instruments_TAS5825MRHBR

    power_3v3 = new ElectricPower
    power_20V = new ElectricPower
    power_3v3.voltage = 3.3V
    power_20V.voltage = 20V

    i2s = new I2S
    i2c = new I2C

    amp.power_pvdd ~ power_20V
    amp.power_dvdd ~ power_3v3

    amp.i2s ~ i2s
    amp.i2c ~ i2c

    # Set I2C address (0x4E = base 0x4C + offset 2 → 4.7kohm resistor)
    assert amp.i2c.address within 0x4E
