#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("MODULE_TEMPLATING")

import ElectricPower
import ElectricLogic
import I2C
import Capacitor
import Addressor

from "parts/Texas_Instruments_TMP102AIDRLR/Texas_Instruments_TMP102AIDRLR.ato" import Texas_Instruments_TMP102AIDRLR_package

module TI_TMP102:
    """
    Texas Instruments TMP102 12-bit I2C temperature sensor.
    Range: -40 to +125C, +-0.5C accuracy. Supply: 1.4V to 3.6V.
    4 selectable I2C addresses via ADD0 pin.
    """

    package = new Texas_Instruments_TMP102AIDRLR_package

    power = new ElectricPower
    power.required = True
    assert power.voltage within 1.4V to 3.6V
    power.hv ~ package.Vpos
    power.lv ~ package.GND

    i2c = new I2C
    i2c.required = True
    i2c.scl.line ~ package.SCL
    i2c.sda.line ~ package.SDA
    i2c.scl.reference ~ power
    i2c.sda.reference ~ power

    # ADD0: GND=0x48, VCC=0x49, SDA=0x4A, SCL=0x4B
    addressor = new Addressor<address_bits=1>
    addressor.base = 0x48
    addressor.address.default = 0x48
    assert addressor.address is i2c.address
    addressor.address_lines[0].line ~ package.ADD0
    addressor.address_lines[0].reference ~ power

    # ALERT is open-drain, active low
    alert = new ElectricLogic
    alert.line ~ package.ALERT
    alert.reference ~ power

    decoupling = new Capacitor
    decoupling.capacitance = 100nF +/- 20%
    decoupling.package = "0402"
    power.hv ~> decoupling ~> power.lv
