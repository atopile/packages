import ElectricPower

from "parts/AMASS_XT30PW_F20_G_Y/AMASS_XT30PW_F20_G_Y.ato" import AMASS_XT30PW_F20_G_Y_package
from "parts/AMASS_XT30PW_M30_G_Y/AMASS_XT30PW_M30_G_Y.ato" import AMASS_XT30PW_M30_G_Y_package
from "parts/AMASS_XT30UPB_F30_G_Y/AMASS_XT30UPB_F30_G_Y.ato" import AMASS_XT30UPB_F30_G_Y_package
from "parts/AMASS_XT30U_M/AMASS_XT30U_M.ato" import AMASS_XT30U_M_package

module XTConnector_base:
    power = new ElectricPower

module XT30_Male_Right_Angle from XTConnector_base:
    # Package
    package = new AMASS_XT30PW_F20_G_Y_package
    # Connections
    power.vcc ~ package.1
    power.gnd ~ package.2

module XT30_Male_Vertical from XTConnector_base:
    # Package
    package = new AMASS_XT30U_M_package
    # Connections
    power.vcc ~ package.1
    power.gnd ~ package.2

module XT30_Female_Right_Angle from XTConnector_base:
    # Package
    package = new AMASS_XT30PW_M30_G_Y_package
    # Connections
    power.vcc ~ package.2
    power.gnd ~ package.1

module XT30_Female_Vertical from XTConnector_base:
    # Package
    package = new AMASS_XT30UPB_F30_G_Y_package
    # Connections
    power.vcc ~ package.1
    power.gnd ~ package.2
