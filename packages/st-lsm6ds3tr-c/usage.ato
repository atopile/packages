import ElectricPower
import I2C

from "atopile/st-lsm6ds3tr-c/st-lsm6ds3tr-c.ato" import ST_LSM6DS3TR_C

module Usage:
    """
    Minimal usage example for ST_LSM6DS3TR_C.
    Shows how to connect the IMU with I2C interface and power supply.
    """

    # Create IMU instance
    imu = new ST_LSM6DS3TR_C

    # Create power supply
    power_3v3 = new ElectricPower
    power_3v3.voltage = 3.3V +/- 5%

    # Create I2C bus
    i2c_bus = new I2C
    i2c_bus.frequency = 400kHz
    i2c_bus.address = 0x6A

    # Connect interfaces
    power_3v3 ~ imu.power
    i2c_bus ~ imu.i2c
