"""
2.4 GHz Wi-Fi (802.11b/g/n) and Bluetooth® 5 module
Built around ESP32-C3 series of SoCs, RISC-V single-core microprocessor
Flash up to 16 MB
15 GPIOs
On-board PCB antenna or external antenna connector
"""
#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
#pragma experiment("TRAITS")
import ElectricPower
import Capacitor
import Resistor
import ElectricSignal
import ElectricLogic
import USB2_0_IF
import UART
import I2C
import I2S
import SPI
import JTAG
import MultiSPI
import XtalIF
import has_single_electric_reference_shared

from "atopile/buttons/buttons.ato" import Button
from "atopile/buttons/buttons.ato" import VerticalButton

from "espressif-esp32-c3.ato" import ESP32_C3_model

from "parts/Espressif_Systems_ESP32_C3_WROOM_02_N4/Espressif_Systems_ESP32_C3_WROOM_02_N4.ato" import Espressif_Systems_ESP32_C3_WROOM_02_N4_package
from "parts/Espressif_Systems_ESP32_C3_WROOM_02_H4/Espressif_Systems_ESP32_C3_WROOM_02_H4.ato" import Espressif_Systems_ESP32_C3_WROOM_02_H4_package
from "parts/Espressif_Systems_ESP32_C3_WROOM_02U_N4/Espressif_Systems_ESP32_C3_WROOM_02U_N4.ato" import Espressif_Systems_ESP32_C3_WROOM_02U_N4_package

module ESP32_C3_WROOM_02_base_model from ESP32_C3_model:
    """
    Base module for ESP32-C3-WROOM-02 and ESP32-C3-WROOM-02U, N4 and H4 variants
    """

    # external interfaces
    power = new ElectricPower
    power_analog ~ power
    power_cpu ~ power
    power_rtc ~ power
    power_radio ~ power

    trait has_single_electric_reference_shared

module ESP32_C3_WROOM_02_N4_model from ESP32_C3_WROOM_02_base_model:
    """
    ESP32-C3-WROOM-02-N4 module with build-in antenna and supporting components
    """
    package = new Espressif_Systems_ESP32_C3_WROOM_02_N4_package

    # connections to package
    gpio[0].line ~ package.IO0
    gpio[1].line ~ package.IO1
    gpio[2].line ~ package.IO2
    gpio[3].line ~ package.IO3
    gpio[4].line ~ package.IO4
    gpio[5].line ~ package.IO5
    gpio[6].line ~ package.IO6
    gpio[7].line ~ package.IO7
    gpio[8].line ~ package.IO8
    gpio[9].line ~ package.IO9
    gpio[10].line ~ package.IO10
    gpio[18].line ~ package.IO18
    gpio[19].line ~ package.IO19
    gpio[20].line ~ package.RXD
    gpio[21].line ~ package.TXD
    esp32.enable.line ~ package.EN
    power.hv ~ package.P3V3
    power.lv ~ package.GND

module ESP32_C3_WROOM_02_H4_model from ESP32_C3_WROOM_02_base_model:
    """
    ESP32-C3-WROOM-02-H4 module with build-in antenna and supporting components
    """
    package = new Espressif_Systems_ESP32_C3_WROOM_02_H4_package

    # connections to package
    gpio[0].line ~ package.IO0
    gpio[1].line ~ package.IO1
    gpio[2].line ~ package.IO2
    gpio[3].line ~ package.IO3
    gpio[4].line ~ package.IO4
    gpio[5].line ~ package.IO5
    gpio[6].line ~ package.IO6
    gpio[7].line ~ package.IO7
    gpio[8].line ~ package.IO8
    gpio[9].line ~ package.IO9
    gpio[10].line ~ package.IO10
    gpio[18].line ~ package.IO18
    gpio[19].line ~ package.IO19
    gpio[20].line ~ package.RXD
    gpio[21].line ~ package.TXD
    enable.line ~ package.EN
    power.hv ~ package.P3V3
    power.lv ~ package.GND

module ESP32_C3_WROOM_02U_N4_model from ESP32_C3_WROOM_02_base_model:
    """
    ESP32-C3-WROOM-02U-N4 module with external antenna and supporting components
    """
    package = new Espressif_Systems_ESP32_C3_WROOM_02U_N4_package

    # connections to package
    gpio[0].line ~ package.IO0
    gpio[1].line ~ package.IO1
    gpio[2].line ~ package.IO2
    gpio[3].line ~ package.IO3
    gpio[4].line ~ package.IO4
    gpio[5].line ~ package.IO5
    gpio[6].line ~ package.IO6
    gpio[7].line ~ package.IO7
    gpio[8].line ~ package.IO8
    gpio[9].line ~ package.IO9
    gpio[10].line ~ package.IO10
    gpio[18].line ~ package.IO18
    gpio[19].line ~ package.IO19
    gpio[20].line ~ package.RXD
    gpio[21].line ~ package.TXD
    enable.line ~ package.EN
    power.hv ~ package.P3V3
    power.lv ~ package.GND

# unavailable on JLCPCB
# module ESP32_C3_WROOM_02U_H4 from ESP32_C3_WROOM_02_base_model:
#     """
#     ESP32-C3-WROOM-02U-H4 module with external antenna and supporting components
#     """
#     package -> Espressif_Systems_ESP32_C3_WROOM_02U_H4_package

module ESP32_C3_WROOM_02:
    """
    Reference driver for ESP32-C3-WROOM-02 series of modules
    """
    esp32_c3 = new ESP32_C3_WROOM_02_H4_model # defaults to ESP32-C3-WROOM-02-H4 package

    # external interfaces
    power = new ElectricPower
    power.required = True
    gpio = new ElectricLogic[22]
    mspi = new MultiSPI[3]<data_lane_count=4>
    uart = new UART[2]
    i2c = new I2C
    i2s = new I2S
    spi = new SPI
    usb_if = new USB2_0_IF # TODO: should be USB2_0_IF.Data
    jtag = new JTAG
    adc1 = new ElectricSignal[5]
    adc2 = new ElectricSignal
    crystal_32k_interface = new XtalIF

    # connect to the base model
    gpio[0] ~ esp32_c3.gpio[0]
    gpio[1] ~ esp32_c3.gpio[1]
    gpio[2] ~ esp32_c3.gpio[2]
    gpio[3] ~ esp32_c3.gpio[3]
    gpio[4] ~ esp32_c3.gpio[4]
    gpio[5] ~ esp32_c3.gpio[5]
    gpio[6] ~ esp32_c3.gpio[6]
    gpio[7] ~ esp32_c3.gpio[7]
    gpio[8] ~ esp32_c3.gpio[8]
    gpio[9] ~ esp32_c3.gpio[9]
    gpio[10] ~ esp32_c3.gpio[10]
    gpio[18] ~ esp32_c3.gpio[18]
    gpio[19] ~ esp32_c3.gpio[19]
    gpio[20] ~ esp32_c3.gpio[20]
    gpio[21] ~ esp32_c3.gpio[21]
    mspi[0] ~ esp32_c3.mspi[0]
    mspi[1] ~ esp32_c3.mspi[1]
    mspi[2] ~ esp32_c3.mspi[2]
    uart[0] ~ esp32_c3.uart[0]
    uart[1] ~ esp32_c3.uart[1]
    i2c ~ esp32_c3.i2c
    i2s ~ esp32_c3.i2s
    spi ~ esp32_c3.spi
    usb_if ~ esp32_c3.usb_if
    jtag ~ esp32_c3.jtag
    adc1[0] ~ esp32_c3.adc1[0]
    adc1[1] ~ esp32_c3.adc1[1]
    adc1[2] ~ esp32_c3.adc1[2]
    adc1[3] ~ esp32_c3.adc1[3]
    adc1[4] ~ esp32_c3.adc1[4]
    adc2 ~ esp32_c3.adc2
    crystal_32k_interface ~ esp32_c3.crystal_32k_interface
    esp32_c3.power ~ power

    # components
    boot_switch = new Button
    boot_pullup_resistor = new Resistor
    boot_debounce_capacitor = new Capacitor
    reset_switch = new Button
    reset_pullup_resistor = new Resistor
    reset_debounce_capacitor = new Capacitor
    decoupling_capacitor_bulk = new Capacitor
    decoupling_capacitor_small = new Capacitor
    boot_mode_resistors = new Resistor[2]

    # connections
    power ~ decoupling_capacitor_bulk.power
    power ~ decoupling_capacitor_small.power

    power.lv ~> boot_switch ~> gpio[9].line
    power.hv ~> boot_pullup_resistor ~> esp32_c3.gpio[9].line
    boot_switch -> VerticalButton
    boot_switch.input ~> boot_debounce_capacitor ~> boot_switch.output

    power.lv ~> reset_switch ~> esp32_c3.enable.line
    power.hv ~> reset_pullup_resistor ~> esp32_c3.enable.line
    reset_switch -> VerticalButton
    reset_switch.input ~> reset_debounce_capacitor ~> reset_switch.output

    gpio[2].line ~> boot_mode_resistors[0] ~> power.hv
    gpio[8].line ~> boot_mode_resistors[1] ~> power.hv

    # parameters
    decoupling_capacitor_bulk.capacitance = 22uF +/- 20%
    decoupling_capacitor_bulk.package = "C0603"
    decoupling_capacitor_small.capacitance = 100nF +/- 10%
    decoupling_capacitor_small.package = "C0402"
    boot_debounce_capacitor.capacitance = 100nF +/- 10%
    boot_debounce_capacitor.package = "C0402"
    reset_debounce_capacitor.capacitance = 1uF +/- 10%
    reset_debounce_capacitor.package = "C0402"
    reset_pullup_resistor.resistance = 10kohm +/- 1%
    reset_pullup_resistor.package = "R0402"
    boot_pullup_resistor.resistance = 5.1kohm +/- 1%
    boot_pullup_resistor.package = "R0402"
    for res in boot_mode_resistors:
        res.resistance = 10kohm +/- 1%
        res.package = "R0402"
