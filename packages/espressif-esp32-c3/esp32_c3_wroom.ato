module ESP32_C3_WROOM_02_driver:
    """
    Reference driver for ESP32-C3-WROOM-02 series of modules
    """
    esp32_c3 = new ESP32_C3_WROOM_02_H4_model # defaults to ESP32-C3-WROOM-02-H4 package

    # external interfaces
    power = new ElectricPower
    esp32_c3.power ~ power

    # components
    boot_switch = new Button
    reset_switch = new Button
    reset_pullup_resistor = new Resistor
    debounce_capacitors = new Capacitor[2]
    decoupling_capacitor_bulk = new Capacitor
    decoupling_capacitor_small = new Capacitor
    boot_mode_resistors = new Resistor[2]

    # connections
    power ~ decoupling_capacitor_bulk.power
    power ~ decoupling_capacitor_small.power

    power.lv ~> boot_switch ~> esp32_c3.gpio[9].line
    boot_switch -> VerticalButton
    boot_switch.input ~> debounce_capacitors[0] ~> boot_switch.output

    power.lv ~> reset_switch ~> esp32_c3.esp32.enable.line
    power.hv ~> reset_pullup_resistor ~> esp32_c3.esp32.enable.line
    reset_switch -> VerticalButton
    reset_switch.input ~> debounce_capacitors[1] ~> reset_switch.output

    esp32_c3.gpio[2].line ~> boot_mode_resistors[0] ~> power.hv
    esp32_c3.gpio[8].line ~> boot_mode_resistors[1] ~> power.hv

    # parameters
    decoupling_capacitor_bulk.capacitance = 22uF +/- 20%
    decoupling_capacitor_bulk.package = "C0603"
    decoupling_capacitor_small.capacitance = 100nF +/- 10%
    decoupling_capacitor_small.package = "C0402"
    for cap in debounce_capacitors:
        cap.capacitance = 100nF +/- 10%
        cap.package = "C0402"
    for res in boot_mode_resistors:
        res.resistance = 10kohm +/- 1%
        res.package = "R0402"
    reset_pullup_resistor.resistance = 10kohm +/- 1%
    reset_pullup_resistor.package = "R0402"

module ESP32_C3_WROOM_02_driver_example:
    """
    Example of how to use the driver for ESP32-C3-WROOM-02 modules
    """
    mcu_module = new ESP32_C3_WROOM_02_driver
    # mcu_module.esp32_c3 -> ESP32_C3_WROOM_02_H4_model # choose another variant if you want

    power_3v3 = new ElectricPower
    power_3v3.voltage = 3.3V +/- 10%
    power_3v3 ~ mcu_module.power

    i2c = new I2C
    mcu_module.esp32_c3.i2c ~ i2c
    # I2C pull-up resistors
    pullup_resistors = new Resistor[2]
    for res in pullup_resistors:
        res.resistance = 10kohm +/- 1%
        res.package = "R0402"
    i2c.sda.reference.hv ~> pullup_resistors[0] ~> i2c.sda.line
    i2c.scl.reference.hv ~> pullup_resistors[1] ~> i2c.scl.line

    spi = new SPI
    mcu_module.esp32_c3.spi ~ spi

    i2s = new I2S
    mcu_module.esp32_c3.i2s ~ i2s
