"""
2.4 GHz Wi-Fi (802.11b/g/n) and Bluetooth® 5 module
Built around ESP32-C3 series of SoCs, RISC-V single-core microprocessor
Flash up to 16 MB
15 GPIOs
On-board PCB antenna or external antenna connector
"""
#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
#pragma experiment("TRAITS")
import ElectricPower
import Capacitor
import Resistor
import FilterElectricalRC
import ElectricLogic
import USB2_0_IF
import UART
import I2C
import I2S
import SPI
import JTAG
import MultiSPI
import has_single_electric_reference_shared

from "atopile/buttons/buttons.ato" import Button
from "atopile/buttons/buttons.ato" import VerticalButton

from "esp32_c3.ato" import ESP32_C3_model

from "parts/Espressif_Systems_ESP32_C3_WROOM_02_N4/Espressif_Systems_ESP32_C3_WROOM_02_N4.ato" import Espressif_Systems_ESP32_C3_WROOM_02_N4_package
from "parts/Espressif_Systems_ESP32_C3_WROOM_02_H4/Espressif_Systems_ESP32_C3_WROOM_02_H4.ato" import Espressif_Systems_ESP32_C3_WROOM_02_H4_package
from "parts/Espressif_Systems_ESP32_C3_WROOM_02U_N4/Espressif_Systems_ESP32_C3_WROOM_02U_N4.ato" import Espressif_Systems_ESP32_C3_WROOM_02U_N4_package

module ESP32_C3_WROOM_02_base_model:
    """
    Base module for ESP32-C3-WROOM-02 and ESP32-C3-WROOM-02U, N4 and H4 variants
    """
    esp32 = new ESP32_C3_model
    #TODO: model internal components

    # external interfaces
    #TODO: should be passed through with export *
    power = new ElectricPower
    esp32.power_analog ~ power
    esp32.power_cpu ~ power
    esp32.power_rtc ~ power
    esp32.power_radio ~ power
    gpio = new ElectricLogic[22]
    esp32.gpio[0] ~ gpio[0]
    esp32.gpio[1] ~ gpio[1]
    esp32.gpio[2] ~ gpio[2]
    esp32.gpio[3] ~ gpio[3]
    esp32.gpio[4] ~ gpio[4]
    esp32.gpio[5] ~ gpio[5]
    esp32.gpio[6] ~ gpio[6]
    esp32.gpio[7] ~ gpio[7]
    esp32.gpio[8] ~ gpio[8]
    esp32.gpio[9] ~ gpio[9]
    esp32.gpio[10] ~ gpio[10]
    esp32.gpio[18] ~ gpio[18]
    esp32.gpio[19] ~ gpio[19]
    esp32.gpio[20] ~ gpio[20]
    esp32.gpio[21] ~ gpio[21]
    enable = new ElectricLogic
    esp32.enable ~ enable
    usb_if = new USB2_0_IF
    esp32.usb_if ~ usb_if
    uart = new UART
    esp32.uart[0] ~ uart
    i2c = new I2C
    esp32.i2c ~ i2c
    i2s = new I2S
    esp32.i2s ~ i2s
    spi = new SPI
    esp32.spi ~ spi
    jtag = new JTAG
    esp32.jtag ~ jtag
    mspi = new MultiSPI<data_lane_count=4>
    esp32.mspi[2] ~ mspi
    # TODO: etc...

    trait has_single_electric_reference_shared

module ESP32_C3_WROOM_02_N4_model from ESP32_C3_WROOM_02_base_model:
    """
    ESP32-C3-WROOM-02-N4 module with build-in antenna and supporting components
    """
    package = new Espressif_Systems_ESP32_C3_WROOM_02_N4_package

    # connections to package
    esp32.gpio[0].line ~ package.IO0
    esp32.gpio[1].line ~ package.IO1
    esp32.gpio[2].line ~ package.IO2
    esp32.gpio[3].line ~ package.IO3
    esp32.gpio[4].line ~ package.IO4
    esp32.gpio[5].line ~ package.IO5
    esp32.gpio[6].line ~ package.IO6
    esp32.gpio[7].line ~ package.IO7
    esp32.gpio[8].line ~ package.IO8
    esp32.gpio[9].line ~ package.IO9
    esp32.gpio[10].line ~ package.IO10
    esp32.gpio[18].line ~ package.IO18
    esp32.gpio[19].line ~ package.IO19
    esp32.gpio[20].line ~ package.RXD
    esp32.gpio[21].line ~ package.TXD
    esp32.enable.line ~ package.EN
    power.hv ~ package.P3V3
    power.lv ~ package.GND

