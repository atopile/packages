#pragma experiment("BRIDGE_CONNECT")

import Capacitor
import ElectricLogic
import ElectricPower
import I2C
import Resistor

from "parts/Microchip_Tech_CAP1188_1_CP_TR/Microchip_Tech_CAP1188_1_CP_TR.ato" import Microchip_Tech_CAP1188_1_CP_TR_package

module Microchip_Tech_CAP1188_1_CP_TR_driver:
    """
    Microchip CAP1188 8-channel capacitive touch sensor

    8 QFN-24-EP(4x4)
    Touch Sensors ROHS

    Datasheet: https://wmsc.lcsc.com/wmsc/upload/file/pdf/v2/lcsc/2309071116_Microchip-Tech-CAP1188-1-CP-TR_C2652057.pdf
    """

    power = new ElectricPower
    i2c = new I2C
    reset = new ElectricLogic
    interrupt = new ElectricLogic
    address = new ElectricLogic
    pads = new ElectricLogic[8]

    capacitive_sensor = new Microchip_Tech_CAP1188_1_CP_TR_package

    power.hv ~ capacitive_sensor.VDD
    power.lv ~ capacitive_sensor.GND

    decouple_cap = new Capacitor
    decouple_cap.package = "C0402"
    assert decouple_cap.max_voltage >= power.voltage * 1.5
    assert decouple_cap.capacitance within 100 nF +/- 30%
    power.hv ~> decouple_cap ~> power.lv

    # Data
    i2c.sda.line ~ capacitive_sensor.SMDATA_BC_DATA_SPI_MSIO_SPI_MISO
    i2c.scl.line ~ capacitive_sensor.SMCLK_BC_CLK_SPI_CLK
    reset.line ~ capacitive_sensor.RESET
    interrupt.line ~ capacitive_sensor.nALERT_nBC_IRQ
    address.line ~ capacitive_sensor.ADDR_COMM

    pullup = new Resistor
    pullup.package = "R0402"
    assert pullup.resistance within 10 kohm +/- 5%
    interrupt.line ~> pullup ~> interrupt.reference.hv

    reset_pulldown = new Resistor
    reset_pulldown.package = "R0402"
    assert reset_pulldown.resistance within 10 kohm +/- 5%
    reset.line ~> reset_pulldown ~> reset.reference.lv

    address_pulldown = new Resistor
    address_pulldown.package = "R0402"
    assert address_pulldown.resistance within 10 kohm +/- 5%
    address.line ~> address_pulldown ~> address.reference.lv

    # Pads
    capacitive_sensor.CS1 ~ pads[0].line
    capacitive_sensor.CS2 ~ pads[1].line
    capacitive_sensor.CS3 ~ pads[2].line
    capacitive_sensor.CS4 ~ pads[3].line
    capacitive_sensor.CS5 ~ pads[4].line
    capacitive_sensor.CS6 ~ pads[5].line
    capacitive_sensor.CS7 ~ pads[6].line
    capacitive_sensor.CS8 ~ pads[7].line
