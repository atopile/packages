#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("TRAITS")

import has_single_electric_reference_shared
import Capacitor
import ElectricLogic
import ElectricPower
import I2C
import SPI
import Resistor

from "parts/Microchip_Tech_CAP1188_1_CP_TR/Microchip_Tech_CAP1188_1_CP_TR.ato" import Microchip_Tech_CAP1188_1_CP_TR_package

module Microchip_Tech_CAP1188_1_CP_TR_driver:
    """
    Microchip CAP1188 8-channel capacitive touch sensor

    8 QFN-24-EP(4x4)
    Touch Sensors ROHS

    Datasheet: https://wmsc.lcsc.com/wmsc/upload/file/pdf/v2/lcsc/2309071116_Microchip-Tech-CAP1188-1-CP-TR_C2652057.pdf
    """

    trait has_single_electric_reference_shared<gnd_only=True>

    power = new ElectricPower
    i2c = new I2C
    spi = new SPI
    spi_cs = new ElectricLogic
    leds = new ElectricLogic[8]
    reset = new ElectricLogic
    interrupt = new ElectricLogic
    address = new ElectricLogic
    pads = new ElectricLogic[8]

    capacitive_sensor = new Microchip_Tech_CAP1188_1_CP_TR_package

    assert power.voltage within 3V to 3.6V
    power.hv ~ capacitive_sensor.VDD
    power.lv ~ capacitive_sensor.GND

    decouple_cap = new Capacitor
    decouple_cap.package = "C0402"
    assert decouple_cap.max_voltage >= power.voltage * 1.5
    assert decouple_cap.capacitance within 100 nF +/- 30%
    power.hv ~> decouple_cap ~> power.lv

    # SPI
    spi.sclk.reference ~ power
    spi.sclk.line ~ capacitive_sensor.SMCLK_BC_CLK_SPI_CLK
    spi.mosi.line ~ capacitive_sensor.WAKE_SPI_MOSI
    spi.miso.line ~ capacitive_sensor.SMDATA_BC_DATA_SPI_MSIO_SPI_MISO
    spi_cs.reference ~ power
    spi_cs.line ~ capacitive_sensor.nSPI_CS

    # I2C
    i2c.sda.reference ~ power
    i2c.scl.reference ~ power
    i2c.sda.line ~ capacitive_sensor.SMDATA_BC_DATA_SPI_MSIO_SPI_MISO
    i2c.scl.line ~ capacitive_sensor.SMCLK_BC_CLK_SPI_CLK
    reset.line ~ capacitive_sensor.RESET
    interrupt.line ~ capacitive_sensor.nALERT_nBC_IRQ
    address.line ~ capacitive_sensor.ADDR_COMM

    # Pull-ups / pull-downs
    # Interrupt
    pull_up_interrupt = new Resistor
    pull_up_interrupt.package = "R0402"
    assert pull_up_interrupt.resistance within 10 kohm +/- 5%
    interrupt.reference ~ power
    interrupt.line ~> pull_up_interrupt ~> interrupt.reference.hv

    # Reset
    pull_down_reset = new Resistor
    pull_down_reset.package = "R0402"
    assert pull_down_reset.resistance within 10 kohm +/- 5%
    reset.reference ~ power
    reset.line ~> pull_down_reset ~> reset.reference.lv

    # Address
    # Table 4-1: ADDR_COMM Pin Decode
    # | Connection | Protocol Used  | SMBus Address |
    # |----------|----------------|---------------|
    # | GND      | 4-wire SPI     | n/a           |
    # | 56k      | 3-wire SPI     | n/a           |
    # | 68k      | Reserved       | n/a           |
    # | 82k      | SMBus / I2C    | 0101_100(r/w) |
    # | 100k     | SMBus / I2C    | 0101_011(r/w) |
    # | 120k     | SMBus / I2C    | 0101_010(r/w) |
    # | 150k     | SMBus / I2C    | 0101_001(r/w) |
    # | VDD      | SMBus / I2C    | 0101_000(r/w) |
    # address.reference ~ power
    # address.line.required = True

    # Address select - TODO: implement addressor module
    address_select = new Resistor
    address_select.package = "R0402"
    assert address_select.resistance within 0 ohm to 200kohm
    address.line ~> address_select ~> power.lv

    # Capacitive sensor pads
    capacitive_sensor.CS1 ~ pads[0].line
    capacitive_sensor.CS2 ~ pads[1].line
    capacitive_sensor.CS3 ~ pads[2].line
    capacitive_sensor.CS4 ~ pads[3].line
    capacitive_sensor.CS5 ~ pads[4].line
    capacitive_sensor.CS6 ~ pads[5].line
    capacitive_sensor.CS7 ~ pads[6].line
    capacitive_sensor.CS8 ~ pads[7].line

    # LEDs
    capacitive_sensor.LED1 ~ leds[0].line
    capacitive_sensor.LED2 ~ leds[1].line
    capacitive_sensor.LED3 ~ leds[2].line
    capacitive_sensor.LED4 ~ leds[3].line
    capacitive_sensor.LED5 ~ leds[4].line
    capacitive_sensor.LED6 ~ leds[5].line
    capacitive_sensor.LED7 ~ leds[6].line
    capacitive_sensor.LED8 ~ leds[7].line

module CAP1188_Example:
    # from "atopile/microchip-cap1188/microchip_cap1188.ato" import Microchip_Tech_CAP1188_1_CP_TR_driver

    import ElectricPower
    import Resistor

    touch_sensor = new Microchip_Tech_CAP1188_1_CP_TR_driver

    power_3v3 = new ElectricPower
    power_3v3 ~ touch_sensor.power

    # Select address
    touch_sensor.address_select.resistance = 82kohm +/- 2%
