#pragma experiment("TRAITS")
import has_designator_prefix
import has_part_picked
import is_atomic_part
import is_auto_generated

component CM5_package:
    """
    This package only contains the 3D model of the Teensy 4.1.
    """

    trait is_atomic_part<manufacturer="Raspberry Pi", partnumber="CM5", footprint="cm5.kicad_mod", symbol="cm5.kicad_sym", model="cm5.step">
    trait has_designator_prefix<prefix="U">
