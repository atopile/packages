#pragma experiment("MODULE_TEMPLATING")
#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")
#pragma experiment("TRAITS")

import Capacitor
import ElectricPower
import ElectricLogic
import I2C
import Resistor
import can_bridge_by_name

# --- Part import ---
from "parts/Texas_Instruments_TCA4307DGKR/Texas_Instruments_TCA4307DGKR.ato" import Texas_Instruments_TCA4307DGKR_package

module TI_TCA4307:
    """
    Driver for Texas Instruments TCA4307 hot-swappable I²C bus buffer.

    Key features:
    - Hot-swappable I²C bus buffering
    - Automatic bus recovery after 40ms timeout
    - Bidirectional data/clock buffering
    - 400kHz fast-mode I²C support
    - Automatic reset pulse generation
    - Pre-charging capability during insertion
    - Operating voltage: 2.3V to 5.5V
    """

    # --- Package ---
    package = new Texas_Instruments_TCA4307DGKR_package

    # --- External interfaces ---
    i2c_upstream = new I2C
    """
    Upstream I²C bus interface (host/controller side)
    Connects to the main I²C controller
    """
    i2c_upstream.required = True

    i2c_downstream = new I2C
    """
    Downstream I²C bus interface (device/target side)
    Connects to I²C devices being buffered
    """
    i2c_downstream.required = True

    power = new ElectricPower
    """
    Main power supply (2.3V to 5.5V)
    Powers the buffer and control logic
    """
    power.required = True

    ready = new ElectricLogic
    """
    READY output pin (open-drain, active low)
    Indicates when the buffer is ready for operation
    """

    enable = new ElectricLogic
    """
    Enable input pin (active high)
    Controls the buffer enable/disable state
    """

    # --- Bridgable interfaces ---
    trait can_bridge_by_name<input_name = "i2c_upstream", output_name = "i2c_downstream">

    # --- Power supply ---
    assert power.voltage within 2.3V to 5.5V

    # --- Package connections ---
    package.VCC ~ power.hv
    package.GND ~ power.lv
    package.EN ~ enable.line
    package.READY ~ ready.line
    package.SCLIN ~ i2c_upstream.scl.line
    package.SDAIN ~ i2c_upstream.sda.line
    package.SCLOUT ~ i2c_downstream.scl.line
    package.SDAOUT ~ i2c_downstream.sda.line

    # --- Reference connections ---
    i2c_upstream.scl.reference ~ power
    i2c_upstream.sda.reference ~ power
    i2c_downstream.scl.reference ~ power
    i2c_downstream.sda.reference ~ power
    ready.reference ~ power
    enable.reference ~ power

    # --- Enable pin pull-up ---
    enable_pullup = new Resistor
    enable_pullup.resistance = 10kohm +/- 20%
    enable_pullup.package = "0402"
    power.hv ~> enable_pullup ~> enable.line

    # --- Ready pin pull-up ---
    ready_pullup = new Resistor
    ready_pullup.resistance = 10kohm +/- 20%
    ready_pullup.package = "0402"
    power.hv ~> ready_pullup ~> ready.line

    # --- I2C pull-up resistors (upstream) ---
    i2c_upstream_pullups = new Resistor[2]
    for r in i2c_upstream_pullups:
        r.resistance = 10kohm +/- 5%
        r.package = "0402"
    i2c_upstream.scl.line ~> i2c_upstream_pullups[0] ~> i2c_upstream.scl.reference.hv
    i2c_upstream.sda.line ~> i2c_upstream_pullups[1] ~> i2c_upstream.sda.reference.hv

    # --- I2C pull-up resistors (downstream) ---
    i2c_downstream_pullups = new Resistor[2]
    for r in i2c_downstream_pullups:
        r.resistance = 10kohm +/- 5%
        r.package = "0402"
    i2c_downstream.scl.line ~> i2c_downstream_pullups[0] ~> i2c_downstream.scl.reference.hv
    i2c_downstream.sda.line ~> i2c_downstream_pullups[1] ~> i2c_downstream.sda.reference.hv

    # --- Decoupling capacitors ---
    decoupling_cap = new Capacitor
    decoupling_cap.capacitance = 100nF +/- 20%
    decoupling_cap.package = "0402"
    power.hv ~> decoupling_cap ~> power.lv
