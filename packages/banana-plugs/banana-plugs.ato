from "parts/Changzhou_Amass_Elec_24_245_2/Changzhou_Amass_Elec_24_245_2.ato" import Changzhou_Amass_Elec_24_245_2_package 

module SimpleBananaPlugBlack:
    """Simple black banana plug"""
    package = new Changzhou_Amass_Elec_24_243_2_package

    contact = new Electrical
    contact.required = True

    contact ~ package.1
    contact ~ package.2

module SimpleBananaPlugRed:
    """Simple red banana plug"""
    package = new Changzhou_Amass_Elec_24_243_1_package

    contact = new Electrical
    contact.required = True

    contact ~ package.1
    contact ~ package.2
    
