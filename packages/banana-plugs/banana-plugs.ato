module SimpleBananaPlugPower:
    """Read + Black banana plugs with 3/4inch (19.05mm) spacing"""
    power = new ElectricPower
    power.required = True

    black_plug = new SimpleBananaPlugBlack
    red_plug = new SimpleBananaPlugRed

    black_plug.contact ~ power.lv
    red_plug.contact ~ power.hv

