import Electrical
import ElectricPower

from "parts/Changzhou_Amass_Elec_24_243_1/Changzhou_Amass_Elec_24_243_1.ato" import Changzhou_Amass_Elec_24_243_1_package
from "parts/Changzhou_Amass_Elec_24_243_2/Changzhou_Amass_Elec_24_243_2.ato" import Changzhou_Amass_Elec_24_243_2_package
from "parts/Changzhou_Amass_Elec_24_243_3/Changzhou_Amass_Elec_24_243_3.ato" import Changzhou_Amass_Elec_24_243_3_package
from "parts/Changzhou_Amass_Elec_24_243_4/Changzhou_Amass_Elec_24_243_4.ato" import Changzhou_Amass_Elec_24_243_4_package
from "parts/Changzhou_Amass_Elec_24_243_5/Changzhou_Amass_Elec_24_243_5.ato" import Changzhou_Amass_Elec_24_243_5_package
